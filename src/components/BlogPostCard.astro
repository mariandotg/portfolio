---
import { getLangFromUrl, getLocalizedPath } from "../i18n/utils";
import { identiconSvg } from "../lib/identicon";

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
}

const { slug, title, description, pubDate } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const formattedDate = pubDate.toLocaleDateString(lang === "es" ? "es-AR" : "en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const href = getLocalizedPath(`/blog/${slug}`, lang);
const banner = identiconSvg(slug);
---

<a href={href} class="bpc-link group">
  <article class="bpc">
    <div class="bpc-banner" aria-hidden="true" set:html={banner}></div>
    <div class="bpc-scrim"></div>
    <div class="bpc-body">
      <time datetime={pubDate.toISOString()} class="bpc-date">{formattedDate}</time>
      <h3 class="bpc-title">{title}</h3>
      <p class="bpc-desc">{description}</p>
    </div>
  </article>
</a>

<style is:global>
  /* ── Base = "stacked" mode: halftone banner on top, text below ───────────── */
  .bpc-link {
    display: block;
  }
  .bpc {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .bpc-banner {
    aspect-ratio: 80 / 15;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: #0d0d0f;
    overflow: hidden;
  }
  .bpc-banner svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .bpc-scrim {
    display: none;
  }
  .bpc-body {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
  }
  .bpc-date {
    font-family: var(--font-family-mono);
    font-size: 12px;
    color: var(--color-muted);
    margin-bottom: 4px;
  }
  html.dark .bpc-date {
    color: var(--color-muted-dark);
  }
  .bpc-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 4px;
    color: var(--color-fg);
    transition: color 150ms ease-in-out;
  }
  html.dark .bpc-title {
    color: var(--color-fg-dark);
  }
  .bpc-link:hover .bpc-title {
    color: var(--color-fg);
  }
  html.dark .bpc-link:hover .bpc-title {
    color: var(--color-fg-dark);
  }
  .bpc-desc {
    font-size: 14px;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  html.dark .bpc-desc {
    color: var(--color-muted-dark);
  }

  /* ── Cover modes: banner becomes the full card background, text overlaid ──── */
  [data-card-mode^="cover"] .bpc {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: #0d0d0f;
    transition: transform 260ms ease, box-shadow 260ms ease, border-color 260ms ease;
  }
  [data-card-mode^="cover"] .bpc-banner {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    border: 0;
    border-radius: 0;
    transform-origin: center;
    will-change: transform;
    transition: transform 460ms cubic-bezier(0.2, 0.7, 0.2, 1), filter 320ms ease;
  }
  [data-card-mode^="cover"] .bpc-scrim {
    display: block;
    position: absolute;
    inset: 0;
    transition: opacity 300ms ease;
  }
  /* Body drives the card height, so every card has exactly 16px top and bottom. */
  [data-card-mode^="cover"] .bpc-body {
    position: relative;
    margin: 0;
    padding: 16px;
  }
  /* requested overlay order: title, date, description */
  [data-card-mode^="cover"] .bpc-title {
    order: 1;
    color: #fff;
    font-size: 18px;
    line-height: 1.3;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.7);
  }
  html.dark [data-card-mode^="cover"] .bpc-title {
    color: #fff;
  }
  [data-card-mode^="cover"] .bpc-title::after {
    content: "→";
    display: inline-block;
    margin-left: 0.4em;
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 200ms ease, transform 200ms ease;
  }
  [data-card-mode^="cover"] .bpc-link:hover .bpc-title {
    color: #fff;
  }
  [data-card-mode^="cover"] .bpc-link:hover .bpc-title::after {
    opacity: 1;
    transform: translateX(0);
  }
  [data-card-mode^="cover"] .bpc-date {
    order: 2;
    align-self: flex-start;
    margin: 8px 0 0;
    padding: 2px 9px;
    border-radius: 999px;
    background: rgba(10, 10, 12, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.14);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    color: rgba(255, 255, 255, 0.94);
    text-shadow: none;
  }
  [data-card-mode^="cover"] .bpc-desc {
    order: 3;
    margin-top: 8px;
    -webkit-line-clamp: 2;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }
  html.dark [data-card-mode^="cover"] .bpc-desc {
    color: rgba(255, 255, 255, 0.9);
  }

  /* cover-bottom: scrim rising from the bottom */
  [data-card-mode="cover-bottom"] .bpc-scrim {
    background: linear-gradient(
      to top,
      rgba(6, 6, 8, 0.94) 0%,
      rgba(6, 6, 8, 0.72) 34%,
      rgba(6, 6, 8, 0.36) 62%,
      rgba(6, 6, 8, 0) 92%
    );
  }

  /* cover-top: scrim descending from the top, with a floor so text stays legible */
  [data-card-mode="cover-top"] .bpc-scrim {
    background: linear-gradient(
      to bottom,
      rgba(6, 6, 8, 0.96) 0%,
      rgba(6, 6, 8, 0.82) 44%,
      rgba(6, 6, 8, 0.64) 78%,
      rgba(6, 6, 8, 0.52) 100%
    );
  }

  /* cover-left: text block on the left half, scrim sweeping from the left */
  [data-card-mode="cover-left"] .bpc-body {
    max-width: 74%;
  }
  [data-card-mode="cover-left"] .bpc-scrim {
    background: linear-gradient(
      to right,
      rgba(6, 6, 8, 0.9) 0%,
      rgba(6, 6, 8, 0.45) 52%,
      rgba(6, 6, 8, 0) 92%
    );
  }

  /* ── Hover: reveal the vivid halftone, zoom + brighten, lift the card ─────── */
  [data-card-mode^="cover"] .bpc-link:hover .bpc {
    transform: translateY(-3px);
    box-shadow: 0 16px 38px rgba(0, 0, 0, 0.5);
    border-color: rgba(255, 255, 255, 0.24);
  }
  [data-card-mode^="cover"] .bpc-link:hover .bpc-banner {
    transform: scale(1.07);
    filter: brightness(1.22) saturate(1.2);
  }
  [data-card-mode^="cover"] .bpc-link:hover .bpc-scrim {
    opacity: 0.62;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-card-mode^="cover"] .bpc,
    [data-card-mode^="cover"] .bpc-banner,
    [data-card-mode^="cover"] .bpc-scrim,
    [data-card-mode^="cover"] .bpc-title::after {
      transition: none;
    }
    [data-card-mode^="cover"] .bpc-link:hover .bpc,
    [data-card-mode^="cover"] .bpc-link:hover .bpc-banner {
      transform: none;
    }
  }
</style>
