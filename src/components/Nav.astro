---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/utils";
import ThemeToggle from "./ThemeToggle.tsx";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { SITE } from "../config";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header class="sticky top-0 z-50 w-full border-b bg-background/95" style="border-color: hsl(var(--border));">
  <nav class="max-w-[800px] mx-auto px-4 sm:px-6 lg:px-12 h-14 flex items-center justify-between">
    <!-- Site name -->
    <a href={getLocalizedPath("/blog", lang)} class="text-sm font-semibold text-foreground hover:opacity-70" style="transition: opacity 150ms ease-in-out;">
      {SITE.name}
    </a>

    <!-- Right side -->
    <div class="flex items-center gap-4">
      <a
        href={getLocalizedPath("/blog", lang)}
        class="text-sm text-muted-foreground hover:text-foreground"
        style="transition: color 150ms ease-in-out;"
      >
        {t.nav.blog}
      </a>
      <LanguageSwitcher />
      <ThemeToggle client:load />
    </div>
  </nav>
</header>
