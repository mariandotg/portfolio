---
import { getLangFromUrl, getLocalizedPath } from "../i18n/utils";

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  kicker?: string;
}

const { slug, title, description, pubDate, kicker } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const formattedDate = pubDate.toLocaleDateString(lang === "es" ? "es-AR" : "en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});

const href = getLocalizedPath(`/blog/${slug}`, lang);
---

<a href={href} class="pli group">
  <time datetime={pubDate.toISOString()} class="pli-date">{formattedDate}</time>
  <div class="pli-main">
    {kicker && <span class="pli-kicker">{kicker}</span>}
    <h3 class="pli-title">
      <span class="pli-title-text">{title}</span>
      <span class="pli-arrow" aria-hidden="true">→</span>
    </h3>
    <p class="pli-desc">{description}</p>
  </div>
</a>

<style>
  .pli {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 22px;
    padding: 22px 4px;
    border-top: 1px solid var(--color-border);
    align-items: baseline;
    transition: padding-left 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .pli:hover {
    padding-left: 10px;
  }

  .pli-date {
    font-family: var(--font-family-mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    color: var(--color-muted);
    white-space: nowrap;
    padding-top: 2px;
  }
  html.dark .pli-date {
    color: var(--color-muted-dark);
  }

  .pli-kicker {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    margin-bottom: 6px;
  }

  .pli-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-fg);
    margin: 0 0 5px;
    transition: color 150ms ease-in-out;
  }
  html.dark .pli-title {
    color: var(--color-fg-dark);
  }
  .pli:hover .pli-title {
    color: var(--color-primary);
  }
  html.dark .pli:hover .pli-title {
    color: var(--color-primary-hover);
  }

  .pli-arrow {
    display: inline-block;
    margin-left: 0.35em;
    color: var(--color-primary);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .pli:hover .pli-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .pli-desc {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  html.dark .pli-desc {
    color: var(--color-muted-dark);
  }

  @media (max-width: 640px) {
    .pli {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .pli-date {
      padding-top: 0;
      order: -1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pli,
    .pli-arrow {
      transition: none;
    }
    .pli:hover {
      padding-left: 4px;
    }
  }
</style>
