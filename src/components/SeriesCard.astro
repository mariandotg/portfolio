---
import { getLangFromUrl, getLocalizedPath, useTranslations } from "../i18n/utils";
import { identiconSvg } from "../lib/identicon";

interface Props {
  slug: string;
  path: string;
  title: string;
  description: string;
  meta: string;
  comingSoon?: boolean;
  featured?: boolean;
  bannerSeed?: string;
}

const { slug, path, title, description, meta, comingSoon = false, featured = false, bannerSeed } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = getLocalizedPath(path, lang);
const banner = identiconSvg(bannerSeed || slug);
---

<a href={href} class="sc group">
  <div class="sc-banner" aria-hidden="true" set:html={banner}></div>
  <div class="sc-body">
    <div class="sc-tags">
      {featured && <span class="sc-badge">{t.blog.series.featured}</span>}
      <span class:list={["sc-meta", { "sc-meta-soon": comingSoon }]}>{meta}</span>
    </div>
    <h3 class="sc-title">
      <span class="sc-title-text">{title}</span>
      <span class="sc-arrow" aria-hidden="true">→</span>
    </h3>
    <p class="sc-desc">{description}</p>
  </div>
</a>

<style>
  .sc {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 22px;
    align-items: center;
    padding: 20px 4px;
    border-top: 1px solid hsl(var(--border));
    transition: padding-left 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .sc:hover {
    padding-left: 10px;
  }
  .sc-banner {
    width: 100%;
    aspect-ratio: 2 / 1;
    border-radius: 6px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
    overflow: hidden;
  }
  .sc-banner :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Halftone is authored for a dark backdrop; flip it for light mode. */
  html:not(.dark) .sc-banner :global(svg) {
    filter: invert(1) hue-rotate(180deg);
  }

  .sc-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .sc-tags {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }
  .sc-badge {
    font-family: var(--font-family-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--primary));
    border: 1px solid color-mix(in srgb, hsl(var(--primary)) 45%, transparent);
    border-radius: 999px;
    padding: 1px 7px;
    line-height: 1.5;
  }
  .sc-meta {
    font-family: var(--font-family-mono);
    font-size: 12px;
    letter-spacing: 0.01em;
    color: hsl(var(--muted-foreground));
  }
  .sc-meta-soon {
    color: hsl(var(--primary));
  }

  .sc-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    color: hsl(var(--foreground));
    margin: 0 0 4px;
    transition: color 150ms ease-in-out;
  }
  .sc:hover .sc-title {
    color: hsl(var(--primary));
  }
  .sc-arrow {
    display: inline-block;
    margin-left: 0.35em;
    color: hsl(var(--primary));
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .sc:hover .sc-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .sc-desc {
    font-size: 14px;
    line-height: 1.5;
    color: hsl(var(--muted-foreground));
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .sc {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .sc-banner {
      aspect-ratio: 80 / 15;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc,
    .sc-arrow {
      transition: none;
    }
    .sc:hover {
      padding-left: 4px;
    }
  }
</style>
