---
import { getLangFromUrl, getLocalizedPath, useTranslations } from "../i18n/utils";
import SeriesBanner from "./effects/SeriesBanner.astro";

interface Props {
  slug: string;
  path: string;
  title: string;
  description: string;
  meta: string;
  comingSoon?: boolean;
  featured?: boolean;
  bannerBase?: string;
}

const { path, title, description, meta, comingSoon = false, featured = false, bannerBase } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const href = getLocalizedPath(path, lang);
---

<a href={href} class="sc group">
  <div class="sc-banner" aria-hidden="true">
    <SeriesBanner base={bannerBase} variant="card" class="sc-banner-art" />
    {featured && <span class="sc-badge">{t.notes.series.featured}</span>}
  </div>
  <div class="sc-body">
    <span class:list={["sc-meta", { "sc-meta-soon": comingSoon }]}>{meta}</span>
    <h3 class="sc-title">
      <span class="sc-title-text">{title}</span>
      <span class="sc-arrow" aria-hidden="true">→</span>
    </h3>
    <p class="sc-desc">{description}</p>
  </div>
</a>

<style>
  .sc {
    display: flex;
    flex-direction: column;
    border: 1px solid hsl(var(--border));
    border-radius: 12px;
    overflow: hidden;
    background: hsl(var(--card));
    transition:
      border-color 200ms ease,
      transform 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .sc:hover {
    border-color: color-mix(in srgb, hsl(var(--primary)) 55%, hsl(var(--border)));
    transform: translateY(-2px);
  }

  .sc-banner {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid hsl(var(--border));
  }
  /* `.sc-banner-art` viaja como prop `class` al root de `SeriesBanner`, así que vive en el scope
     del hijo: sin `:global` la regla no lo alcanza. El ratio ya lo pone el propio banner. */
  .sc-banner :global(.sc-banner-art) {
    transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .sc:hover :global(.sc-banner-art) {
    transform: scale(1.04);
  }

  .sc-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    font-family: var(--font-family-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: color-mix(in srgb, hsl(var(--primary)) 88%, transparent);
    border-radius: 999px;
    padding: 2px 8px;
    line-height: 1.5;
    backdrop-filter: blur(4px);
  }

  .sc-body {
    display: flex;
    flex-direction: column;
    padding: 14px 16px 16px;
    min-width: 0;
  }
  .sc-meta {
    font-family: var(--font-family-mono);
    font-size: 12px;
    letter-spacing: 0.01em;
    color: hsl(var(--muted-foreground));
    margin-bottom: 6px;
  }
  .sc-meta-soon {
    color: hsl(var(--primary));
  }

  .sc-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    color: hsl(var(--foreground));
    margin: 0 0 6px;
    transition: color 150ms ease-in-out;
  }
  .sc:hover .sc-title {
    color: hsl(var(--primary));
  }
  .sc-arrow {
    display: inline-block;
    margin-left: 0.35em;
    color: hsl(var(--primary));
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .sc:hover .sc-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .sc-desc {
    font-size: 14px;
    line-height: 1.5;
    color: hsl(var(--muted-foreground));
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .sc,
    .sc-arrow,
    .sc-banner :global(.sc-banner-art) {
      transition: none;
    }
    .sc:hover {
      transform: none;
    }
    .sc:hover :global(.sc-banner-art) {
      transform: none;
    }
  }
</style>
