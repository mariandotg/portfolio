---
import { getLangFromUrl, getLocalizedPath } from "../i18n/utils";
import { identiconSvg } from "../lib/identicon";

interface Props {
  slug: string;
  title: string;
  description: string;
  meta: string;
  comingSoon?: boolean;
  bannerSeed?: string;
}

const { slug, title, description, meta, comingSoon = false, bannerSeed } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const href = getLocalizedPath(`/blog/series/${slug}`, lang);
const banner = identiconSvg(bannerSeed || slug);
---

<a href={href} class="sc group">
  <div class="sc-banner" aria-hidden="true" set:html={banner}></div>
  <div class="sc-body">
    <span class:list={["sc-meta", { "sc-meta-soon": comingSoon }]}>{meta}</span>
    <h3 class="sc-title">
      <span class="sc-title-text">{title}</span>
      <span class="sc-arrow" aria-hidden="true">→</span>
    </h3>
    <p class="sc-desc">{description}</p>
  </div>
</a>

<style>
  .sc {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 22px;
    align-items: center;
    padding: 20px 4px;
    border-top: 1px solid var(--color-border);
    transition: padding-left 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .sc:hover {
    padding-left: 10px;
  }
  .sc-banner {
    width: 100%;
    aspect-ratio: 2 / 1;
    border-radius: 6px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    overflow: hidden;
  }
  html.dark .sc-banner {
    background: var(--color-bg-dark);
  }
  .sc-banner :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Halftone is authored for a dark backdrop; flip it for light mode. */
  html:not(.dark) .sc-banner :global(svg) {
    filter: invert(1) hue-rotate(180deg);
  }

  .sc-body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .sc-meta {
    font-family: var(--font-family-mono);
    font-size: 12px;
    letter-spacing: 0.01em;
    color: var(--color-muted);
    margin-bottom: 4px;
  }
  html.dark .sc-meta {
    color: var(--color-muted-dark);
  }
  .sc-meta-soon {
    color: var(--color-primary);
  }

  .sc-title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-fg);
    margin: 0 0 4px;
    transition: color 150ms ease-in-out;
  }
  html.dark .sc-title {
    color: var(--color-fg-dark);
  }
  .sc:hover .sc-title {
    color: var(--color-primary);
  }
  html.dark .sc:hover .sc-title {
    color: var(--color-primary-hover);
  }
  .sc-arrow {
    display: inline-block;
    margin-left: 0.35em;
    color: var(--color-primary);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .sc:hover .sc-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .sc-desc {
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  html.dark .sc-desc {
    color: var(--color-muted-dark);
  }

  @media (max-width: 640px) {
    .sc {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .sc-banner {
      aspect-ratio: 80 / 15;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc,
    .sc-arrow {
      transition: none;
    }
    .sc:hover {
      padding-left: 4px;
    }
  }
</style>
