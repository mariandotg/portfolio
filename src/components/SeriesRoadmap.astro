---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { RoadmapItem } from "../lib/series";

interface Props {
  items: RoadmapItem[];
}

const { items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ol class="rm">
  {items.map((item) => {
    const Tag = item.href ? "a" : "div";
    const linkable = item.status !== "upcoming" && item.href;
    return (
      <li class:list={["rm-item", `is-${item.status}`]}>
        <div class="rm-rail" aria-hidden="true">
          <span class="rm-node">{String(item.order).padStart(2, "0")}</span>
          <span class="rm-line"></span>
        </div>

        <Tag href={linkable ? item.href : undefined} class="rm-body">
          <span class="rm-eyebrow">{item.eyebrow}</span>
          <h3 class="rm-title">{item.title}</h3>
          <p class="rm-desc">{item.description}</p>

          <div class="rm-foot">
            {item.status === "upcoming" ? (
              <span class="rm-soon">
                <svg class="rm-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <rect x="3.25" y="7" width="9.5" height="6.5" rx="1.5" stroke="currentColor" stroke-width="1.3" />
                  <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.3" />
                </svg>
                <span>{t.notes.series.comingSoon}</span>
              </span>
            ) : (
              <>
                {item.readingTime && (
                  <span class="rm-time">{item.readingTime} {t.notes.readingTime}</span>
                )}
                {item.status === "read" ? (
                  <svg class="rm-check" viewBox="0 0 16 16" aria-hidden="true">
                    <circle cx="8" cy="8" r="8" fill="currentColor" />
                    <path d="M4.6 8.2l2.2 2.2 4.6-4.6" stroke="hsl(var(--primary-foreground))" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                  </svg>
                ) : (
                  <span class="rm-cta">{t.notes.series.readNow}</span>
                )}
              </>
            )}
          </div>
        </Tag>
      </li>
    );
  })}
</ol>

<style>
  .rm {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rm-item {
    display: grid;
    grid-template-columns: 34px 1fr;
    column-gap: 20px;
  }
  /* The gap between parts lives on the body, not the row, so the rail (and its
     connector line) stretches the full distance between two nodes. */
  .rm-body {
    padding-bottom: 34px;
  }
  .rm-item:last-child .rm-body {
    padding-bottom: 0;
  }

  .rm-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100%;
  }
  .rm-node {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid hsl(var(--border));
    font-family: var(--font-family-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--background));
    transition: border-color 180ms ease, color 180ms ease;
  }
  .rm-line {
    flex: 1;
    width: 1px;
    margin-top: 8px;
    background: hsl(var(--border));
  }
  .rm-item:last-child .rm-line {
    display: none;
  }

  .is-read .rm-node {
    background: hsl(var(--primary));
    border-color: transparent;
    color: hsl(var(--primary-foreground));
  }
  .is-current .rm-node {
    border-color: hsl(var(--primary));
    color: hsl(var(--primary));
    box-shadow: 0 0 0 4px color-mix(in srgb, hsl(var(--primary)) 14%, transparent);
  }
  .is-upcoming .rm-node {
    opacity: 0.65;
  }

  .rm-body {
    display: block;
    min-width: 0;
    padding-top: 3px;
  }

  .rm-eyebrow {
    display: block;
    font-family: var(--font-family-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
    margin-bottom: 8px;
  }
  .is-current .rm-eyebrow,
  .is-read .rm-eyebrow {
    color: hsl(var(--primary));
  }

  .rm-title {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
    color: hsl(var(--foreground));
    margin: 0 0 8px;
    transition: color 150ms ease-in-out;
  }
  a.rm-body:hover .rm-title {
    color: hsl(var(--primary));
  }
  .is-upcoming .rm-title {
    color: hsl(var(--muted-foreground));
  }

  .rm-desc {
    font-size: 14px;
    line-height: 1.6;
    color: hsl(var(--muted-foreground));
    margin: 0;
    max-width: 62ch;
  }

  .rm-foot {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 14px;
    font-family: var(--font-family-mono);
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }
  .rm-cta {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--primary));
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .is-current .rm-cta,
  a.rm-body:hover .rm-cta,
  a.rm-body:focus-visible .rm-cta {
    opacity: 1;
    transform: translateX(0);
  }
  .rm-check {
    width: 16px;
    height: 16px;
    color: hsl(var(--primary));
  }
  .rm-soon {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .rm-icon {
    width: 14px;
    height: 14px;
  }

  @media (max-width: 640px) {
    .rm-item {
      grid-template-columns: 28px 1fr;
      column-gap: 14px;
    }
    .rm-body {
      padding-bottom: 28px;
    }
    .rm-node {
      width: 28px;
      height: 28px;
      font-size: 11px;
    }
    .rm-title {
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rm-cta,
    .rm-title,
    .rm-node {
      transition: none;
    }
  }
</style>
