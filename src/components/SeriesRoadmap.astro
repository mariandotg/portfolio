---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import type { RoadmapItem } from "../lib/series";

interface Props {
  items: RoadmapItem[];
}

const { items } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ol class="rm">
  {items.map((item) => {
    const Tag = item.href ? "a" : "div";
    const linkable = item.status !== "upcoming" && item.href;
    return (
      <li class:list={["rm-item", `is-${item.status}`]}>
        <div class="rm-rail" aria-hidden="true">
          <span class="rm-node">{String(item.order).padStart(2, "0")}</span>
          <span class="rm-line"></span>
        </div>

        <Tag href={linkable ? item.href : undefined} class="rm-body">
          <h3 class="rm-title">
            <span class="rm-title-text">{item.title}</span>
            <span class="rm-arrow" aria-hidden="true">→</span>
          </h3>
          <p class="rm-desc">{item.description}</p>

          <div class="rm-foot">
            {item.status === "upcoming" ? (
              <span>{t.notes.series.comingSoon}</span>
            ) : (
              <>
                {item.status === "read" && <span class="rm-check" aria-hidden="true">✓</span>}
                {item.readingTime && <span>{item.readingTime} {t.notes.readingTime}</span>}
              </>
            )}
          </div>
        </Tag>
      </li>
    );
  })}
</ol>

<style>
  .rm {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rm-item {
    display: grid;
    grid-template-columns: 30px 1fr;
    column-gap: 20px;
  }
  .rm-body {
    padding-bottom: 26px;
    display: block;
    min-width: 0;
    padding-top: 5px;
  }
  .rm-item:last-child .rm-body {
    padding-bottom: 0;
  }

  .rm-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100%;
  }
  .rm-node {
    display: grid;
    place-items: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    border: 1px solid hsl(var(--border));
    font-family: var(--font-family-mono);
    font-size: 11px;
    font-weight: 600;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--background));
    transition: border-color 180ms ease, color 180ms ease;
  }
  .rm-line {
    flex: 1;
    width: 1px;
    margin-top: 6px;
    background: hsl(var(--border));
  }
  .rm-item:last-child .rm-line {
    display: none;
  }
  .is-read .rm-node {
    background: hsl(var(--primary));
    border-color: transparent;
    color: hsl(var(--primary-foreground));
  }
  .is-current .rm-node {
    border-color: hsl(var(--primary));
    color: hsl(var(--primary));
  }
  .is-upcoming .rm-node {
    opacity: 0.65;
  }

  /* Same weight/size as the notes cards' title — this is the core "feeling" fix. */
  .rm-title {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.35;
    color: hsl(var(--foreground));
    margin: 0 0 5px;
    transition: color 150ms ease-in-out;
  }
  a.rm-body:hover .rm-title {
    color: hsl(var(--primary));
  }
  .is-upcoming .rm-title {
    color: hsl(var(--muted-foreground));
  }

  .rm-arrow {
    display: inline-block;
    margin-left: 0.35em;
    color: hsl(var(--primary));
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 180ms ease, transform 180ms ease;
  }
  a.rm-body:hover .rm-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Clamped to one line like the cards, instead of a full paragraph. */
  .rm-desc {
    font-size: 14px;
    line-height: 1.5;
    color: hsl(var(--muted-foreground));
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .rm-foot {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    font-family: var(--font-family-mono);
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }
  .rm-check {
    color: hsl(var(--primary));
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .rm-item {
      grid-template-columns: 26px 1fr;
      column-gap: 14px;
    }
    .rm-node {
      width: 26px;
      height: 26px;
      font-size: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rm-arrow,
    .rm-title,
    .rm-node {
      transition: none;
    }
  }
</style>
