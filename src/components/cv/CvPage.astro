---
import { getLangFromUrl } from '@/i18n/utils'
import { DICTIONARIES } from '@/data/dictionaries'
import { Button } from '@/components/ui/button'
import Social from './sections/Social.astro'
import About from './sections/About.astro'
import WorkExp from './sections/WorkExp.astro'
import Education from './sections/Education.astro'
import Skills from './sections/Skills.astro'
import Projects from './sections/Projects.astro'
import Certificates from './sections/Certificates.astro'

const lang = getLangFromUrl(Astro.url)
const DICTIONARY = DICTIONARIES[lang]
---

<script>
  // Los estilos de impresión están gateados en `body.cv-print`. Con navegación client-side el body
  // sobrevive el swap, así que la clase se pone y se saca según haya CV en la página nueva.
  document.addEventListener('astro:page-load', () =>
    document.body.classList.toggle('cv-print', !!document.querySelector('[data-cv-page]')),
  )
</script>

<div
  data-cv-page
  class="container relative mx-auto scroll-my-12 overflow-auto p-4 print:p-12 md:p-16"
>
  <div class="mx-auto w-full max-w-2xl space-y-8 print:space-y-4">
    <Social lang={lang} />
    <About lang={lang} />
    <WorkExp lang={lang} />
    <Education lang={lang} />
    <Skills lang={lang} />
    <Projects lang={lang} />
    <Certificates lang={lang} />
  </div>
</div>
