---
import { getLangFromUrl } from '@/i18n/utils'
import { DICTIONARIES } from '@/data/dictionaries'
import { Button } from '@/components/ui/button'
import Social from './sections/Social.astro'
import About from './sections/About.astro'
import WorkExp from './sections/WorkExp.astro'
import EducationAndCertifications from './sections/EducationAndCertifications.astro'
import Skills from './sections/Skills.astro'
import Projects from './sections/Projects.astro'

const lang = getLangFromUrl(Astro.url)
const DICTIONARY = DICTIONARIES[lang]
---

<script>
  // Los estilos de impresión están gateados en `body.cv-print`. Con navegación client-side el body
  // sobrevive el swap, así que la clase se pone y se saca según haya CV en la página nueva.
  document.addEventListener('astro:page-load', () =>
    document.body.classList.toggle('cv-print', !!document.querySelector('[data-cv-page]')),
  )
</script>

<div
  data-cv-page
  class="relative mx-auto w-full scroll-my-12 space-y-8 overflow-auto px-4 py-12 sm:px-6 lg:px-12 print:space-y-4 print:px-12"
  style="max-width: var(--width-shell);"
>
  <Social lang={lang} />
  <About lang={lang} />
  <WorkExp lang={lang} />
  <EducationAndCertifications lang={lang} />
  <Skills lang={lang} />
  <Projects lang={lang} />
</div>
