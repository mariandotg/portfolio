---
import { getLangFromUrl } from '@/i18n/utils'
import Social from './sections/Social.astro'
import About from './sections/About.astro'
import Projects from './sections/Projects.astro'
import Series from './sections/Series.astro'
import Notes from './sections/Notes.astro'

const lang = getLangFromUrl(Astro.url)
---

<div
  class="relative mx-auto w-full scroll-my-12 space-y-8 overflow-auto px-4 py-12 sm:px-6 lg:px-12"
  style="max-width: var(--width-shell);"
>
    <Social lang={lang} />
    <About lang={lang} />
    <Projects lang={lang} />
    <Series />
    <Notes />
</div>
