---
import { DICTIONARIES } from '@/data/dictionaries'
import { PUBLIC_RESUME_DATA } from '@/data/resume'
import { CertificateCard } from '../ui/CertificateCard'
import { entryTitleClassName } from '../ui/EntryTitle'

interface Props {
  lang: 'en' | 'es'
}

const { lang } = Astro.props
const DATA = PUBLIC_RESUME_DATA[lang]
const DICTIONARY = DICTIONARIES[lang]

const hasEducation = DATA.education.length > 0
const hasCertificates = DATA.certificates.length > 0
---
{(hasEducation || hasCertificates) && (
  <section class="flex min-h-0 flex-col gap-y-4">
    <h2 class="text-lg font-bold">{DICTIONARY.EDUCATION_AND_CERTIFICATIONS}</h2>

    {hasEducation && (
      <div class="flex flex-col gap-y-3">
        {DATA.education.map((edu) => (
          <div class="flex items-center justify-between">
            <div>
              <p class={entryTitleClassName}>{edu.institution}</p>
              <p class="text-sm text-muted-foreground mt-1">{edu.degree}</p>
            </div>
            <span class="text-sm tabular-nums text-muted-foreground shrink-0">
              {edu.start} — {edu.end ?? DICTIONARY.IN_PROGRESS}
            </span>
          </div>
        ))}
      </div>
    )}

    {hasCertificates && (
      <div class="grid grid-cols-1 gap-3 print:grid-cols-2 print:gap-2 md:grid-cols-2 lg:grid-cols-2">
        {DATA.certificates.map((cert) => (
          <CertificateCard certificate={cert} />
        ))}
      </div>
    )}
  </section>
)}
