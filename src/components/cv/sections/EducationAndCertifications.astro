---
import { DICTIONARIES } from '@/data/dictionaries'
import { PUBLIC_RESUME_DATA } from '@/data/resume'
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from '../ui/Card'
import { Badge } from '../ui/Badge'

interface Props {
  lang: 'en' | 'es'
}

const { lang } = Astro.props
const DATA = PUBLIC_RESUME_DATA[lang]
const DICTIONARY = DICTIONARIES[lang]

const hasEducation = DATA.education.length > 0
const hasCertificates = DATA.certificates.length > 0
---
{(hasEducation || hasCertificates) && (
  <section class="flex min-h-0 flex-col gap-y-4">
    <h2 class="text-lg font-bold">{DICTIONARY.EDUCATION_AND_CERTIFICATIONS}</h2>

    {hasEducation && (
      <div class="flex flex-col gap-y-3">
        {DATA.education.map((edu) => (
          <div class="flex items-center justify-between">
            <div>
              <p class="font-semibold text-sm leading-none">{edu.institution}</p>
              <p class="text-sm text-muted-foreground mt-1">{edu.degree}</p>
            </div>
            <span class="text-sm tabular-nums text-gray-400 shrink-0">
              {edu.start} — {edu.end ?? DICTIONARY.IN_PROGRESS}
            </span>
          </div>
        ))}
      </div>
    )}

    {hasCertificates && (
      <div class="grid grid-cols-1 gap-3 print:grid-cols-2 print:gap-2 md:grid-cols-2 lg:grid-cols-2">
        {DATA.certificates.map((cert) => (
          <a
            href={cert.url}
            target="_blank"
            rel="noopener noreferrer"
            class="block"
          >
            <Card className="print-avoid-break bg-transparent cursor-pointer transition-all hover:ring-1 hover:ring-border hover:bg-muted/30 p-3">
              <CardHeader>
                <div class="flex items-start justify-between gap-x-2">
                  <CardTitle className="text-base font-semibold leading-none">
                    {cert.title}
                  </CardTitle>
                  <Badge variant="secondary" className="shrink-0 text-xs">{cert.date}</Badge>
                </div>
                <CardDescription className="text-sm text-muted-foreground">
                  {cert.issuer}
                </CardDescription>
              </CardHeader>
            </Card>
          </a>
        ))}
      </div>
    )}
  </section>
)}
