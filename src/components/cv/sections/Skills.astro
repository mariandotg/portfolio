---
import { DICTIONARIES } from '@/data/dictionaries'
import { PUBLIC_RESUME_DATA } from '@/data/resume'
import { getSkillCategoryClassName } from '@/data/skill-categories'
import { cn } from '@/lib/utils'
import { Badge } from '../ui/Badge'

interface Props {
  lang: 'en' | 'es'
}

const { lang } = Astro.props
const DATA = PUBLIC_RESUME_DATA[lang]
const DICTIONARY = DICTIONARIES[lang]
---
<section class="flex flex-col gap-y-3">
    <h2 class="text-lg font-bold">{DICTIONARY.SKILLS}</h2>
    <div class="flex flex-wrap gap-1">
        {DATA.skills.map((skill) =>
            <Badge className={cn("print:text-[10px]", getSkillCategoryClassName(skill))} variant={"secondary"}>
                {skill}
            </Badge>
        )}
    </div>
</section>
