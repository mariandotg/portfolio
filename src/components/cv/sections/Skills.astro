---
import { DICTIONARIES } from '@/data/dictionaries'
import { CORE_SKILLS, WEB_SKILL_GROUPS } from '@/data/skill-categories'
import { cn } from '@/lib/utils'
import { Badge } from '../ui/Badge'

interface Props {
  lang: 'en' | 'es'
}

const { lang } = Astro.props
const DICTIONARY = DICTIONARIES[lang]
---
<section class="flex flex-col gap-y-3">
    <h2 class="text-lg font-bold">{DICTIONARY.SKILLS}</h2>
    <dl class="grid grid-cols-1 gap-y-1 sm:grid-cols-[9rem_minmax(0,1fr)] sm:items-baseline sm:gap-x-4 sm:gap-y-2">
        {WEB_SKILL_GROUPS.map(({ category, skills }) => (
            <Fragment>
                <dt class="font-mono text-[10.5px] uppercase tracking-wider text-muted-foreground">
                    {DICTIONARY.SKILL_CATEGORIES[category]}
                </dt>
                <dd class="mb-2 flex flex-wrap gap-1 sm:mb-0">
                    {skills.map((skill) =>
                        <Badge
                          className={cn(
                            "print:text-[10px]",
                            CORE_SKILLS.has(skill) && "bg-skill-core/8 text-skill-core hover:bg-skill-core/8",
                          )}
                          variant={"secondary"}
                        >
                            {skill}
                        </Badge>
                    )}
                </dd>
            </Fragment>
        ))}
    </dl>
</section>
