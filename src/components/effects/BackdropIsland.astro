---
import Backdrop from "./Backdrop.tsx";
import { SITE_BACKDROP_SEED } from "../../lib/effects/backdrop/seed";

interface Props {
  /** Pisa el seed del sitio. Mismo seed = mismo campo. */
  seed?: string;
}

const seed = Astro.props.seed ?? SITE_BACKDROP_SEED;
---

{/*
  `transition:persist` transplanta el island hidratado al documento nuevo en cada navegación: React
  no se desmonta, el canvas WebGL no se recrea y el fade de entrada no se vuelve a disparar.
  `transition:persist-props` congela el seed — sin él Astro le pasaría las props de la página nueva
  y el shader se re-inicializaría.
*/}
<div class="backdrop" aria-hidden="true">
  <Backdrop seed={seed} client:idle transition:persist="backdrop" transition:persist-props />
</div>

<style>
  .backdrop {
    /* Cuánto sangra el backdrop por debajo del viewport. Medido: 57px en un iPhone con la barra
       inferior colapsada. El margen es a propósito — el alto de esa barra lo decide el browser. */
    --backdrop-bleed: 120px;

    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    /* Dos cosas distintas, las dos medidas en un iPhone (ver notas abajo):

       1. `inset: 0` se resuelve contra el ICB, que en iOS Safari es el viewport CHICO
          (`documentElement.clientHeight` = 695 contra `innerHeight` = 735). Por eso la altura va
          explícita en `lvh`: es la altura máxima del viewport, no cambia con la barra, y al ser
          estática no dispara resizes del shader. `vh` queda de fallback.

       2. Aun cubriendo el viewport entero queda una franja de ~57px detrás de la barra inferior
          flotante de Safari que está FUERA del viewport: ninguna unidad CSS la alcanza (`lvh`,
          `dvh` y `innerHeight` valen todos 735 y el corte cae justo ahí). Lo que sí llega son las
          capas `fixed` desbordadas, así que el backdrop sangra por debajo del borde. Sin esto se
          ve un escalón contra `--background` pelado. */
    height: 100vh;
    height: calc(100lvh + var(--backdrop-bleed));
    z-index: 0;
    pointer-events: none;

    /* El morado sobre fondo claro necesita más alpha que el blanco sobre fondo oscuro para
       leerse igual de presente; de ahí que la opacidad sea por tema y no una sola. */
    --backdrop-alpha: 0.3;
  }

  /* El duotono en dark tiene mucho menos rango que en light (la base violeta arranca casi del
     negro del fondo), así que necesita algo más de alpha para leerse igual de presente. */
  :global(.dark) .backdrop {
    --backdrop-alpha: 0.22;
  }

  /* Atenuar el centro para no competir con el texto.
     Esto era un `mask-image` sobre `.backdrop`, y era la razón real de la franja sin pintar en
     iOS Safari: Safari clipea al viewport las capas `fixed` ENMASCARADAS, así que por más que el
     elemento midiera 855px nunca pintaba más allá de los 735 del viewport. Medido con cuatro
     franjas de control: plana y con `opacity` sangran; con `mask` (con o sin `opacity`) no.

     Equivalente sin máscara: en vez de recortarle alpha al backdrop, se pinta `--background`
     encima con el alpha complementario (1 − alpha de la máscara). Sobre un fondo plano —y el
     backdrop siempre está sobre `--background` pelado— el resultado compuesto es idéntico:
     mix(bg, shader, α·m) sale igual por los dos caminos. */
  .backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      hsl(var(--background) / 0.3) 0%,
      hsl(var(--background) / 0.6) 18%,
      hsl(var(--background) / 0.87) 50%,
      hsl(var(--background) / 0.6) 82%,
      hsl(var(--background) / 0.3) 100%
    );
  }

  /* `.backdrop-fade` lo pinta el island React, así que queda fuera del scoping de Astro. */
  .backdrop :global(.backdrop-fade) {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms ease-out;
  }

  /* La opacidad del backdrop vive acá y no en `.backdrop`: el `::after` que atenúa el centro tiene
     que pintar con alpha pleno, fuera de ella. */
  .backdrop :global(.backdrop-fade[data-painted]) {
    opacity: var(--backdrop-alpha);
  } 

  @media print {
    .backdrop {
      display: none;
    }
  }
</style>
