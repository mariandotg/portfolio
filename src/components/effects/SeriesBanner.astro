---
import { BANNER_RATIOS, seriesBannerSrc, type BannerVariant } from "@/lib/effects/banner/assets";

/**
 * El banner de una serie es **una imagen horneada** con el dither adentro: se exporta desde
 * `/dev/effects` y se guarda en `public/series/`. Acá no hay shader ni island — es un `<img>`.
 *
 * Lo normal es **un solo archivo** por serie: a 16/9 y 3/1 el mismo recorte funciona en los dos
 * lugares. `-card` / `-hero` existen para cuando una serie quiere un encuadre propio en el hero;
 * si falta el que corresponde, `seriesBannerSrc` cae al otro y `object-fit: cover` lo salva.
 */
interface Props {
  /** Base sin sufijo ni extensión, p.ej. `/series/agent-vs-cursor`. */
  base?: string;
  variant: BannerVariant;
  alt?: string;
  class?: string;
}

const { base, variant, alt = "", class: className } = Astro.props;
const ratio = BANNER_RATIOS[variant];
const src = base ? seriesBannerSrc(base, variant) : undefined;
---

<div
  class:list={["sb", className]}
  style={`--sb-ratio: ${ratio}`}
  aria-hidden={alt ? undefined : "true"}
>
  {
    src && (
      <img
        src={src}
        alt={alt}
        loading={variant === "card" ? "lazy" : "eager"}
        decoding="async"
      />
    )
  }
</div>

<style>
  .sb {
    position: relative;
    aspect-ratio: var(--sb-ratio);
    overflow: hidden;
    /* Sin imagen el hueco no puede leerse como un error de carga. */
    background: hsl(var(--muted));
  }
  .sb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* El dither es una grilla de píxeles: si el browser la escala, tiene que hacerlo sin
       interpolar, o el patrón se convierte en una papilla gris. */
    image-rendering: pixelated;
  }
</style>
