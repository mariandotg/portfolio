---
type CalloutType = "note" | "rule" | "warning";

interface Props {
  type?: CalloutType;
  title?: string;
}

const DEFAULT_LABEL: Record<CalloutType, string> = {
  note: "Note",
  rule: "Rule",
  warning: "Warning",
};

// MDX does not type-check props: an unknown type renders as a note instead of an empty header.
const type: CalloutType = Astro.props.type && Astro.props.type in DEFAULT_LABEL ? Astro.props.type : "note";
const label = Astro.props.title ?? DEFAULT_LABEL[type];
---

<aside class={`callout callout-${type} not-prose`}>
  <div class="callout-head">{label}</div>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    --accent: hsl(var(--muted-foreground));
    margin: 1.6rem 0;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    border: 1px solid hsl(var(--border));
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .callout-note {
    --accent: hsl(var(--data-inert));
  }
  .callout-rule {
    --accent: hsl(var(--data-new));
  }
  .callout-warning {
    --accent: hsl(var(--data-loss));
  }

  .callout-head {
    margin-bottom: 6px;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    font-weight: 600;
    color: var(--accent);
  }

  .callout-body {
    font-size: var(--text-ui);
    line-height: var(--text-ui--line-height);
    color: hsl(var(--foreground));
  }
  .callout-body :global(> :first-child) {
    margin-top: 0;
  }
  .callout-body :global(> :last-child) {
    margin-bottom: 0;
  }
  .callout-body :global(p) {
    margin: 0.5rem 0;
  }
  .callout-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .callout-body :global(code) {
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    padding: 1px 5px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, hsl(var(--muted-foreground)) 18%, transparent);
  }
</style>
