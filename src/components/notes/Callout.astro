---
type CalloutType = "note" | "tip" | "insight" | "warning" | "takeaway";

interface Props {
  type?: CalloutType;
  title?: string;
}

const { type = "note", title } = Astro.props;

const META: Record<CalloutType, { icon: string; label: string }> = {
  note: { icon: "ℹ", label: "Note" },
  tip: { icon: "✦", label: "Tip" },
  insight: { icon: "💡", label: "Insight" },
  warning: { icon: "⚠", label: "Warning" },
  takeaway: { icon: "📌", label: "Key takeaway" },
};

const meta = META[type];
---

<aside class={`callout callout-${type} not-prose`}>
  <div class="callout-head">
    <span class="callout-icon" aria-hidden="true">{meta.icon}</span>
    <span class="callout-label">{title ?? meta.label}</span>
  </div>
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    --accent: hsl(var(--muted-foreground));
    margin: 1.6rem 0;
    padding: 14px 16px;
    border-radius: var(--radius-md);
    border: 1px solid hsl(var(--border));
    border-left: 3px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }
  .callout-note {
    --accent: hsl(var(--data-inert));
  }
  .callout-tip {
    --accent: hsl(var(--data-gain));
  }
  .callout-insight {
    --accent: hsl(var(--data-write));
  }
  .callout-warning {
    --accent: hsl(var(--data-loss));
  }
  .callout-takeaway {
    --accent: hsl(var(--data-new));
  }

  .callout-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .callout-icon {
    font-size: var(--text-ui);
    line-height: 1;
  }

  .callout-body {
    font-size: var(--text-ui);
    line-height: var(--text-ui--line-height);
    color: hsl(var(--foreground));
  }
  .callout-body :global(> :first-child) {
    margin-top: 0;
  }
  .callout-body :global(> :last-child) {
    margin-bottom: 0;
  }
  .callout-body :global(p) {
    margin: 0.5rem 0;
  }
  .callout-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .callout-body :global(code) {
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    padding: 1px 5px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, hsl(var(--muted-foreground)) 18%, transparent);
  }
</style>
