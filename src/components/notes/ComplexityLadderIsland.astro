---
import ComplexityLadder from "./ComplexityLadder.tsx";
---

<div class="not-prose">
  <ComplexityLadder client:visible />
</div>

<style is:global>
  .ladder {
    margin: 1.6rem 0;
    padding: 16px;
    border: 1px solid hsl(var(--border));
    border-radius: 12px;
    background: color-mix(in srgb, hsl(var(--muted-foreground)) 5%, transparent);
    font-family: var(--font-family-display);
  }
  .ladder-title {
    font-family: var(--font-family-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }

  .ladder-tasks {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 14px;
  }
  .ladder-task {
    font-family: var(--font-family-mono);
    font-size: 12px;
    text-align: left;
    cursor: pointer;
    padding: 6px 10px;
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
    background: transparent;
    color: hsl(var(--muted-foreground));
    transition: color 150ms ease, background 150ms ease, border-color 150ms ease;
  }
  .ladder-task:hover {
    color: hsl(var(--foreground));
  }
  .ladder-task.active {
    color: #fff;
    background: hsl(var(--primary));
    border-color: transparent;
  }
  .ladder-task:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }

  .ladder-rungs {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ladder-rung {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border: 1px solid hsl(var(--border));
    border-radius: 8px;
    transition: opacity 200ms ease, background 200ms ease, border-color 200ms ease;
  }
  .ladder-rung-num {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 1px solid hsl(var(--border));
    font-family: var(--font-family-mono);
    font-size: 12px;
    font-weight: 600;
    color: hsl(var(--muted-foreground));
  }
  .ladder-rung-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .ladder-rung-name {
    font-size: 14px;
    font-weight: 600;
    color: hsl(var(--foreground));
  }
  .ladder-rung-detail {
    font-size: 12.5px;
    line-height: 1.4;
    color: hsl(var(--muted-foreground));
  }
  .ladder-rung-tag {
    flex: none;
    font-family: var(--font-family-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 2px 8px;
    border-radius: 999px;
    color: hsl(var(--primary));
    border: 1px solid color-mix(in srgb, hsl(var(--primary)) 45%, transparent);
  }
  .ladder-rung-tag.muted {
    color: hsl(var(--muted-foreground));
    border-color: hsl(var(--border));
  }
  .ladder-rung.needed {
    border-color: hsl(var(--primary));
    background: color-mix(in srgb, hsl(var(--primary)) 10%, transparent);
  }
  .ladder-rung.needed .ladder-rung-num {
    color: #fff;
    background: hsl(var(--primary));
    border-color: transparent;
  }
  .ladder-rung.below .ladder-rung-num {
    color: hsl(var(--primary));
    border-color: color-mix(in srgb, hsl(var(--primary)) 55%, transparent);
  }
  .ladder-rung.above {
    opacity: 0.5;
    border-style: dashed;
  }

  .ladder-facts {
    display: grid;
    gap: 10px;
    margin: 0;
  }
  .ladder-facts dt {
    font-family: var(--font-family-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }
  .ladder-facts dd {
    margin: 2px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: hsl(var(--foreground));
  }
  .ladder-mono {
    font-family: var(--font-family-mono);
  }
  .ladder-source {
    margin: 14px 0 0;
    font-size: 11.5px;
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 480px) {
    .ladder-rung-detail {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ladder-rung,
    .ladder-task {
      transition: none;
    }
  }
</style>
