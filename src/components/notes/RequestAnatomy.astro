---
// Static diagram: the Messages API is stateless, so request N resends everything before it.
import Figure from "./agent-loop/kit/Figure.astro";
import Legend from "./agent-loop/kit/Legend.astro";
import Source from "./agent-loop/kit/Source.astro";
import { getLangFromUrl } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const isSpanish = lang === "es";

const blockLabels = {
  en: { tools: "tools", system: "system", task: "task", "call 1": "call 1", "result 1": "result 1", "call 2": "call 2", "result 2": "result 2" },
  es: { tools: "herramientas", system: "sistema", task: "tarea", "call 1": "llamada 1", "result 1": "resultado 1", "call 2": "llamada 2", "result 2": "resultado 2" },
} as const;
const labels = blockLabels[lang];
const blockLabel = (block: string) => labels[block as keyof typeof labels] ?? block;
const requestLabel = (n: number) => (isSpanish ? `Solicitud ${n}` : `Request ${n}`);

const rows = [
  { label: requestLabel(1), blocks: ["tools", "system", "task"] },
  { label: requestLabel(2), blocks: ["tools", "system", "task", "call 1", "result 1"] },
  { label: requestLabel(3), blocks: ["tools", "system", "task", "call 1", "result 1", "call 2", "result 2"] },
];
const isNew = (row: number, i: number) => (row === 0 ? true : i >= rows[row - 1].blocks.length);
const kind = (name: string) => (name === "tools" || name === "system" || name === "task" ? "prefix" : "history");

const rowsWithNew = rows.map((row, r) => ({
  ...row,
  newBlocks: row.blocks.filter((b, i) => kind(b) === "history" && isNew(r, i)),
}));
---

<Figure question={isSpanish ? "¿Qué envía cada solicitud cuando la API no conserva estado?" : "What does each request send when the API keeps no state?"} basis="measured">
  <p class="sr-only">
    {isSpanish
      ? "Tres solicitudes consecutivas sin estado. Cada una vuelve a enviar las herramientas, el prompt del sistema y la tarea, además de cada llamada y resultado de herramienta anterior. Solo los últimos bloques son nuevos."
      : "Three consecutive requests. Each one sends the tools, system prompt and task again, plus every earlier tool call and tool result. Only the last blocks are new."}
  </p>

  <table class="ra">
    <caption class="sr-only">
      {isSpanish ? "Tres solicitudes consecutivas sin estado y qué bloques se repiten." : "Three consecutive stateless requests and which blocks repeat."}
    </caption>
    <tbody>
      {
        rowsWithNew.map((row, r) => (
          <tr>
            <th scope="row" class="ra-label">
              {row.label}
            </th>
            <td class="ra-blocks">
              <span class="ra-chips" aria-hidden="true">
                {row.blocks.map((b, i) => (
                  <span class:list={["ra-chip", kind(b) === "prefix" ? "ra-resent" : isNew(r, i) ? "ra-new" : "ra-old"]}>
                    {blockLabel(b)}
                  </span>
                ))}
              </span>
              <span class="sr-only">
                {row.blocks.map(blockLabel).join(", ")}
                {row.newBlocks.length > 0
                  ? isSpanish
                    ? `. Nuevos en esta solicitud: ${row.newBlocks.map(blockLabel).join(", ")}.`
                    : `. New this request: ${row.newBlocks.map(blockLabel).join(", ")}.`
                  : "."}
              </span>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <Legend
    items={[
      { tone: "resent", label: isSpanish ? "enviado de nuevo" : "sent again" },
      { tone: "new", label: isSpanish ? "nuevo en esta solicitud" : "new this request" },
    ]}
  />

  <Source slot="caption">
    {isSpanish
      ? "La API de Messages no conserva estado entre solicitudes. Por eso, la solicitud N lleva las herramientas, el prompt del sistema, la tarea y cada llamada y resultado de herramienta anterior. No hay cantidades aquí: son tres solicitudes con la forma documentada."
      : "The Messages API keeps no state between requests, so request N carries the tools, the system prompt, the task, and every earlier tool call and tool result. No quantities here — three requests of the documented shape."}
  </Source>
</Figure>

<style>
  .ra {
    width: 100%;
    border-collapse: collapse;
  }
  .ra th,
  .ra td {
    padding: 8px 0;
    text-align: left;
    vertical-align: middle;
    font-weight: 400;
  }
  .ra tr + tr {
    border-top: 1px solid hsl(var(--border));
  }
  .ra-label {
    width: 6.5rem;
    padding-right: 12px !important;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
  }
  .ra-blocks {
    width: 100%;
  }
  .ra-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .ra-chip {
    display: inline-flex;
    align-items: center;
    padding: 5px 9px;
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius-sm);
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    font-weight: 700;
    white-space: nowrap;
    color: hsl(var(--foreground));
  }
  .ra-resent {
    background: var(--alc-resent);
  }
  .ra-new {
    background: var(--alc-new);
    border-color: hsl(var(--primary));
    border-width: 1.5px;
    color: hsl(var(--primary-foreground));
  }
  .ra-old {
    background: color-mix(in srgb, var(--alc-new) 55%, transparent);
    border-color: color-mix(in srgb, hsl(var(--border)) 55%, transparent);
  }

  @media (max-width: 480px) {
    .ra tr {
      display: block;
      padding: 10px 0;
    }
    .ra-label,
    .ra-blocks {
      display: block;
      width: auto;
      padding: 0 !important;
    }
    .ra-label {
      margin-bottom: 6px;
    }
  }
</style>
