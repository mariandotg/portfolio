---
// Static diagram: the Messages API is stateless, so request N resends everything before it.
import Figure from "./agent-loop/kit/Figure.astro";
import Plot from "./agent-loop/kit/Plot.astro";
import Legend from "./agent-loop/kit/Legend.astro";
import Source from "./agent-loop/kit/Source.astro";
import DataTable from "./agent-loop/kit/DataTable.astro";
import { plotFrame } from "./agent-loop/kit/plot";

const rows = [
  { label: "Request 1", blocks: ["tools", "system", "task"] },
  { label: "Request 2", blocks: ["tools", "system", "task", "call 1", "result 1"] },
  { label: "Request 3", blocks: ["tools", "system", "task", "call 1", "result 1", "call 2", "result 2"] },
];
const isNew = (row: number, i: number) => (row === 0 ? true : i >= rows[row - 1].blocks.length);
const kind = (name: string) => (name === "tools" || name === "system" || name === "task" ? "prefix" : "history");
// Blocks size to their label: bold 12px mono runs ~7.5 units per character.
const gap = 4;
const blockWidth = (name: string) => Math.ceil(name.length * 7.5) + 14;
const blockX = (blocks: string[], i: number) =>
  blocks.slice(0, i).reduce((x, b) => x + blockWidth(b) + gap, 0);
const labelWidth = 92;
const longest = rows[rows.length - 1].blocks;
const width = labelWidth + blockX(longest, longest.length) + 8;
const rowHeight = 44;
const height = rows.length * rowHeight + 30;

const frame = plotFrame({ w: width, h: height });

const ariaLabel =
  "Three consecutive requests. Each one sends the tools, system prompt and task again, plus every earlier tool call and tool result. Only the last blocks are new.";
---

<Figure question="What does each request send when the API keeps no state?" basis="measured">
  <Plot frame={frame} label={ariaLabel}>
    {
      rows.map((row, r) => (
        <g transform={`translate(0 ${r * rowHeight})`}>
          <text class="alc-text" x="0" y="26">
            {row.label}
          </text>
          {row.blocks.map((b, i) => (
            <g transform={`translate(${labelWidth + blockX(row.blocks, i)} 6)`}>
              <rect
                class={`${kind(b) === "prefix" ? "alc-fill-resent" : "alc-fill-new"} ${isNew(r, i) ? "" : "opacity-[0.55]"}`}
                width={blockWidth(b)}
                height="30"
                rx="4"
                stroke={kind(b) === "history" && isNew(r, i) ? "hsl(var(--primary))" : "hsl(var(--border))"}
                stroke-width={kind(b) === "history" && isNew(r, i) ? "1.5" : "1"}
              />
              <text
                class="alc-text-strong"
                x={blockWidth(b) / 2}
                y="19"
                text-anchor="middle"
                style={kind(b) === "history" && isNew(r, i) ? "fill: hsl(var(--primary-foreground))" : undefined}
              >
                {b.replace(" ", "\u00a0")}
              </text>
            </g>
          ))}
        </g>
      ))
    }
  </Plot>

  <Legend
    items={[
      { tone: "resent", label: "sent again" },
      { tone: "new", label: "new this request" },
    ]}
  />

  <DataTable
    slot="a11y"
    caption="Three consecutive stateless requests and which blocks repeat."
    columns={["request", "blocks sent"]}
    rows={rows.map((r) => [r.label, r.blocks.join(", ")])}
  />

  <Source slot="caption">
    The Messages API keeps no state between requests, so request N carries the tools, the system prompt, the task,
    and every earlier tool call and tool result. No quantities here — three requests of the documented shape.
  </Source>
</Figure>
