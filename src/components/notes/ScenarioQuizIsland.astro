---
import ScenarioQuiz from "./ScenarioQuiz.tsx";
import type { ScenarioQuizProps } from "./ScenarioQuiz.tsx";

type Props = ScenarioQuizProps;
const props = Astro.props;
---

<div class="not-prose">
  <ScenarioQuiz client:visible {...props} />
</div>

<style is:global>
  .quiz {
    margin: 1.6rem 0;
    padding: 16px;
    border: 1px solid hsl(var(--border));
    border-radius: 12px;
    background: color-mix(in srgb, hsl(var(--muted-foreground)) 5%, transparent);
    font-family: var(--font-family-display);
  }
  .quiz-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 10px;
  }
  .quiz-title {
    font-family: var(--font-family-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: hsl(var(--primary));
  }
  .quiz-reset {
    font-family: var(--font-family-mono);
    font-size: 12px;
    cursor: pointer;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid hsl(var(--border));
    background: transparent;
    color: hsl(var(--foreground));
  }
  .quiz-reset:hover {
    background: color-mix(in srgb, hsl(var(--muted-foreground)) 14%, transparent);
  }
  .quiz-scenario {
    margin: 0 0 8px;
    font-size: 14.5px;
    line-height: 1.6;
    color: hsl(var(--foreground));
  }
  .quiz-question {
    margin: 0 0 12px;
    font-size: 14px;
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .quiz-options {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .quiz-option {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
    text-align: left;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
    background: transparent;
    color: hsl(var(--foreground));
    font-size: 14px;
    line-height: 1.5;
    cursor: pointer;
    transition: background 150ms ease, border-color 150ms ease, opacity 150ms ease;
  }
  .quiz-option:hover:not(:disabled) {
    background: color-mix(in srgb, hsl(var(--muted-foreground)) 10%, transparent);
  }
  .quiz-option:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }
  .quiz-option:disabled {
    cursor: default;
  }
  .quiz-option.correct {
    border-color: color-mix(in srgb, hsl(150 55% 42%) 60%, hsl(var(--border)));
    background: color-mix(in srgb, hsl(150 55% 42%) 8%, transparent);
  }
  .quiz-option.wrong {
    border-color: color-mix(in srgb, hsl(8 75% 57%) 60%, hsl(var(--border)));
    background: color-mix(in srgb, hsl(8 75% 57%) 8%, transparent);
  }
  .quiz-option.dim {
    opacity: 0.7;
  }
  .quiz-option-id {
    flex: none;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 50%;
    border: 1px solid hsl(var(--border));
    font-family: var(--font-family-mono);
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
  }
  .quiz-why {
    margin: 6px 0 2px;
    padding-left: 44px;
    font-size: 13px;
    line-height: 1.55;
    color: hsl(var(--muted-foreground));
  }
  .quiz-label {
    font-family: var(--font-family-mono);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: hsl(8 65% 46%);
  }
  .quiz-label.ok {
    color: hsl(150 45% 34%);
  }
  html.dark .quiz-label {
    color: hsl(8 80% 66%);
  }
  html.dark .quiz-label.ok {
    color: hsl(150 55% 62%);
  }

  .quiz-verdict {
    margin: 12px 0 0;
    padding: 8px 10px;
    border-radius: 8px;
    font-size: 13px;
    text-align: center;
  }
  .quiz-verdict.ok {
    color: hsl(150 45% 34%);
    background: color-mix(in srgb, hsl(150 55% 42%) 10%, transparent);
  }
  html.dark .quiz-verdict.ok {
    color: hsl(150 55% 62%);
  }
  .quiz-verdict.err {
    color: hsl(8 65% 46%);
    background: color-mix(in srgb, hsl(8 75% 57%) 10%, transparent);
  }
  html.dark .quiz-verdict.err {
    color: hsl(8 80% 66%);
  }
  .quiz-note {
    margin: 12px 0 0;
    font-size: 11.5px;
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 480px) {
    .quiz-why {
      padding-left: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .quiz-option {
      transition: none;
    }
  }
</style>
