---
import { getLangFromUrl } from "../../i18n/utils";
import { getAgentLoopUi } from "./agent-loop/i18n";

interface Props {
  leftLabel?: string;
  rightLabel?: string;
  /** "diff" tints left as wrong/removed and right as right/added. */
  variant?: "neutral" | "diff";
  /** When variant is neutral, tint the right column with --data-new (not a verdict). */
  accentRight?: boolean;
}

const {
  leftLabel: rawLeftLabel,
  rightLabel: rawRightLabel,
  variant = "neutral",
  accentRight = false,
} = Astro.props;
const ui = getAgentLoopUi(getLangFromUrl(Astro.url));
const localizeLabel = (label: string | undefined, fallback: "Before" | "After") => {
  const value = label ?? fallback;
  return ui.sideBySide.labels[value as keyof typeof ui.sideBySide.labels] ?? value;
};
const leftLabel = localizeLabel(rawLeftLabel, "Before");
const rightLabel = localizeLabel(rawRightLabel, "After");
---

<div class={`sxs sxs-${variant}${accentRight ? " sxs-accent-right" : ""} not-prose`}>
  <div class="sxs-col sxs-left">
    <div class="sxs-label">
      {variant === "diff" && <span class="sxs-sign" aria-hidden="true">−</span>}
      {leftLabel}
    </div>
    <div class="sxs-body"><slot name="left" /></div>
  </div>
  <div class="sxs-col sxs-right">
    <div class="sxs-label">
      {variant === "diff" && <span class="sxs-sign" aria-hidden="true">+</span>}
      {rightLabel}
    </div>
    <div class="sxs-body"><slot name="right" /></div>
  </div>
</div>

<style>
  .sxs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 1.6rem 0;
  }
  @media (max-width: 640px) {
    .sxs {
      grid-template-columns: 1fr;
    }
  }

  .sxs-col {
    --tone: hsl(var(--border));
    border: 1px solid hsl(var(--border));
    border-top: 2px solid var(--tone);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: color-mix(in srgb, var(--tone) 5%, transparent);
    min-width: 0;
  }
  .sxs-diff .sxs-left {
    --tone: hsl(var(--data-loss));
  }
  .sxs-diff .sxs-right {
    --tone: hsl(var(--data-gain));
  }
  .sxs-accent-right.sxs-neutral .sxs-right {
    --tone: hsl(var(--data-new));
  }

  .sxs-label {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    font-family: var(--font-family-mono);
    font-size: var(--text-micro);
    line-height: var(--text-micro--line-height);
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--tone);
    border-bottom: 1px solid hsl(var(--border));
    background: color-mix(in srgb, var(--tone) 9%, transparent);
  }
  .sxs-sign {
    font-size: var(--text-ui);
  }

  .sxs-body {
    padding: 4px 12px;
    font-size: var(--text-ui);
    line-height: var(--text-ui--line-height);
    overflow-x: auto;
  }
  .sxs-body :global(pre) {
    margin: 0.7rem 0;
    background: transparent !important;
    padding: 0;
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
  }
  .sxs-body :global(> :first-child) {
    margin-top: 0.7rem;
  }
  .sxs-body :global(> :last-child) {
    margin-bottom: 0.7rem;
  }
  .sxs-body :global(p) {
    margin: 0.6rem 0;
    line-height: 1.6;
    color: hsl(var(--foreground));
  }
  .sxs-body :global(code) {
    font-family: var(--font-family-mono);
  }
</style>
