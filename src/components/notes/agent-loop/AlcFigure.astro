---
// Frame for every agent-loop visual: the question it answers, an optional two-or-three-state toggle,
// the panels, and a one-line caption with sources. Panels are server-rendered children marked
// data-alc-panel="<value>"; the toggle shows one at a time. Without options, children render as is.
import "./agent-loop.css";

interface Props {
  question: string;
  options?: { value: string; label: string }[];
  initial?: string;
}
const { question, options, initial = options?.[0]?.value } = Astro.props;
---

<figure class="alc not-prose" data-alc data-alc-initial={initial}>
  <figcaption class="alc-question">{question}</figcaption>
  {
    options && (
      <div class="alc-seg" role="group" aria-label={question}>
        {options.map((o) => (
          <button type="button" data-alc-option={o.value} aria-pressed={String(o.value === initial)}>
            {o.label}
          </button>
        ))}
      </div>
    )
  }
  <slot />
  {
    Astro.slots.has("caption") && (
      <div class="alc-caption">
        <slot name="caption" />
      </div>
    )
  }
</figure>

<script>
  import "./kit/toggle";
</script>
