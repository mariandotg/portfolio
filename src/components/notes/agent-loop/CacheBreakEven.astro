---
// "How slow can a tool be before the cache stops paying?" Static. Because every request in the
// loop waits the same number of seconds, each cache mode either hits on every request or misses
// on every request — the curve is a step, not a slope. It steps once, at the 5-minute TTL.
import { simulate, CACHE, SOURCES, FACTS_AS_OF } from "@/lib/sim/agent-loop";
import type { CacheMode } from "@/lib/sim/agent-loop";
import { BASE_WORKLOAD } from "./workloads";
import { fmtUsd, fmtSeconds, nudgeLabels } from "./format";
import Figure from "./kit/Figure.astro";
import Stat from "./kit/Stat.astro";
import Source from "./kit/Source.astro";
import DataTable from "./kit/DataTable.astro";

const GAP_MAX = 900; // 15 minutes
const TTL = CACHE.ttl5mSeconds;

// Every request in the loop waits the same number of seconds, so a cache mode either hits on
// every request or misses on every request in this range: the flat lines and the one step both
// come out of the same `simulate` call the slope version used, just sampled at the two gaps that
// matter (just short of the TTL, and just past it) instead of every 15 seconds.
const costAt = (gap: number, cache: CacheMode) =>
  simulate({ ...BASE_WORKLOAD, secondsBetweenRequests: gap, cache }).totals.costUsd;

const noCacheCost = costAt(0, "off");
const oneHourCost = costAt(0, "1h");
const fiveMinHit = costAt(0, "5m");
const fiveMinMiss = costAt(TTL + 1, "5m");

const yMax = Math.max(noCacheCost, oneHourCost, fiveMinHit, fiveMinMiss) * 1.08;
const yPct = (cost: number) => ((yMax - cost) / yMax) * 100;
const ttlPct = (TTL / GAP_MAX) * 100;

const yNoCache = yPct(noCacheCost);
const yOneHour = yPct(oneHourCost);
const yHit = yPct(fiveMinHit);
const yMiss = yPct(fiveMinMiss);

const lineLabels = nudgeLabels(
  [
    { text: "no cache", y: yNoCache, tone: "neutral" as const },
    { text: "5-min (miss)", y: yMiss, tone: "bad" as const },
    { text: "1-hour", y: yOneHour, tone: "good" as const },
    { text: "5-min (hit)", y: yHit, tone: "new" as const },
  ],
  8,
);

const ariaLabel = `Total cost of the 30-request loop as a function of seconds between requests, 0 to 15 minutes. No cache stays flat at ${fmtUsd(noCacheCost)}. The 1-hour cache stays flat at ${fmtUsd(oneHourCost)}. The 5-minute cache stays at ${fmtUsd(fiveMinHit)} up to 5 minutes, then jumps to ${fmtUsd(fiveMinMiss)} past 5 minutes, becoming more expensive than no cache.`;
---

<Figure question="How slow can a tool be before the cache stops paying?" basis="calculated">
  <Stat value={fmtSeconds(TTL)} delta="5-min cache turns worse past this gap" tone="loss">
    Past {fmtSeconds(TTL)} between request starts, the 5-minute cache never gets a hit: every
    request writes the whole prefix again at 1.25×, and the loop costs <strong>{fmtUsd(fiveMinMiss)}</strong>
    instead of <strong>{fmtUsd(fiveMinHit)}</strong>. The 1-hour cache costs <strong>{fmtUsd(oneHourCost)}</strong> at any gap in this range.
  </Stat>

  <div class="cb">
    <p class="cb-scale" aria-hidden="true">0 – {fmtUsd(yMax)} total cost</p>

    <div class="cb-body">
      <div class="cb-axis" aria-hidden="true">
        <span class="cb-tick cb-tick-start">0</span>
        <span class="cb-tick cb-tick-focal" style={`left: ${ttlPct.toFixed(2)}%`}>{fmtSeconds(TTL)}</span>
        <span class="cb-tick cb-tick-end">15 min</span>
      </div>

      <div class="cb-plot" role="img" aria-label={ariaLabel}>
        <span class="cb-seg cb-seg-nocache" style={`top: ${yNoCache.toFixed(2)}%`} />
        <span class="cb-seg cb-seg-onehour" style={`top: ${yOneHour.toFixed(2)}%`} />
        <span class="cb-seg cb-seg-hit" style={`top: ${yHit.toFixed(2)}%; width: ${ttlPct.toFixed(2)}%`} />
        <span class="cb-seg cb-seg-miss" style={`top: ${yMiss.toFixed(2)}%; left: ${ttlPct.toFixed(2)}%`} />
        <span
          class="cb-connector"
          style={`left: ${ttlPct.toFixed(2)}%; top: ${Math.min(yHit, yMiss).toFixed(2)}%; height: ${Math.abs(yMiss - yHit).toFixed(2)}%`}
        />
        <span class="cb-marker" style={`left: ${ttlPct.toFixed(2)}%`} />
      </div>

      <p class="cb-xtitle" aria-hidden="true">seconds between request starts →</p>
    </div>

    <ul class="cb-labels" aria-hidden="true">
      {
        lineLabels.map((l) => (
          <li class="cb-label" style={`top: ${l.y.toFixed(2)}%`}>
            <span class={`cb-dot cb-dot-${l.tone}`} />
            <span class:list={["cb-label-text", { strong: l.tone === "bad" || l.tone === "new" }]}>{l.text}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <DataTable
    slot="a11y"
    caption={`Cache break-even: 5-minute TTL at ${fmtSeconds(TTL)}.`}
    columns={["mode", "cost at short gaps", "cost past TTL"]}
    rows={[
      ["no cache", fmtUsd(noCacheCost), fmtUsd(noCacheCost)],
      ["1-hour cache", fmtUsd(oneHourCost), fmtUsd(oneHourCost)],
      ["5-minute cache", fmtUsd(fiveMinHit), fmtUsd(fiveMinMiss)],
    ]}
  />

  <Source slot="caption" links={[{ href: SOURCES.caching, label: "prompt caching" }, { href: SOURCES.pricing, label: "pricing" }]} asOf={FACTS_AS_OF}>
    Every request in this loop waits the same number of seconds, so a cache mode either hits on
    every request or misses on every request — the line steps once, at the TTL, instead of
    sloping. Claude Sonnet 5, 30-request loop.
  </Source>
</Figure>

<style>
  .cb {
    --cb-h: 190px;
    --cb-label-w: 8rem;
    font-size: var(--text-ui);
    line-height: var(--text-ui--line-height);
  }

  .cb-scale {
    margin: 0 0 6px;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: hsl(var(--muted-foreground));
  }

  .cb {
    display: grid;
    grid-template-columns: 1fr var(--cb-label-w);
    column-gap: 14px;
  }
  .cb-scale {
    grid-column: 1 / -1;
  }
  .cb-body {
    grid-column: 1;
    min-width: 0;
  }
  .cb-labels {
    grid-column: 2;
    position: relative;
    height: var(--cb-h);
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .cb-axis {
    position: relative;
    height: 18px;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: hsl(var(--muted-foreground));
  }
  .cb-tick {
    position: absolute;
    top: 0;
    white-space: nowrap;
    transform: translateX(-50%);
  }
  .cb-tick-start {
    left: 0;
    transform: none;
  }
  .cb-tick-end {
    right: 0;
    left: auto;
    transform: none;
  }
  .cb-tick-focal {
    color: hsl(var(--primary));
    font-weight: 700;
  }

  .cb-plot {
    position: relative;
    height: var(--cb-h);
    border-bottom: 1px solid hsl(var(--border));
  }

  /* Horizontal reference lines: two full-width flat lines (no cache, 1-hour), and the 5-minute
     step as two segments joined by a vertical connector at the TTL. */
  .cb-seg {
    position: absolute;
    height: 0;
    border-top-width: 2px;
  }
  .cb-seg-nocache {
    left: 0;
    right: 0;
    border-top-style: dashed;
    border-top-color: hsl(var(--muted-foreground));
  }
  .cb-seg-onehour {
    left: 0;
    right: 0;
    border-top-style: solid;
    border-top-color: var(--alc-good);
  }
  .cb-seg-hit {
    left: 0;
    border-top-style: solid;
    border-top-color: var(--alc-new);
  }
  .cb-seg-miss {
    right: 0;
    border-top-style: solid;
    border-top-color: var(--alc-bad);
  }
  .cb-connector {
    position: absolute;
    width: 0;
    border-left: 1px dashed hsl(var(--muted-foreground));
    opacity: 0.7;
  }
  .cb-marker {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 0;
    border-left: 1px dashed hsl(var(--foreground));
  }

  .cb-xtitle {
    margin: 8px 0 0;
    text-align: center;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: hsl(var(--muted-foreground));
  }

  .cb-label {
    position: absolute;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    white-space: nowrap;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: hsl(var(--muted-foreground));
  }
  .cb-label-text.strong {
    color: hsl(var(--foreground));
    font-weight: 700;
  }
  .cb-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 6px;
    border-radius: 2px;
    vertical-align: 1px;
  }
  .cb-dot-neutral {
    background: hsl(var(--muted-foreground));
  }
  .cb-dot-good {
    background: var(--alc-good);
  }
  .cb-dot-new {
    background: var(--alc-new);
  }
  .cb-dot-bad {
    background: var(--alc-bad);
  }

  @media (max-width: 560px) {
    .cb {
      grid-template-columns: 1fr;
    }
    .cb-labels {
      grid-column: 1;
      position: static;
      height: auto;
      margin: 10px 0 0;
      display: flex;
      flex-wrap: wrap;
      gap: 6px 16px;
    }
    .cb-label {
      position: static;
      transform: none;
      white-space: normal;
