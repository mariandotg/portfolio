---
// "What happens when a tool call takes longer than the cache lives?" Three cache modes,
// same 30-request loop, cumulative cost. Toggling the tool's latency past the 5-minute
// cache lifetime flips the 5-minute line from the cheapest option to the most expensive one.
import { simulate, SOURCES, FACTS_AS_OF } from "@/lib/sim/agent-loop";
import type { CacheMode } from "@/lib/sim/agent-loop";
import { BASE_WORKLOAD, FAST_TOOL_SECONDS, SLOW_TOOL_SECONDS } from "./workloads";
import { fmtUsd, fmtChange, cumulative, points, nudgeLabels } from "./format";
import Figure from "./kit/Figure.astro";
import Panel from "./kit/Panel.astro";
import Stat from "./kit/Stat.astro";
import Plot from "./kit/Plot.astro";
import Axis from "./kit/Axis.astro";
import Source from "./kit/Source.astro";
import DataTable from "./kit/DataTable.astro";
import { plotFrame } from "./kit/plot";

type StateKey = "fast" | "slow";

function costLine(gap: number, cache: CacheMode) {
  const r = simulate({ ...BASE_WORKLOAD, secondsBetweenRequests: gap, cache });
  return cumulative(r.requests.map((req) => req.costUsd));
}

function runState(gap: number) {
  const noCache = costLine(gap, "off");
  const fiveMin = costLine(gap, "5m");
  const oneHour = costLine(gap, "1h");
  return { noCache, fiveMin, oneHour };
}

const STATES: Record<StateKey, ReturnType<typeof runState>> = {
  fast: runState(FAST_TOOL_SECONDS),
  slow: runState(SLOW_TOOL_SECONDS),
};

const N = BASE_WORKLOAD.turns;
const total = (line: number[]) => line[line.length - 1];
const yMax = Math.max(...Object.values(STATES).flatMap((s) => [total(s.noCache), total(s.fiveMin), total(s.oneHour)]));

const frame = plotFrame({
  w: 480,
  h: 230,
  inset: { l: 6, r: 100, t: 34, b: 42 },
  x: [0, N - 1],
  y: [0, yMax],
});
const xAt = frame.x;
const yAt = frame.y;

function panelData(key: StateKey) {
  const s = STATES[key];
  const noCacheTotal = total(s.noCache);
  const fiveMinTotal = total(s.fiveMin);
  const oneHourTotal = total(s.oneHour);
  const fiveMinCheaper = fiveMinTotal < noCacheTotal;
  const labels = nudgeLabels(
    [
      { key: "no cache", y: yAt(noCacheTotal), value: noCacheTotal },
      { key: "5-min cache", y: yAt(fiveMinTotal), value: fiveMinTotal },
      { key: "1-hour cache", y: yAt(oneHourTotal), value: oneHourTotal },
    ],
    15,
  );
  return { s, noCacheTotal, fiveMinTotal, oneHourTotal, fiveMinCheaper, labels };
}

const PANELS: Record<StateKey, ReturnType<typeof panelData>> = { fast: panelData("fast"), slow: panelData("slow") };

const SUB: Record<StateKey, string> = {
  fast: "Each request reads the history it already paid for, at 0.1×.",
  slow: `The cache expires between requests, so every request writes its whole history again at 1.25×. The 1-hour cache stays at ${fmtUsd(PANELS.slow.oneHourTotal)}.`,
};

const OPTIONS = [
  { value: "fast", label: `tool takes ${FAST_TOOL_SECONDS} s` },
  { value: "slow", label: "tool takes 5 min 5 s" },
];
const INITIAL: StateKey = "fast";

const ariaLabel = (key: StateKey) => {
  const p = PANELS[key];
  return `Cumulative cost over ${N} requests when the tool takes ${key === "fast" ? `${FAST_TOOL_SECONDS} seconds` : "5 minutes 5 seconds"}. No cache: ${fmtUsd(p.noCacheTotal)}. 5-minute cache: ${fmtUsd(p.fiveMinTotal)}, ${fmtChange(p.fiveMinTotal, p.noCacheTotal)} vs no cache. 1-hour cache: ${fmtUsd(p.oneHourTotal)}.`;
};
---

<Figure
  question="What happens when a tool call takes longer than the cache lives?"
  basis="calculated"
  options={OPTIONS}
  initial={INITIAL}
>
  {
    (["fast", "slow"] as StateKey[]).map((key) => {
      const p = PANELS[key];
      const fiveMinClass = p.fiveMinCheaper ? "new" : "bad";
      const deltaTone = p.fiveMinCheaper ? "gain" : "loss";
      return (
        <Panel value={key} initial={INITIAL}>
          <Stat value={fmtUsd(p.fiveMinTotal)} delta={`${fmtChange(p.fiveMinTotal, p.noCacheTotal)} vs no cache`} tone={deltaTone}>
            {SUB[key]}
          </Stat>
          <Plot frame={frame} label={ariaLabel(key)}>
            <Axis frame={frame} y={`${fmtUsd(yMax)} cost so far`} x={["1", String(N)]} title="request →" />
            <polyline points={points(p.s.noCache, xAt, yAt)} class="alc-line neutral" />
            <polyline points={points(p.s.oneHour, xAt, yAt)} class="alc-line good" />
            <polyline points={points(p.s.fiveMin, xAt, yAt)} class={`alc-line ${fiveMinClass}`} />
            {p.labels.map((l) => (
              <text x={frame.right + 6} y={l.y + 4} class={l.key === "5-min cache" ? "alc-text-strong" : "alc-text"}>
                {l.key}
              </text>
            ))}
          </Plot>
        </Panel>
      );
    })
  }

  <Fragment slot="a11y">
    {
      (["fast", "slow"] as StateKey[]).map((key) => {
        const p = PANELS[key];
        return (
          <DataTable
            caption={ariaLabel(key)}
            columns={["mode", "total cost"]}
            rows={[
              ["no cache", fmtUsd(p.noCacheTotal)],
              ["5-minute cache", fmtUsd(p.fiveMinTotal)],
              ["1-hour cache", fmtUsd(p.oneHourTotal)],
            ]}
          />
        );
      })
    }
  </Fragment>

  <Source slot="caption" links={[{ href: SOURCES.pricing, label: "pricing" }, { href: SOURCES.caching, label: "prompt caching" }]} asOf={FACTS_AS_OF}>
    Cache read costs 0.1× base input. Cache write costs 1.25× (5-minute) or 2× (1-hour). Lifetime
    counts from the start of the request that wrote or read the entry. Claude Sonnet 5 prices.
  </Source>
</Figure>
