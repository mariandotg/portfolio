---
// "Why can clearing old tool results cost more than keeping them?" Stacked tokens sent per
// request against the full client history (ghost line) and the context-editing trigger.
// Clearing every step invalidates the cache on every clear; batching the clears mostly avoids that.
import { simulate, SOURCES, FACTS_AS_OF, CONTEXT_EDITING_DEFAULTS } from "@/lib/sim/agent-loop";
import { EDITING_WORKLOAD, editingWith, BATCHED_CLEAR_AT_LEAST } from "./workloads";
import { fmtTokens, fmtUsd, fmtChange, scale } from "./format";
import AlcFigure from "./AlcFigure.astro";

type StateKey = "each" | "batched";

const baseline = simulate(EDITING_WORKLOAD);
const RUNS: Record<StateKey, ReturnType<typeof simulate>> = {
  each: simulate(editingWith(0)),
  batched: simulate(editingWith(BATCHED_CLEAR_AT_LEAST)),
};

const N = EDITING_WORKLOAD.turns;
const trigger = CONTEXT_EDITING_DEFAULTS.trigger;

const yMax = Math.max(
  ...RUNS.each.requests.map((r) => r.historyTokens),
  ...RUNS.batched.requests.map((r) => r.historyTokens),
);

const VB_W = 480;
const VB_H = 250;
const PLOT_LEFT = 6;
const PLOT_RIGHT = VB_W - 130;
const PLOT_TOP = 34;
const PLOT_BOTTOM = 196;

const barWidth = (PLOT_RIGHT - PLOT_LEFT) / N;
const barGap = Math.min(1, barWidth * 0.15);
const barX = (i: number) => PLOT_LEFT + i * barWidth;
const barCenter = (i: number) => barX(i) + (barWidth - barGap) / 2;

const yAt = scale(0, yMax, PLOT_BOTTOM, PLOT_TOP);

function panelData(key: StateKey) {
  const r = RUNS[key];
  const clears = r.requests.filter((req) => req.clearedTokens > 0).length;
  const ghostPoints = r.requests.map((req, i) => `${barCenter(i).toFixed(1)},${yAt(req.historyTokens).toFixed(1)}`).join(" ");
  const bars = r.requests.map((req, i) => {
    const cum1 = req.cacheReadTokens;
    const cum2 = req.cacheReadTokens + req.cacheWriteTokens;
    const cum3 = req.cacheReadTokens + req.cacheWriteTokens + req.uncachedInputTokens;
    const y1 = yAt(cum1);
    const y2 = yAt(cum2);
    const y3 = yAt(cum3);
    return { x: barX(i), y1, y2, y3 };
  });
  return { r, clears, ghostPoints, bars, editedTotal: r.totals.costUsd };
}

const PANELS: Record<StateKey, ReturnType<typeof panelData>> = { each: panelData("each"), batched: panelData("batched") };

const SUB: Record<StateKey, string> = {
  each: `${PANELS.each.clears} of ${N} requests clear something. No cache entry ends where the edit happened, so each of those requests writes everything after the task again.`,
  batched: `Clearing happens in ${PANELS.batched.clears} batches. Most requests read the cache again.`,
};

const OPTIONS = [
  { value: "each", label: "clear_at_least: 0" },
  { value: "batched", label: "clear_at_least: 20k" },
];

const lastHistory = yMax;
const historyLabelY = yAt(lastHistory);
const triggerY = yAt(trigger);
---

<AlcFigure question="Why can clearing old tool results cost more than keeping them?" options={OPTIONS} initial="each">
  {
    (["each", "batched"] as StateKey[]).map((key) => {
      const p = PANELS[key];
      const deltaClass = p.editedTotal < baseline.totals.costUsd ? "good" : "bad";
      return (
        <div data-alc-panel={key} hidden={key !== "each"}>
          <div class="alc-headline">
            <span class="alc-big">{fmtUsd(p.editedTotal)}</span>
            <span class={`alc-delta ${deltaClass}`}>{fmtChange(p.editedTotal, baseline.totals.costUsd)} vs no clearing</span>
          </div>
          <p class="alc-sub">{SUB[key]}</p>
          <svg
            viewBox={`0 0 ${VB_W} ${VB_H}`}
            class="alc-svg"
            role="img"
            aria-label={`Tokens sent per request over ${N} requests, clear_at_least ${key === "each" ? "0" : fmtTokens(BATCHED_CLEAR_AT_LEAST)}. ${p.clears} of ${N} requests clear something. Total cost ${fmtUsd(p.editedTotal)}, ${fmtChange(p.editedTotal, baseline.totals.costUsd)} vs no clearing. The full client history reaches ${fmtTokens(yMax)}; clearing keeps the prompt near the ${fmtTokens(trigger)} trigger.`}
          >
            <text x={PLOT_LEFT} y={PLOT_TOP - 10} class="alc-text">{fmtTokens(yMax)} tokens sent</text>
            <line x1={PLOT_LEFT} y1={PLOT_BOTTOM} x2={PLOT_RIGHT} y2={PLOT_BOTTOM} class="alc-axis" />
            <text x={PLOT_LEFT} y={PLOT_BOTTOM + 16} class="alc-text">1</text>
            <text x={PLOT_RIGHT} y={PLOT_BOTTOM + 16} class="alc-text" text-anchor="end">{N}</text>
            <text x={(PLOT_LEFT + PLOT_RIGHT) / 2} y={PLOT_BOTTOM + 28} class="alc-text" text-anchor="middle">request →</text>

            <line x1={PLOT_LEFT} y1={triggerY} x2={PLOT_RIGHT} y2={triggerY} class="alc-marker" />
            <text x={PLOT_RIGHT + 6} y={triggerY + 4} class="alc-text">trigger {fmtTokens(trigger)}</text>

            {p.bars.map((b) => (
              <>
                <rect x={b.x} y={b.y1} width={barWidth - barGap} height={Math.max(0, PLOT_BOTTOM - b.y1)} class="alc-fill-read" />
                <rect x={b.x} y={b.y2} width={barWidth - barGap} height={Math.max(0, b.y1 - b.y2)} class="alc-fill-write" />
                <rect x={b.x} y={b.y3} width={barWidth - barGap} height={Math.max(0, b.y2 - b.y3)} class="alc-fill-uncached" />
              </>
            ))}

            <polyline points={p.ghostPoints} class="alc-ghost" />
            <text x={PLOT_RIGHT + 6} y={historyLabelY + 4} class="alc-text">
              <tspan x={PLOT_RIGHT + 6} dy="0">history without</tspan>
              <tspan x={PLOT_RIGHT + 6} dy="13">clearing</tspan>
            </text>
          </svg>
          <ul class="alc-legend">
            <li><svg width="10" height="10" class="alc-swatch" aria-hidden="true"><rect width="10" height="10" class="alc-fill-read" /></svg>read from cache (0.1×)</li>
            <li><svg width="10" height="10" class="alc-swatch" aria-hidden="true"><rect width="10" height="10" class="alc-fill-write" /></svg>written to cache (1.25×)</li>
          </ul>
        </div>
      );
    })
  }
  <Fragment slot="caption">
    <code>clear_tool_uses_20250919</code> defaults: 100k-token trigger, keep the last 3 results.
    Clearing invalidates the cached prefix (<a href={SOURCES.contextEditing}>context editing</a>), as of {FACTS_AS_OF}.
    Assumption: a cleared result leaves a 10-token placeholder, and only the cleared blocks change, so a
    request still reads the last cache entry written before the first of them.
  </Fragment>
</AlcFigure>
