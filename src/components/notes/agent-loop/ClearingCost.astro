---
// "Why can clearing old tool results cost more than keeping them?" Stacked tokens sent per
// request against the full client history (ghost line) and the context-editing trigger.
// Clearing every step invalidates the cache on every clear; batching the clears mostly avoids that.
import { simulate, SOURCES, FACTS_AS_OF, CONTEXT_EDITING_DEFAULTS } from "@/lib/sim/agent-loop";
import { EDITING_WORKLOAD, editingWith, BATCHED_CLEAR_AT_LEAST } from "./workloads";
import { fmtTokens, fmtUsd, fmtChange } from "./format";
import Figure from "./kit/Figure.astro";
import Panel from "./kit/Panel.astro";
import Stat from "./kit/Stat.astro";
import Plot from "./kit/Plot.astro";
import Axis from "./kit/Axis.astro";
import Legend from "./kit/Legend.astro";
import Source from "./kit/Source.astro";
import DataTable from "./kit/DataTable.astro";
import { plotFrame } from "./kit/plot";

type StateKey = "each" | "batched";

const baseline = simulate(EDITING_WORKLOAD);
const RUNS: Record<StateKey, ReturnType<typeof simulate>> = {
  each: simulate(editingWith(0)),
  batched: simulate(editingWith(BATCHED_CLEAR_AT_LEAST)),
};

const N = EDITING_WORKLOAD.turns;
const trigger = CONTEXT_EDITING_DEFAULTS.trigger;

const yMax = Math.max(
  ...RUNS.each.requests.map((r) => r.historyTokens),
  ...RUNS.batched.requests.map((r) => r.historyTokens),
);

const frame = plotFrame({
  w: 480,
  h: 250,
  inset: { l: 6, r: 130, t: 34, b: 54 },
  x: [0, N],
  y: [0, yMax],
  bands: N,
  bandGap: Math.min(1, ((480 - 6 - 130) / N) * 0.15),
});

const yAt = frame.y;
const barWidth = frame.bandWidth;
const barX = (i: number) => frame.band(i);
const barCenter = (i: number) => frame.bandCenter(i);

function panelData(key: StateKey) {
  const r = RUNS[key];
  const clears = r.requests.filter((req) => req.clearedTokens > 0).length;
  const ghostPoints = r.requests.map((req, i) => `${barCenter(i).toFixed(1)},${yAt(req.historyTokens).toFixed(1)}`).join(" ");
  const bars = r.requests.map((req, i) => {
    const cum1 = req.cacheReadTokens;
    const cum2 = req.cacheReadTokens + req.cacheWriteTokens;
    const cum3 = req.cacheReadTokens + req.cacheWriteTokens + req.uncachedInputTokens;
    const y1 = yAt(cum1);
    const y2 = yAt(cum2);
    const y3 = yAt(cum3);
    return { x: barX(i), y1, y2, y3 };
  });
  return { r, clears, ghostPoints, bars, editedTotal: r.totals.costUsd };
}

const PANELS: Record<StateKey, ReturnType<typeof panelData>> = { each: panelData("each"), batched: panelData("batched") };

const SUB: Record<StateKey, string> = {
  each: `${PANELS.each.clears} of ${N} requests clear something. No cache entry ends where the edit happened, so each of those requests writes everything after the task again.`,
  batched: `Clearing happens in ${PANELS.batched.clears} batches. Most requests read the cache again.`,
};

const OPTIONS = [
  { value: "each", label: "clear_at_least: 0" },
  { value: "batched", label: "clear_at_least: 20k" },
];

const historyLabelY = yAt(yMax);
const triggerY = yAt(trigger);
const INITIAL: StateKey = "each";

const ariaLabel = (key: StateKey) => {
  const p = PANELS[key];
  return `Tokens sent per request over ${N} requests, clear_at_least ${key === "each" ? "0" : fmtTokens(BATCHED_CLEAR_AT_LEAST)}. ${p.clears} of ${N} requests clear something. Total cost ${fmtUsd(p.editedTotal)}, ${fmtChange(p.editedTotal, baseline.totals.costUsd)} vs no clearing. The full client history reaches ${fmtTokens(yMax)}; clearing keeps the prompt near the ${fmtTokens(trigger)} trigger.`;
};
---

<Figure question="Why can clearing old tool results cost more than keeping them?" basis="calculated" options={OPTIONS} initial={INITIAL}>
  {
    (["each", "batched"] as StateKey[]).map((key) => {
      const p = PANELS[key];
      const deltaTone = p.editedTotal < baseline.totals.costUsd ? "gain" : "loss";
      return (
        <Panel value={key} initial={INITIAL}>
          <Stat value={fmtUsd(p.editedTotal)} delta={`${fmtChange(p.editedTotal, baseline.totals.costUsd)} vs no clearing`} tone={deltaTone}>
            {SUB[key]}
          </Stat>
          <Plot frame={frame} label={ariaLabel(key)}>
            <Axis frame={frame} y={`${fmtTokens(yMax)} tokens sent`} x={["1", String(N)]} title="request →" />
            <line x1={frame.left} y1={triggerY} x2={frame.right} y2={triggerY} class="alc-marker" />
            <text x={frame.right + 6} y={triggerY + 4} class="alc-text">trigger {fmtTokens(trigger)}</text>

            {p.bars.map((b) => (
              <>
                <rect x={b.x} y={b.y1} width={barWidth} height={Math.max(0, frame.bottom - b.y1)} class="alc-fill-read" />
                <rect x={b.x} y={b.y2} width={barWidth} height={Math.max(0, b.y1 - b.y2)} class="alc-fill-write" />
                <rect x={b.x} y={b.y3} width={barWidth} height={Math.max(0, b.y2 - b.y3)} class="alc-fill-uncached" />
              </>
            ))}

            <polyline points={p.ghostPoints} class="alc-ghost" />
            <text x={frame.right + 6} y={historyLabelY + 4} class="alc-text">
              <tspan x={frame.right + 6} dy="0">history without</tspan>
              <tspan x={frame.right + 6} dy="13">clearing</tspan>
            </text>
          </Plot>
          <Legend
            items={[
              { tone: "read", label: "read from cache (0.1×)" },
              { tone: "write", label: "written to cache (1.25×)" },
            ]}
          />
        </Panel>
      );
    })
  }

  <Fragment slot="a11y">
    {
      (["each", "batched"] as StateKey[]).map((key) => (
        <DataTable
          caption={ariaLabel(key)}
          columns={["metric", "value"]}
          rows={[
            ["total cost", fmtUsd(PANELS[key].editedTotal)],
            ["requests that clear", String(PANELS[key].clears)],
            ["vs no clearing", fmtChange(PANELS[key].editedTotal, baseline.totals.costUsd)],
          ]}
        />
      ))
    }
  </Fragment>

  <Source slot="caption" links={[{ href: SOURCES.contextEditing, label: "context editing" }]} asOf={FACTS_AS_OF}>
    <code>clear_tool_uses_20250919</code> defaults: 100k-token trigger, keep the last 3 results.
    Clearing invalidates the cached prefix. Assumption: a cleared result leaves a 10-token placeholder, and only the cleared blocks change, so a
    request still reads the last cache entry written before the first of them.
  </Source>
</Figure>
