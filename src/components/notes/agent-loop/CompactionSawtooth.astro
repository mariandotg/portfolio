---
// Static diagram: compaction resets the context each time it crosses the trigger, so the
// history draws a sawtooth instead of a straight climb. Two compactions on this workload.
// variant="cost" (default): dollar headline, unchanged — used by note 1. variant="context":
// tokens only, no dollars, no compact_20260112 parameter detail — used by note 3. Only the dollar
// headline rests on an undocumented behaviour (whether the compaction pass reads the cache like a
// normal request), so the basis differs by variant. The svg carries geometry only (no <text>);
// labels are HTML, positioned from the same plot frame, so they stay readable on phones.
import Figure from "./kit/Figure.astro";
import Stat from "./kit/Stat.astro";
import Plot from "./kit/Plot.astro";
import Axis from "./kit/Axis.astro";
import Source from "./kit/Source.astro";
import DataTable from "./kit/DataTable.astro";
import { plotFrame } from "./kit/plot";
import { simulate, COMPACTION_LIMITS, SOURCES, FACTS_AS_OF } from "@/lib/sim/agent-loop";
import { COMPACTION_WORKLOAD, compactionWith } from "./workloads";
import { fmtTokens, fmtUsd, fmtChange, points } from "./format";
import { getLangFromUrl } from "../../../i18n/utils";

interface Props {
  variant?: "cost" | "context";
}
const { variant = "cost" } = Astro.props;
const isSpanish = getLangFromUrl(Astro.url) === "es";

const without = simulate(COMPACTION_WORKLOAD);
const withC = simulate(compactionWith());

const N = COMPACTION_WORKLOAD.turns;
const maxWithout = Math.max(...without.requests.map((r) => r.contextTokens));
const yDomainMax = maxWithout * 1.1;

const frame = plotFrame({
  w: 480,
  h: 280,
  inset: { l: 14, r: 12, t: 44, b: 30 },
  x: [1, N],
  y: [0, yDomainMax],
});
const x = frame.x;
const y = frame.y;

const ghostPoints = points(
  without.requests.map((r) => r.contextTokens),
  (i) => x(i + 1),
  y,
);
const withValues = withC.requests.map((r) => r.contextTokens);
const outlinePoints = points(withValues, (i) => x(i + 1), y);
const areaPoints = `${x(1)},${y(0)} ${outlinePoints} ${x(N)},${y(0)}`;

const triggerY = y(COMPACTION_LIMITS.defaultTrigger);
const compactions = withC.requests
  .filter((r) => r.compaction)
  .map((r) => ({ index: r.index, inputTokens: r.compaction!.inputTokens }));

const peakWithout = without.totals.peakContextTokens;
const peakWith = withC.totals.peakContextTokens;
const costWithout = without.totals.costUsd;
const costWith = withC.totals.costUsd;

// SVG user units -> % of the plot box, so HTML labels can sit on top of the geometry-only svg.
const px = (v: number) => ((v / frame.w) * 100).toFixed(2);
const py = (v: number) => ((v / frame.h) * 100).toFixed(2);

const ariaLabel = isSpanish
  ? variant === "cost"
    ? `Tokens de contexto en ${N} solicitudes. Sin compactación, el contexto sube hasta ${fmtTokens(peakWithout)} y cuesta ${fmtUsd(costWithout)}. Con compactación, el contexto se reinicia dos veces en el umbral de 150k y alcanza ${fmtTokens(peakWith)}, con un coste de ${fmtUsd(costWith)}.`
    : `Tokens de contexto en ${N} solicitudes. Sin compactación, el contexto sube hasta ${fmtTokens(peakWithout)}. Con compactación, el contexto se reemplaza por un resumen al alcanzar el umbral de 150k, se reinicia dos veces y alcanza ${fmtTokens(peakWith)}.`
  : variant === "cost"
    ? `Context tokens across 80 requests. Without compaction the context climbs to ${fmtTokens(peakWithout)} and costs ${fmtUsd(costWithout)}. With compaction the context resets twice at the 150k trigger and peaks at ${fmtTokens(peakWith)}, costing ${fmtUsd(costWith)}.`
    : `Context tokens across 80 requests. Without compaction the context climbs to ${fmtTokens(peakWithout)}. With compaction the context is replaced by a summary once it reaches the 150k trigger, resetting twice, and peaks at ${fmtTokens(peakWith)}.`;
---

<Figure question={isSpanish ? "¿Qué le hace la compactación al contexto?" : "What does compaction do to the context?"} basis={variant === "cost" ? "assumed" : "calculated"}>
  {
    variant === "cost" ? (
      <Stat value={fmtUsd(costWith)} delta={`${fmtChange(costWith, costWithout)} ${isSpanish ? "frente a sin compactación" : "vs no compaction"}`} tone="gain">
        {isSpanish
          ? <>Contexto máximo: <strong>{fmtTokens(peakWith)}</strong> en lugar de <strong>{fmtTokens(peakWithout)}</strong>. Cada pasada de compactación lee todo el contexto una vez y esa pasada se factura.</>
          : <>Peak context <strong>{fmtTokens(peakWith)}</strong> instead of <strong>{fmtTokens(peakWithout)}</strong>. Each compaction pass reads the whole context once, and that pass is billed.</>}
      </Stat>
    ) : (
      <Stat value={fmtTokens(peakWith)} unit={isSpanish ? "contexto máximo" : "peak context"} delta={`${fmtChange(peakWith, peakWithout)} ${isSpanish ? "frente a sin compactación" : "vs no compaction"}`} tone="gain">
        {isSpanish
          ? <>Sin compactación, el contexto sube hasta <strong>{fmtTokens(peakWithout)}</strong>. Con ella, el contexto se reemplaza por un resumen al alcanzar el umbral y nunca supera <strong>{fmtTokens(peakWith)}</strong>.</>
          : <>Without compaction the context climbs to <strong>{fmtTokens(peakWithout)}</strong>. With it, the context is replaced by a summary once it reaches the trigger, and it never passes <strong>{fmtTokens(peakWith)}</strong>.</>}
      </Stat>
    )
  }

  <div class="sw-plot">
    <Plot frame={frame} label={ariaLabel}>
      <Axis frame={frame} rule />

      <line
        class="alc-marker"
        x1={frame.left}
        y1={triggerY}
        x2={frame.right}
        y2={triggerY}
        vector-effect="non-scaling-stroke"
      />
      <polyline class="alc-ghost" points={ghostPoints} vector-effect="non-scaling-stroke" />

      <polygon class="alc-fill-read" points={areaPoints} />
      <polyline class="alc-line new" points={outlinePoints} vector-effect="non-scaling-stroke" />

      {
        compactions.map((c) => (
          <line
            class="alc-marker"
            x1={x(c.index)}
            y1={y(0)}
            x2={x(c.index)}
            y2={y(c.inputTokens)}
            vector-effect="non-scaling-stroke"
          />
        ))
      }
    </Plot>

    <div class="sw-label sw-axis" style={`left: ${px(frame.left)}%; top: ${py(frame.bottom)}%`} aria-hidden="true">
      {isSpanish ? "solicitud 1" : "request 1"}
    </div>
    <div
      class="sw-label sw-axis sw-axis-end"
      style={`left: ${px(frame.right)}%; top: ${py(frame.bottom)}%`}
      aria-hidden="true"
    >
      {isSpanish ? "solicitud" : "request"} {N}
    </div>
    <div class="sw-label sw-trigger" style={`left: ${px(frame.right)}%; top: ${py(triggerY)}%`} aria-hidden="true">
      {isSpanish ? "umbral" : "trigger"} {fmtTokens(COMPACTION_LIMITS.defaultTrigger)}
    </div>
    <div
      class="sw-label sw-ghost"
      style={`left: ${px(x(N))}%; top: ${py(y(maxWithout))}%`}
      aria-hidden="true"
    >
      {isSpanish ? "sin compactación" : "without compaction"}
    </div>
    {
      compactions.map((c, i) => (
        <div
          class:list={["sw-label sw-summary", { "sw-summary-later": i > 0 }]}
          style={`left: ${px(x(c.index))}%; top: ${py(y(c.inputTokens))}%`}
          aria-hidden="true"
        >
          {isSpanish ? "resumen" : "summary"}
        </div>
      ))
    }
  </div>

  <DataTable
    slot="a11y"
    caption={`${isSpanish ? "Compactación en" : "Compaction across"} ${N} ${isSpanish ? "solicitudes, variante" : "requests, variant"} ${isSpanish ? (variant === "cost" ? "coste" : "contexto") : variant}.`}
    columns={isSpanish ? ["modo", "contexto máximo", variant === "cost" ? "coste total" : "notas"] : ["mode", "peak context", variant === "cost" ? "total cost" : "notes"]}
    rows={[
      [isSpanish ? "sin compactación" : "without compaction", fmtTokens(peakWithout), variant === "cost" ? fmtUsd(costWithout) : "—"],
      [isSpanish ? "con compactación" : "with compaction", fmtTokens(peakWith), variant === "cost" ? fmtUsd(costWith) : `${compactions.length} ${isSpanish ? "compactaciones" : "compactions"}`],
    ]}
  />

  <Source slot="caption" links={[{ href: SOURCES.compaction, label: isSpanish ? "documentación de compactación" : "compaction docs" }]} asOf={FACTS_AS_OF}>
    {
      variant === "cost" ? (
        <>
          <code>compact_20260112</code> {isSpanish ? "se activa en 150k tokens (mínimo 50k) y factura la pasada de resumen. No está disponible en Haiku 4.5. Supuesto: la pasada de compactación lee la caché como una solicitud normal." : "triggers at 150k tokens (minimum 50k) and bills the summarization pass. Not available on Haiku 4.5. Assumption: the compaction pass reads the cache like a normal request."}
        </>
      ) : (
        <>{isSpanish ? "El contexto se reemplaza por un resumen al alcanzar el umbral (150k tokens, mínimo 50k)." : "The context is replaced by a summary once it reaches the trigger (150k tokens, minimum 50k)."}</>
      )
    }
  </Source>
</Figure>

<style>
  .sw-plot {
    position: relative;
  }
  .sw-label {
    position: absolute;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
    pointer-events: none;
  }
  .sw-axis {
    transform: translateY(6px);
  }
  .sw-axis-end {
    transform: translate(-100%, 6px);
  }
  /* Right end, above the line: the ramps fill everything below it, the summary labels sit above it further left. */
  .sw-trigger {
    transform: translate(-100%, calc(-100% - 2px));
  }
  .sw-ghost {
    transform: translate(-100%, -100%);
  }
  .sw-summary {
    transform: translate(-100%, -100%);
  }

  @media (max-width: 400px) {
    .sw-ghost {
      display: none;
    }
    /* One "summary" names the event; the later ones would run into the trigger label. */
    .sw-summary-later {
      display: none;
    }
  }
</style>
