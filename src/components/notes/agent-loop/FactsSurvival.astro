---
// Diagram version of the toggle: history vs case facts block on one table instead of two panels.
// Each fact gets a row pair — one strip for "history only", one for "case facts block" — sharing the
// fact label (rowspan) and the compaction-boundary columns, so the two strategies line up and the
// gap between them reads without switching state. Compaction drops every block before the summary,
// so a fact survives raw in history only until the next compaction after it was introduced; a case
// facts block sends every fact every prompt, immune to compaction.
import Figure from "./kit/Figure.astro";
import Legend from "./kit/Legend.astro";
import Source from "./kit/Source.astro";
import { simulate, COMPACTION_LIMITS, SOURCES, FACTS_AS_OF } from "@/lib/sim/agent-loop";
import { COMPACTION_WORKLOAD, compactionWith } from "./workloads";
import { fmtTokens } from "./format";
import { getLangFromUrl } from "../../../i18n/utils";

const isSpanish = getLangFromUrl(Astro.url) === "es";

const run = simulate(compactionWith(COMPACTION_LIMITS.minTrigger));
const N = COMPACTION_WORKLOAD.turns;
const compactionIndices = run.requests.filter((r) => r.compaction).map((r) => r.index);

const segStarts = [1, ...compactionIndices];
const segEnds = [...compactionIndices.map((c) => c - 1), N];
const segments = segStarts.map((start, i) => ({ start, end: segEnds[i] }));
const lastSeg = segments.length - 1;

const FACTS = [
  { key: "order", label: isSpanish ? "número de pedido" : "order number", introducedAt: 2 },
  { key: "amount", label: isSpanish ? "importe cobrado" : "amount charged", introducedAt: 15 },
  { key: "date", label: isSpanish ? "fecha de compra" : "purchase date", introducedAt: 30 },
  { key: "status", label: isSpanish ? "estado del caso" : "case status", introducedAt: 45 },
  { key: "refund", label: isSpanish ? "reembolso prometido" : "refund promised", introducedAt: 63 },
  { key: "deadline", label: isSpanish ? "fecha límite del reembolso" : "refund deadline", introducedAt: 76 },
] as const;

const segmentOf = (requestIndex: number) => segments.findIndex((s) => requestIndex >= s.start && requestIndex <= s.end);
const facts = FACTS.map((f) => ({ ...f, introSeg: segmentOf(f.introducedAt) }));

type CellState = "unknown" | "verbatim" | "maybe" | "kept";
type PanelKey = "history" | "casefacts";
const cellState = (panel: PanelKey, introSeg: number, seg: number): CellState => {
  if (seg < introSeg) return "unknown";
  if (panel === "casefacts") return "kept";
  return seg === introSeg ? "verbatim" : "maybe";
};
const cellClass = (state: CellState) => (state === "unknown" ? "fs-unknown" : state === "maybe" ? "fs-maybe" : "fs-verbatim");

const verbatimAtLast = (panel: PanelKey) =>
  facts.filter((f) => {
    const s = cellState(panel, f.introSeg, lastSeg);
    return s !== "unknown" && s !== "maybe";
  }).length;
const historyCount = verbatimAtLast("history");
const casefactsCount = verbatimAtLast("casefacts");

const CASE_FACTS_BLOCK_TOKENS = 30 * FACTS.length;

// One narrative sentence per fact per strategy: the visible table carries state by color and
// position, this carries it in words for a screen reader.
const rowSentence = (panel: PanelKey, f: (typeof facts)[number]) => {
  if (panel === "casefacts") {
    return isSpanish
      ? `textual en el bloque de datos del caso desde la solicitud ${f.introducedAt} hasta la solicitud ${N}.`
      : `verbatim in the case facts block from request ${f.introducedAt} through request ${N}.`;
  }
  if (f.introSeg === lastSeg) {
    return isSpanish
      ? `introducido en la solicitud ${f.introducedAt}, todavía textual en la solicitud ${N}.`
      : `introduced at request ${f.introducedAt}, still verbatim at request ${N}.`;
  }
  const staleFrom = segments[f.introSeg].end + 1;
  return isSpanish
    ? `textual solo después de la solicitud ${f.introducedAt}; luego solo está en el resumen desde la solicitud ${staleFrom} hasta la solicitud ${N}.`
    : `verbatim only right after request ${f.introducedAt}, then only in the summary from request ${staleFrom} through request ${N}.`;
};

const FACT_COL_PCT = 22;
const STRATEGY_COL_PCT = 9;
const dataColPct = (100 - FACT_COL_PCT - STRATEGY_COL_PCT) / segments.length;

const tableCaption = isSpanish
  ? `Seis datos de un caso en ${N} solicitudes, con ${compactionIndices.length} compactaciones: cuántos permanecen textuales en el contexto, solo en el historial de conversación frente a un bloque de datos del caso enviado en cada prompt.`
  : `Six case facts across ${N} requests, compacted ${compactionIndices.length} times: how many stay verbatim in context, kept only in the conversation history versus carried in a case facts block sent on every prompt.`;
const figureQuestion = isSpanish
  ? "¿Cuántos datos de un caso de soporte llegan a la última solicitud?"
  : "How many of a support case" + String.fromCharCode(39) + "s facts survive to the last request?";
---

<Figure question={figureQuestion} basis="assumed">
  <div class="fs">
    <div class="fs-summary">
      <div class="fs-stat">
        <span class="fs-stat-value">{historyCount} {isSpanish ? "de" : "of"} {facts.length}</span>
        <span class="fs-stat-label">{isSpanish ? "textuales — solo datos en el historial" : "verbatim — facts only in the history"}</span>
      </div>
      <div class="fs-stat fs-stat-focal">
        <span class="fs-stat-value">{casefactsCount} {isSpanish ? "de" : "of"} {facts.length}</span>
        <span class="fs-stat-label">{isSpanish ? "textuales — bloque de datos del caso" : "verbatim — case facts block"}</span>
      </div>
    </div>

    <div class="fs-scroll">
      <table class="fs-table">
        <caption class="sr-only">{tableCaption}</caption>
        <colgroup>
          <col style={`width: ${FACT_COL_PCT}%`} />
          <col style={`width: ${STRATEGY_COL_PCT}%`} />
          {segments.map(() => (
            <col style={`width: ${dataColPct}%`} />
          ))}
        </colgroup>
        <thead>
          <tr>
            <th scope="col" class="fs-corner">
              <span class="sr-only">{isSpanish ? "dato" : "fact"}</span>
            </th>
            <th scope="col" class="fs-corner">
              <span class="sr-only">{isSpanish ? "estrategia" : "strategy"}</span>
            </th>
            {
              segments.map((s, i) => (
                <th scope="col" class="fs-colhead">
                  {i === 0 && <span class="fs-tick">{isSpanish ? "sol. 1" : "req 1"}</span>}
                  {i === segments.length - 1 && (
                    <span class="fs-tick fs-tick-end">{isSpanish ? "sol." : "req"} {N}</span>
                  )}
                  <span class="sr-only">
                    {isSpanish ? "solicitudes" : "requests"} {s.start}&ndash;{s.end}
                  </span>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            facts.map((f, fi) => (
              <>
                <tr class:list={["fs-row", { "fs-row-alt": fi % 2 === 1 }]}>
                  <th rowspan={2} scope="rowgroup" class="fs-fact">
                    {f.label}
                  </th>
                  <th scope="row" class="fs-strategy">
                    <span aria-hidden="true">{isSpanish ? "hist." : "hist"}</span>
                    <span class="sr-only">{isSpanish ? "historial —" : "history —"} {rowSentence("history", f)}</span>
                  </th>
                  {
                    segments.map((_, ci) => {
                      const state = cellState("history", f.introSeg, ci);
                      return (
                        <td class:list={["fs-cell", cellClass(state), { "fs-boundary": ci > 0 }]} aria-hidden="true">
                          <span class="fs-swatch" />
                        </td>
                      );
                    })
                  }
                </tr>
                <tr class:list={["fs-row", "fs-row-last", { "fs-row-alt": fi % 2 === 1 }]}>
                  <th scope="row" class="fs-strategy fs-strategy-focal">
                    <span aria-hidden="true">{isSpanish ? "caso" : "case"}</span>
                    <span class="sr-only">{isSpanish ? "datos del caso —" : "facts —"} {rowSentence("casefacts", f)}</span>
                  </th>
                  {
                    segments.map((_, ci) => {
                      const state = cellState("casefacts", f.introSeg, ci);
                      return (
                        <td class:list={["fs-cell", cellClass(state), { "fs-boundary": ci > 0 }]} aria-hidden="true">
                          <span class="fs-swatch" />
                        </td>
                      );
                    })
                  }
                </tr>
              </>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>

  <Legend
    items={[
      { tone: "new", label: isSpanish ? "textual en el contexto" : "verbatim in context" },
      { tone: "resent", label: isSpanish ? "solo en el resumen, sin garantía" : "only in the summary, not guaranteed" },
      { tone: "ghost", label: isSpanish ? "todavía desconocido" : "not yet known" },
    ]}
  />

  <Source slot="caption" links={[{ href: SOURCES.compaction, label: isSpanish ? "documentación de compactación" : "compaction docs" }]} asOf={FACTS_AS_OF}>
    {isSpanish
      ? `${facts.length} datos ilustrativos de un caso de soporte, colocados en la solicitud que los introduce. El umbral de compactación baja al mínimo documentado (${fmtTokens(COMPACTION_LIMITS.minTrigger)}), por lo que el bucle de ${N} solicitudes se compacta ${compactionIndices.length} veces en lugar de 2. Un bloque de datos del caso supone unos ${fmtTokens(CASE_FACTS_BLOCK_TOKENS)} tokens para ${facts.length} datos breves. La tabla muestra qué descarta la compactación, no la probabilidad de que el resumen conserve un dato.`
      : `${facts.length} illustrative facts of one support case, placed at the request that introduces them. Compaction trigger lowered to the documented minimum (${fmtTokens(COMPACTION_LIMITS.minTrigger)}) so the ${N}-request loop compacts ${compactionIndices.length} times instead of 2. A case facts block assumes about ${fmtTokens(CASE_FACTS_BLOCK_TOKENS)} tokens for ${facts.length} short facts. The table tracks what compaction drops, never a probability that the summary kept a fact.`}
  </Source>
</Figure>

<style>
  .fs {
    font-size: var(--text-ui);
    line-height: var(--text-ui--line-height);
  }

  .fs-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 28px;
    margin-bottom: 14px;
  }
  .fs-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .fs-stat-value {
    font-family: var(--font-family-mono);
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    font-weight: 700;
    color: hsl(var(--foreground));
  }
  .fs-stat-focal .fs-stat-value {
    color: hsl(var(--primary));
  }
  .fs-stat-label {
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: hsl(var(--muted-foreground));
  }

  .fs-scroll {
    overflow-x: visible;
  }

  .fs-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-family: var(--font-family-display);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
  }

  .fs-corner {
    font-weight: 400;
  }

  .fs-colhead {
    position: relative;
    height: 20px;
    padding: 0 0 4px;
    text-align: left;
    vertical-align: bottom;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    font-weight: 400;
    color: hsl(var(--muted-foreground));
  }
  /* Ticks hang from their column's outer edge, so "req 80" grows into the table, not past the card. */
  .fs-tick {
    position: absolute;
    bottom: 4px;
    left: 0;
    white-space: nowrap;
  }
  .fs-tick-end {
    left: auto;
    right: 0;
  }
  .fs-boundary {
    border-left: 1px dashed color-mix(in srgb, hsl(var(--foreground)) 40%, transparent);
  }

  .fs-fact {
    padding: 6px 8px 6px 0;
    text-align: left;
    vertical-align: top;
    font-weight: 400;
    color: hsl(var(--foreground));
    overflow-wrap: break-word;
  }
  .fs-strategy {
    padding: 2px 6px 2px 0;
    text-align: left;
    vertical-align: middle;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    font-weight: 400;
    color: hsl(var(--muted-foreground));
  }
  .fs-strategy-focal {
    color: hsl(var(--primary));
  }

  .fs-row-alt .fs-fact,
  .fs-row-alt .fs-cell {
    background: color-mix(in srgb, hsl(var(--muted-foreground)) 5%, transparent);
  }
  .fs-row-last {
    border-bottom: 1px solid hsl(var(--border));
  }

  .fs-cell {
    padding: 2px;
    vertical-align: middle;
  }
  .fs-cell.fs-boundary {
    border-left: 1px dashed color-mix(in srgb, hsl(var(--foreground)) 40%, transparent);
  }
  .fs-swatch {
    display: block;
    height: 16px;
    border-radius: var(--radius-sm);
  }
  .fs-verbatim .fs-swatch {
    background: var(--alc-new);
  }
  .fs-maybe .fs-swatch {
    background: var(--alc-resent);
  }
  .fs-unknown .fs-swatch {
    background: transparent;
    border: 1px dashed color-mix(in srgb, hsl(var(--muted-foreground)) 55%, transparent);
  }

  @media (max-width: 480px) {
    .fs-stat-value {
      font-size: var(--text-subtitle);
      line-height: var(--text-subtitle--line-height);
    }
    .fs-table {
      font-size: var(--text-micro);
      line-height: var(--text-micro--line-height);
    }
    .fs-fact {
      padding-right: 4px;
    }
    .fs-swatch {
      height: 12px;
    }
  }
</style>
