---
// "Which change at request 20 costs the least, and which costs the most?" Toggle over one change
// made at request 20 of the 30-request loop with a 5-minute cache. The hierarchy is tools → system
// → messages: a change invalidates its own level and every level after it. tool_choice invalidates
// message blocks only, same as the docs' rule for images.
import { simulate, CACHE, MODELS, SOURCES, FACTS_AS_OF } from "@/lib/sim/agent-loop";
import { BASE_WORKLOAD } from "./workloads";
import { fmtTokens, fmtUsd } from "./format";
import Figure from "./kit/Figure.astro";
import Panel from "./kit/Panel.astro";
import Stat from "./kit/Stat.astro";
import Plot from "./kit/Plot.astro";
import Legend from "./kit/Legend.astro";
import Source from "./kit/Source.astro";
import DataTable from "./kit/DataTable.astro";
import { plotFrame } from "./kit/plot";
import { TONE_FILL } from "./kit/tones";

type StateKey = "message" | "tool_choice" | "system" | "tools";

const cached = simulate({ ...BASE_WORKLOAD, turns: 20, cache: "5m" });
const req20 = cached.requests[19];

const sonnet = MODELS["sonnet-5"];
const perIn = sonnet.inputPerMTok / 1_000_000;
const perOut = sonnet.outputPerMTok / 1_000_000;
const writeMult = CACHE.write5mMultiplier;
const readMult = CACHE.readMultiplier;

const toolsTok = BASE_WORKLOAD.toolsTokens;
const systemTok = BASE_WORKLOAD.systemTokens;
const messagesTok = req20.contextTokens - toolsTok - systemTok;
const outputTok = BASE_WORKLOAD.assistantTokens;
const totalTok = toolsTok + systemTok + messagesTok;

type Mode = "read" | "write";
interface Segment {
  label: string;
  tokens: number;
  mode: Mode;
  /** Only set when the segment is split (the "message" case: mostly read, a small new write). */
  writeTokens?: number;
}

interface Slice {
  label: string;
  tokens: number;
  read: number;
  write: number;
}

const slicesOf = (segments: Segment[]): Slice[] =>
  segments.map((s) => {
    const write = s.writeTokens ?? (s.mode === "write" ? s.tokens : 0);
    return { label: s.label, tokens: s.tokens, read: s.tokens - write, write };
  });

const costOf = (slices: Slice[]) =>
  slices.reduce((usd, s) => usd + (s.read * readMult + s.write * writeMult) * perIn, outputTok * perOut);

// The "message" case is the engine's own ground truth for request 20: most of the history reads
// from the cache entry the previous request wrote; only the newest tail is written.
const messageSegments: Segment[] = [
  { label: "tools", tokens: toolsTok, mode: "read" },
  { label: "system", tokens: systemTok, mode: "read" },
  { label: "messages", tokens: messagesTok, mode: "read", writeTokens: req20.cacheWriteTokens },
];

const STATE_SEGMENTS: Record<StateKey, Segment[]> = {
  message: messageSegments,
  tool_choice: [
    { label: "tools", tokens: toolsTok, mode: "read" },
    { label: "system", tokens: systemTok, mode: "read" },
    { label: "messages", tokens: messagesTok, mode: "write" },
  ],
  system: [
    { label: "tools", tokens: toolsTok, mode: "read" },
    { label: "system", tokens: systemTok, mode: "write" },
    { label: "messages", tokens: messagesTok, mode: "write" },
  ],
  tools: [
    { label: "tools", tokens: toolsTok, mode: "write" },
    { label: "system", tokens: systemTok, mode: "write" },
    { label: "messages", tokens: messagesTok, mode: "write" },
  ],
};

const normalCost = costOf(slicesOf(messageSegments));

const STATES = ["message", "tool_choice", "system", "tools"] as const;
const INITIAL: StateKey = "message";

function panelData(key: StateKey) {
  const slices = slicesOf(STATE_SEGMENTS[key]);
  const cost = costOf(slices);
  return { slices, cost, multiple: cost / normalCost };
}

const PANELS: Record<StateKey, ReturnType<typeof panelData>> = {
  message: panelData("message"),
  tool_choice: panelData("tool_choice"),
  system: panelData("system"),
  tools: panelData("tools"),
};

const OPTIONS = [
  { value: "message", label: "append a tool result" },
  { value: "tool_choice", label: "change tool_choice" },
  { value: "system", label: "edit the system prompt" },
  { value: "tools", label: "edit a tool definition" },
];

const SUB: Record<StateKey, string> = {
  message: "The normal case. Tools and system read from cache; only the newest tail is written.",
  tool_choice: "tool_choice only affects message blocks. Tools and system stay cached; every message block is rewritten.",
  system: "Editing the system prompt invalidates system and everything after it. Only tools stays cached.",
  tools: "Editing a tool definition invalidates the entire prefix. Nothing is read from cache.",
};

// One bar, the whole request. The x domain is the request's tokens, so a block's width is its share.
const frame = plotFrame({ w: 480, h: 110, inset: { l: 6, r: 74, t: 54, b: 26 }, x: [0, totalTok] });

function layout(slices: Slice[]) {
  let cursor = 0;
  return slices.map((s) => {
    const rect = { ...s, x: frame.x(cursor), readW: frame.spanX(s.read), writeW: frame.spanX(s.write), w: frame.spanX(s.tokens) };
    cursor += s.tokens;
    return rect;
  });
}

const labelOf = (key: StateKey) => OPTIONS.find((o) => o.value === key)!.label;
const ariaLabel = (key: StateKey) =>
  `Request 20 with a 5-minute cache, ${labelOf(key)}. Tools ${fmtTokens(toolsTok)}, system ${fmtTokens(systemTok)}, messages ${fmtTokens(messagesTok)}. Cost ${fmtUsd(PANELS[key].cost)}, ${PANELS[key].multiple.toFixed(1)}× the normal request cost of ${fmtUsd(normalCost)}.`;
---

<Figure
  question="Which change at request 20 costs the least, and which the most?"
  basis="calculated"
  options={OPTIONS}
  initial={INITIAL}
>
  {
    STATES.map((key) => {
      const p = PANELS[key];
      const rects = layout(p.slices);
      return (
        <Panel value={key} initial={INITIAL}>
          <Stat value={fmtUsd(p.cost)} delta={`${p.multiple.toFixed(1)}× the normal request`} tone={p.multiple < 1.01 ? "gain" : "loss"}>
            {SUB[key]}
          </Stat>
          <Plot frame={frame} label={ariaLabel(key)}>
            {rects.map((r) => (
              <>
                <rect x={r.x} y={frame.top} width={r.readW} height={frame.height} class={TONE_FILL.read} />
                <rect x={r.x + r.readW} y={frame.top} width={r.writeW} height={frame.height} class={TONE_FILL.write} />
                <rect x={r.x} y={frame.top} width={r.w} height={frame.height} fill="none" stroke="hsl(var(--border))" stroke-width="1" />
              </>
            ))}
            <text x={frame.left} y={frame.top - 8} class="alc-text">tools {fmtTokens(toolsTok)}, system {fmtTokens(systemTok)} ·</text>
            <text x={rects[2].x + rects[2].w / 2} y={frame.top - 8} class="alc-text" text-anchor="middle">messages {fmtTokens(messagesTok)}</text>
            <line x1={frame.left + 20} y1={frame.top - 4} x2={frame.left + 20} y2={frame.top} class="alc-marker" />
            <text x={frame.left} y={frame.bottom + 20} class="alc-text">request 20, {fmtTokens(totalTok)} total</text>
          </Plot>
          <Legend
            items={[
              { tone: "read", label: "read from cache (0.1×)" },
              { tone: "write", label: "written to cache (1.25×)" },
            ]}
          />
        </Panel>
      );
    })
  }

  <Fragment slot="a11y">
    {
      STATES.map((key) => (
        <DataTable
          caption={`Request 20, ${labelOf(key)}: ${fmtUsd(PANELS[key].cost)}, ${PANELS[key].multiple.toFixed(1)}× the normal request.`}
          columns={["block", "tokens", "read from cache", "written to cache"]}
          rows={PANELS[key].slices.map((s) => [s.label, fmtTokens(s.tokens), fmtTokens(s.read), fmtTokens(s.write)])}
        />
      ))
    }
  </Fragment>

  <Source slot="caption" links={[{ href: SOURCES.caching, label: "prompt caching" }]} asOf={FACTS_AS_OF}>
    Cache hierarchy: <code>tools</code> → <code>system</code> → <code>messages</code>. A change
    invalidates its level and every later level; <code>tool_choice</code> and images invalidate
    message blocks only. Claude Sonnet 5 prices from the engine's request-20 context.
  </Source>
</Figure>
