---
// "Why does a 20-block lookback miss a cache entry that's still alive?" Static, two rows on the
// same 35-block growth. Row 1: sequential tool calls, one block each — the docs' own example, and
// it misses by exactly one position. Row 2: the same growth as parallel tool calls, where a run of
// consecutive tool_use (or tool_result) blocks counts as one position, so the entry stays in reach.
import { SOURCES, FACTS_AS_OF } from "@/lib/sim/agent-loop";
import { getLangFromUrl } from "../../../i18n/utils";
import { getAgentLoopUi } from "./i18n";
import Figure from "./kit/Figure.astro";
import Source from "./kit/Source.astro";
import DataTable from "./kit/DataTable.astro";

const allUi = getAgentLoopUi(getLangFromUrl(Astro.url));
const ui = allUi.lookbackWindow;

const TOTAL_BLOCKS = 35;
const ENTRY_BLOCK = 15; // cache entry written here (1-based)
const LOOKBACK = 20; // positions checked, breakpoint counts as the first

// Row 1: sequential — every block is its own position. The window covers positions 35→16.
const windowStartBlock = TOTAL_BLOCKS - LOOKBACK + 1; // 16

// Row 2: parallel — blocks 16-35 (20 raw blocks) come from 2 turns of 5 parallel tool calls each:
const row2Groups = [
  { fromBlock: 31, toBlock: 35, position: 1, kind: "tool_result run" },
  { fromBlock: 26, toBlock: 30, position: 2, kind: "tool_use run" },
  { fromBlock: 21, toBlock: 25, position: 3, kind: "tool_result run" },
  { fromBlock: 16, toBlock: 20, position: 4, kind: "tool_use run" },
];

const inGroup = (block: number, from: number, to: number) => block >= from && to >= block;

const ariaLabel = ui.aria;
---

<Figure question={ui.question} basis="calculated">
  <p class="alc-sub">
    {ui.introBeforeCode}<code>tool_use</code>{ui.introBetweenCode}<code>tool_result</code>{ui.introAfterCode}
  </p>

  <div class="lw" role="img" aria-label={ariaLabel}>
    <div class="lw-row">
      <p class="lw-row-title" aria-hidden="true">{ui.sequentialTitle}</p>
      <div class="lw-grid" aria-hidden="true" style={`--lw-cols: ${TOTAL_BLOCKS}`}>
        <span class="lw-bracket" style={`grid-column: ${windowStartBlock} / ${TOTAL_BLOCKS + 1}`}>
          <span class="lw-bracket-label">{ui.windowLabel(windowStartBlock, TOTAL_BLOCKS)}</span>
        </span>
        {
          Array.from({ length: TOTAL_BLOCKS }, (_, i) => {
            const block = i + 1;
            const inWindow = block >= windowStartBlock;
            const isEntry = block === ENTRY_BLOCK;
            const cls = isEntry ? "lw-fill-bad" : inWindow ? "lw-fill-read" : "lw-fill-uncached";
            return <span class={`lw-cell ${cls}`} style={isEntry || inWindow ? "" : "opacity: 0.35"} />;
        })
        }
        <span class="lw-callout" style={`grid-column: ${ENTRY_BLOCK} / ${ENTRY_BLOCK + 1}`}>
          <span class="lw-callout-text">{ui.missCallout.block}<br />{ui.missCallout.detail}</span>
        </span>
      </div>
    </div>

    <div class="lw-row">
      <p class="lw-row-title" aria-hidden="true">{ui.parallelTitle}</p>
      <div class="lw-grid" aria-hidden="true" style={`--lw-cols: ${TOTAL_BLOCKS}`}>
        {
          row2Groups.map((g) => (
            <span class="lw-bracket" style={`grid-column: ${g.fromBlock} / ${g.toBlock + 1}`}>
              <span class="lw-bracket-label">{ui.positionLabel(g.position)}</span>
            </span>
          ))
        }
        {
          Array.from({ length: TOTAL_BLOCKS }, (_, i) => {
            const block = i + 1;
            const isEntry = block === ENTRY_BLOCK;
            const group = row2Groups.find((g) => inGroup(block, g.fromBlock, g.toBlock));
            const cls = isEntry ? "lw-fill-good" : group ? (group.position % 2 === 0 ? "lw-fill-read" : "lw-fill-write") : "lw-fill-uncached";
            return <span class={`lw-cell ${cls}`} style={isEntry || group ? "" : "opacity: 0.35"} />;
        })
        }
        <span class="lw-callout" style={`grid-column: ${ENTRY_BLOCK} / ${ENTRY_BLOCK + 1}`}>
          <span class="lw-callout-text">{ui.hitCallout.block}<br />{ui.hitCallout.detail}</span>
        </span>
      </div>
    </div>
  </div>

  <ul class="alc-legend" aria-hidden="true">
    <li><span class="alc-swatch lw-fill-bad" />{ui.legend.outside}</li>
    <li><span class="alc-swatch lw-fill-good" />{ui.legend.inside}</li>
    <li><span class="alc-swatch lw-fill-read" />{ui.legend.window}</li>
    <li><span class="alc-swatch lw-fill-write" />{ui.legend.parallel}</li>
  </ul>

  <DataTable
    slot="a11y"
    caption={ui.caption}
    columns={ui.columns}
    rows={[
      [ui.rows.sequential, ui.rows.sequentialResult],
      [ui.rows.parallel, ui.rows.parallelResult],
    ]}
  />

  <Source slot="caption" links={[{ href: SOURCES.caching, label: allUi.sourceLinks.caching }]} asOf={FACTS_AS_OF}>
    {ui.source}
  </Source>
</Figure>

<style>
  .lw {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .lw-row-title {
    margin: 0 0 8px;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    font-weight: 700;
    color: hsl(var(--foreground));
  }

  .lw-grid {
    display: grid;
    grid-template-columns: repeat(var(--lw-cols), 1fr);
    grid-template-rows: 22px 16px 48px;
    column-gap: 2px;
  }

  .lw-cell {
    grid-row: 2;
    border-radius: 1px;
  }
  .lw-fill-bad {
    background: var(--alc-bad);
  }
  .lw-fill-good {
    background: var(--alc-good);
  }
  .lw-fill-read {
    background: var(--alc-read);
  }
  .lw-fill-write {
    background: var(--alc-write);
  }
  .lw-fill-uncached {
    background: var(--alc-uncached);
  }

  .lw-bracket {
    grid-row: 1;
    position: relative;
  }
  .lw-bracket::after {
    content: "";
    position: absolute;
    left: 1px;
    right: 1px;
    bottom: 0;
    border-top: 1px dashed hsl(var(--foreground));
  }
  .lw-bracket-label {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: 1;
    color: hsl(var(--muted-foreground));
  }

  .lw-callout {
    grid-row: 3;
    position: relative;
  }
  .lw-callout::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    width: 0;
    height: 10px;
    border-left: 1px dashed hsl(var(--foreground));
  }
  .lw-callout-text {
    position: absolute;
    top: 14px;
    left: 50%;
    width: max-content;
    transform: translateX(-50%);
    text-align: center;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    font-weight: 700;
    color: hsl(var(--foreground));
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .lw {
      gap: 26px;
    }
    .lw-grid {
      column-gap: 1px;
      grid-template-rows: 30px 12px 42px;
    }
    .lw-bracket-label,
    .lw-callout-text {
      font-size: var(--text-micro);
      line-height: var(--text-micro--line-height);
    }
  }
</style>
