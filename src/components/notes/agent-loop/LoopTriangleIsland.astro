---
import Figure from "./kit/Figure.astro";
import Source from "./kit/Source.astro";
import DataTable from "./kit/DataTable.astro";
import LoopTriangle from "./LoopTriangle.tsx";
import { BASE_WORKLOAD } from "./workloads";
import { fmtTokens } from "./format";

const w = BASE_WORKLOAD;
---

<Figure question="Why does twice the loop send about four times the tokens?" basis="calculated">
  <LoopTriangle client:visible />
  <DataTable
    slot="a11y"
    caption="Quadratic growth: each request resends the full history."
    columns={["component", "tokens per request"]}
    rows={[
      ["tools", fmtTokens(w.toolsTokens)],
      ["system", fmtTokens(w.systemTokens)],
      ["task", fmtTokens(w.taskTokens)],
      ["assistant output", fmtTokens(w.assistantTokens)],
      ["tool result", fmtTokens(w.toolResultTokens)],
    ]}
  />
  <Source slot="caption">
    {fmtTokens(w.toolsTokens)} of tools, a {fmtTokens(w.systemTokens)} system prompt, a {fmtTokens(w.taskTokens)} task, then
    {fmtTokens(w.assistantTokens)} output and a {fmtTokens(w.toolResultTokens)} tool result per request. Every request sends the whole
    history, because the Messages API keeps no state between requests.
  </Source>
</Figure>
