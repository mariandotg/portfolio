---
import AlcFigure from "./AlcFigure.astro";
import LoopTriangle from "./LoopTriangle.tsx";
import { FACTS_AS_OF, MODELS, SOURCES } from "@/lib/sim/agent-loop";
import { BASE_WORKLOAD } from "./workloads";
import { fmtTokens } from "./format";

const w = BASE_WORKLOAD;
const m = MODELS[w.model];
---

<AlcFigure question="Why does twice the loop cost about four times as much?">
  <LoopTriangle client:visible />
  <Fragment slot="caption">
    No cache. {fmtTokens(w.toolsTokens)} of tools, a {fmtTokens(w.systemTokens)} system prompt, a {fmtTokens(w.taskTokens)} task,
    then {fmtTokens(w.assistantTokens)} output and a {fmtTokens(w.toolResultTokens)} tool result per request. {m.name} at ${m.inputPerMTok} /
    ${m.outputPerMTok} per million input / output tokens, as of {FACTS_AS_OF} (<a href={SOURCES.pricing}>pricing</a>).
  </Fragment>
</AlcFigure>
