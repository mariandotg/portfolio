---
import Figure from "./kit/Figure.astro";
import Source from "./kit/Source.astro";
import DataTable from "./kit/DataTable.astro";
import LoopTriangle from "./LoopTriangle.tsx";
import { BASE_WORKLOAD } from "./workloads";
import { fmtTokens } from "./format";
import { getLangFromUrl } from "../../../i18n/utils";

const w = BASE_WORKLOAD;
const lang = getLangFromUrl(Astro.url);
const isSpanish = lang === "es";
---

<Figure question={isSpanish ? "¿Por qué duplicar el bucle envía aproximadamente cuatro veces más tokens?" : "Why does twice the loop send about four times the tokens?"} basis="calculated">
  <LoopTriangle client:visible lang={lang} />
  <DataTable
    slot="a11y"
    caption={isSpanish ? "Crecimiento cuadrático: cada solicitud vuelve a enviar el historial completo." : "Quadratic growth: each request resends the full history."}
    columns={isSpanish ? ["componente", "tokens por solicitud"] : ["component", "tokens per request"]}
    rows={[
      [isSpanish ? "herramientas" : "tools", fmtTokens(w.toolsTokens)],
      [isSpanish ? "sistema" : "system", fmtTokens(w.systemTokens)],
      [isSpanish ? "tarea" : "task", fmtTokens(w.taskTokens)],
      [isSpanish ? "salida del asistente" : "assistant output", fmtTokens(w.assistantTokens)],
      [isSpanish ? "resultado de herramienta" : "tool result", fmtTokens(w.toolResultTokens)],
    ]}
  />
  <Source slot="caption">
    {isSpanish
      ? `${fmtTokens(w.toolsTokens)} de herramientas, un prompt del sistema de ${fmtTokens(w.systemTokens)}, una tarea de ${fmtTokens(w.taskTokens)}, luego ${fmtTokens(w.assistantTokens)} tokens de salida y un resultado de herramienta de ${fmtTokens(w.toolResultTokens)} por solicitud. Cada solicitud envía todo el historial porque la API de Messages no conserva estado entre solicitudes.`
      : `${fmtTokens(w.toolsTokens)} of tools, a ${fmtTokens(w.systemTokens)} system prompt, a ${fmtTokens(w.taskTokens)} task, then ${fmtTokens(w.assistantTokens)} output and a ${fmtTokens(w.toolResultTokens)} tool result per request. Every request sends the whole history, because the Messages API keeps no state between requests.`}
  </Source>
</Figure>

<style is:global>
  /* LoopTriangle: 120 fixed slots so a shorter loop only fills part of the width, growing
     toward the ghost outline as the slider approaches the max. */
  .lt-toplabel {
    margin: 0 0 4px;
    text-align: right;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: hsl(var(--muted-foreground));
  }

  .lt-chart {
    --lt-h: 200px;
    position: relative;
    height: var(--lt-h);
    border: 1px solid hsl(var(--border));
    border-radius: var(--radius-sm);
    background: hsl(var(--background));
  }

  /* The full 120-request growth outline: a thin filled ribbon, not a scaled SVG stroke. */
  .lt-ghost {
    position: absolute;
    inset: 0;
    background: hsl(var(--muted-foreground));
    opacity: 0.6;
    pointer-events: none;
  }

  .lt-bars {
    position: absolute;
    inset: 0;
    display: grid;
    align-items: stretch;
    column-gap: 1px;
  }
  .lt-col {
    display: flex;
    flex-direction: column-reverse;
    min-width: 0;
    height: 100%;
  }
  .lt-seg {
    width: 100%;
    flex: 0 0 auto;
  }
  .lt-seg-resent {
    background: var(--alc-resent);
  }
  .lt-seg-new {
    background: var(--alc-new);
  }

  .lt-last-label {
    position: absolute;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    font-weight: 700;
    color: hsl(var(--foreground));
    white-space: nowrap;
    pointer-events: none;
  }

  .lt-axis {
    display: flex;
    justify-content: space-between;
    margin: 4px 0 0;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: hsl(var(--muted-foreground));
  }

  @media (max-width: 480px) {
    .lt-chart {
      --lt-h: 150px;
    }
  }
</style>
