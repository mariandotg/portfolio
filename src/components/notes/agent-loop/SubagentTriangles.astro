---
// Static diagram: each request's bar height is the context it sends, so one loop draws a
// triangle and the triangle's area is the input you pay. Splitting the tool work into four
// short loops draws four small triangles whose combined area is far smaller. HTML bars (not a
// scaled SVG) so the labels stay readable on phones; both rows share one height scale.
import Figure from "./kit/Figure.astro";
import Stat from "./kit/Stat.astro";
import Source from "./kit/Source.astro";
import DataTable from "./kit/DataTable.astro";
import { simulateMultiAgent, SOURCES, FACTS_AS_OF } from "@/lib/sim/agent-loop";
import { SUBAGENT_WORKLOAD, SUBAGENTS } from "./workloads";
import { fmtTokens, fmtChange, fmtSeconds } from "./format";
import { getLangFromUrl } from "../../../i18n/utils";

const r = simulateMultiAgent(SUBAGENT_WORKLOAD, {
  count: SUBAGENTS.count,
  parallel: SUBAGENTS.parallel,
  subagent: { ...SUBAGENT_WORKLOAD, turns: SUBAGENTS.turnsEach },
  resultTokens: SUBAGENTS.resultTokens,
});

// One shared scale for both rows: bar height is % of the single agent's peak (plus headroom).
const singlePeak = r.single.totals.peakContextTokens;
const yDomainMax = singlePeak * 1.08;
const pct = (v: number) => (v / yDomainMax) * 100;

const teamTokens = r.totals.inputTokens;
const singleTokens = r.single.totals.inputTokens;
const toolCalls = SUBAGENTS.count * (SUBAGENTS.turnsEach - 1);
const toolResultsTotal = toolCalls * SUBAGENT_WORKLOAD.toolResultTokens;
const summariesTotal = SUBAGENTS.count * SUBAGENTS.resultTokens;

const isSpanish = getLangFromUrl(Astro.url) === "es";
const ariaLabel = isSpanish
  ? `Las alturas de las barras son el contexto que envía cada solicitud. Un agente que hace 56 llamadas de herramienta en un solo bucle alcanza ${fmtTokens(singlePeak)} tokens y envía ${fmtTokens(singleTokens)} tokens de entrada en total. Cuatro subagentes que hacen el mismo trabajo en paralelo alcanzan ${fmtTokens(r.subagents[0].totals.peakContextTokens)} cada uno; el coordinador alcanza ${fmtTokens(r.coordinator.totals.peakContextTokens)}, y el equipo envía ${fmtTokens(teamTokens)}, ${fmtChange(teamTokens, singleTokens)}.`
  : `Bar heights are the context each request sends. One agent making 56 tool calls in a single loop peaks at ${fmtTokens(singlePeak)} tokens and sends ${fmtTokens(singleTokens)} input tokens in total. Four subagents doing the same tool work in parallel peak at ${fmtTokens(r.subagents[0].totals.peakContextTokens)} each, the coordinator peaks at ${fmtTokens(r.coordinator.totals.peakContextTokens)}, and the team sends ${fmtTokens(teamTokens)}, ${fmtChange(teamTokens, singleTokens)}.`;
---

<Figure question={isSpanish ? "¿Por qué cuatro bucles cortos envían menos tokens que uno largo?" : "Why do four short loops send fewer tokens than one long one?"} basis="calculated">
  <Stat value={fmtTokens(teamTokens)} unit={isSpanish ? "tokens de entrada" : "input tokens"} delta={fmtChange(teamTokens, singleTokens)} tone="gain">
    {isSpanish ? (
      <>
        El trabajo de herramientas es el mismo. En paralelo, el equipo termina en <strong>{fmtSeconds(r.totals.durationSeconds)}</strong>{" "}
        en lugar de <strong>{fmtSeconds(r.single.totals.durationSeconds)}</strong>. El coordinador lee{" "}
        <strong>{fmtTokens(summariesTotal)}</strong> tokens de resúmenes, no <strong>{fmtTokens(toolResultsTotal)}</strong> tokens de
        resultados de herramientas.
      </>
    ) : (
      <>
        Same tool work. Dispatched in parallel, the team finishes in <strong>{fmtSeconds(r.totals.durationSeconds)}</strong>{" "}
        instead of <strong>{fmtSeconds(r.single.totals.durationSeconds)}</strong>. The coordinator reads{" "}
        <strong>{fmtTokens(summariesTotal)}</strong> of summaries, not <strong>{fmtTokens(toolResultsTotal)}</strong> of
        tool results.
      </>
    )}
  </Stat>

  <div class="st" role="img" aria-label={ariaLabel}>
    <div class="st-row">
      <div class="st-row-head">
        <span class="st-row-label">{isSpanish ? "Un agente" : "One agent"} · {toolCalls} {isSpanish ? "llamadas de herramienta" : "tool calls"}</span>
        <span class="st-row-total">{fmtTokens(singleTokens)} {isSpanish ? "tokens de entrada" : "input tokens"}</span>
      </div>
      <div class="st-chart">
        {
          r.single.requests.map((req) => (
            <span class="st-bar st-bar-resent" style={`height: ${pct(req.contextTokens).toFixed(2)}%`} />
          ))
        }
      </div>
    </div>

    <div class="st-row">
      <div class="st-row-head">
        <span class="st-row-label">{isSpanish ? "Coordinador" : "Coordinator"} + {SUBAGENTS.count} {isSpanish ? "subagentes" : "subagents"}</span>
        <span class="st-row-total">{fmtTokens(teamTokens)} {isSpanish ? "tokens de entrada" : "input tokens"}</span>
      </div>
      <div class="st-chart st-chart-grouped">
        <div class="st-group" style={`flex-grow: ${r.coordinator.requests.length}`}>
          {
            r.coordinator.requests.map((req) => (
              <span class="st-bar st-bar-read" style={`height: ${pct(req.contextTokens).toFixed(2)}%`} />
            ))
          }
        </div>
        {
          r.subagents.map((s, i) => (
            <div class="st-group" data-subagent={i} style={`flex-grow: ${s.requests.length}`}>
              {s.requests.map((req) => (
                <span class="st-bar st-bar-new" style={`height: ${pct(req.contextTokens).toFixed(2)}%`} />
              ))}
            </div>
          ))
        }
      </div>
      <div class="st-chart-labels">
        <span class="st-group-label" style={`flex-grow: ${r.coordinator.requests.length}`}>
          {isSpanish ? "coordinador" : "coordinator"}
        </span>
        {r.subagents.map((s) => <span aria-hidden="true" style={`flex-grow: ${s.requests.length}`} />)}
      </div>
    </div>
  </div>

  <DataTable
    slot="a11y"
    caption={isSpanish ? "Un agente frente a coordinador y subagentes, con el mismo trabajo de herramientas." : "Single agent vs coordinator + subagents, same tool work."}
    columns={isSpanish ? ["estructura", "tokens de entrada", "contexto máximo"] : ["layout", "input tokens", "peak context"]}
    rows={[
      [isSpanish ? "un agente" : "one agent", fmtTokens(singleTokens), fmtTokens(singlePeak)],
      [isSpanish ? "equipo" : "team", fmtTokens(teamTokens), fmtTokens(r.coordinator.totals.peakContextTokens)],
    ]}
  />

  <Source slot="caption" links={[{ href: SOURCES.multiAgent, label: isSpanish ? "sistema de investigación multiagente" : "multi-agent research system" }]} asOf={FACTS_AS_OF}>
    {isSpanish
      ? "Anthropic informa que su sistema Research multiagente usa cerca de 15× los tokens de un chat porque sus subagentes buscan mucho más (citado, no simulado). Supuesto: cada subagente tiene las mismas herramientas y el mismo prompt del sistema que el coordinador."
      : "Anthropic reports that its multi-agent Research system uses about 15× the tokens of a chat, because its subagents search far more (cited, not simulated). Assumption: each subagent has the same tools and system prompt as the coordinator."}
  </Source>
</Figure>

<style>
  .st {
    --st-h: 150px;
    --st-gap: 10px;
  }
  .st-row + .st-row {
    margin-top: 22px;
  }
  .st-row-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 6px;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
  }
  .st-row-label {
    font-weight: 700;
    color: hsl(var(--foreground));
  }
  .st-row-total {
    color: hsl(var(--muted-foreground));
    white-space: nowrap;
  }

  .st-chart {
    display: flex;
    align-items: flex-end;
    gap: 1px;
    height: var(--st-h);
    border-bottom: 1px solid hsl(var(--border));
  }
  .st-bar {
    flex: 1 1 0;
    min-width: 0;
    border-radius: 1px 1px 0 0;
  }
  .st-bar-resent {
    background: var(--alc-resent);
  }
  .st-bar-read {
    background: var(--alc-read);
  }
  .st-bar-new {
    background: var(--alc-new);
  }

  .st-chart-grouped {
    gap: 0;
  }
  .st-group {
    display: flex;
    align-items: flex-end;
    gap: 1px;
    height: 100%;
  }
  .st-group + .st-group {
    margin-left: var(--st-gap);
  }

  .st-chart-labels {
    display: flex;
    margin-top: 4px;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: hsl(var(--muted-foreground));
  }
  .st-group-label {
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .st {
      --st-h: 110px;
    }
    .st-row-total {
      font-size: var(--text-micro);
      line-height: var(--text-micro--line-height);
    }
  }
</style>
