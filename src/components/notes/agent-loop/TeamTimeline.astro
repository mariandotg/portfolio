---
// Diagram version: both dispatch modes on one shared wall-clock axis instead of a toggle. Same
// coordinator + 4 subagents as the triangles above. Parallel stacks the 4 subagent runs on top of
// each other in time; sequential lines them up one after another. The "one agent" duration is a
// dashed reference marker repeated on every track.
import Figure from "./kit/Figure.astro";
import Stat from "./kit/Stat.astro";
import Legend from "./kit/Legend.astro";
import Source from "./kit/Source.astro";
import { simulateMultiAgent } from "@/lib/sim/agent-loop";
import { SUBAGENT_WORKLOAD, SUBAGENTS } from "./workloads";
import { fmtSeconds, fmtChange } from "./format";

type Key = "parallel" | "sequential";

function run(parallel: boolean) {
  return simulateMultiAgent(SUBAGENT_WORKLOAD, {
    count: SUBAGENTS.count,
    parallel,
    subagent: { ...SUBAGENT_WORKLOAD, turns: SUBAGENTS.turnsEach },
    resultTokens: SUBAGENTS.resultTokens,
  });
}

const runs: Record<Key, ReturnType<typeof run>> = { parallel: run(true), sequential: run(false) };
const reqDur = SUBAGENT_WORKLOAD.secondsBetweenRequests;
const subDur = runs.parallel.subagents[0].totals.durationSeconds;
const count = SUBAGENTS.count;
const singleDuration = runs.parallel.single.totals.durationSeconds;

function schedule(key: Key) {
  const coordinator: [number, number][] = [];
  const subagents: [number, number][] = [];
  let cursor = 0;
  if (key === "parallel") {
    coordinator.push([cursor, cursor + reqDur]);
    cursor += reqDur;
    for (let i = 0; i < count; i++) subagents.push([cursor, cursor + subDur]);
    cursor += subDur;
    coordinator.push([cursor, cursor + reqDur]);
    cursor += reqDur;
  } else {
    for (let i = 0; i < count; i++) {
      coordinator.push([cursor, cursor + reqDur]);
      cursor += reqDur;
      subagents.push([cursor, cursor + subDur]);
      cursor += subDur;
    }
    coordinator.push([cursor, cursor + reqDur]);
    cursor += reqDur;
  }
  return { coordinator, subagents, total: cursor };
}

const SCHEDULES: Record<Key, ReturnType<typeof schedule>> = { parallel: schedule("parallel"), sequential: schedule("sequential") };

if (
  SCHEDULES.parallel.total !== runs.parallel.totals.durationSeconds ||
  SCHEDULES.sequential.total !== runs.sequential.totals.durationSeconds
) {
  throw new Error("TeamTimeline: schedule total doesn't match the engine's own duration");
}

const scaleMax = Math.max(SCHEDULES.sequential.total, singleDuration) * 1.04;
const pct = (seconds: number) => `${((seconds / scaleMax) * 100).toFixed(2)}%`;
const spanPct = (a: number, b: number) => `${Math.max(((b - a) / scaleMax) * 100, 0.6).toFixed(2)}%`;

function panel(key: Key) {
  const s = SCHEDULES[key];
  const r = runs[key];
  const team = r.totals.durationSeconds;
  const deltaTone = team <= singleDuration ? "gain" : "loss";
  return { key, s, team, change: fmtChange(team, singleDuration), deltaTone };
}
const PANELS: Record<Key, ReturnType<typeof panel>> = { parallel: panel("parallel"), sequential: panel("sequential") };

const GROUPS = (["parallel", "sequential"] as Key[]).map((key) => {
  const p = PANELS[key];
  const stacked = key === "parallel";
  return {
    key,
    label: key === "parallel" ? "Parallel" : "Sequential",
    stacked,
    team: p.team,
    change: p.change,
    deltaTone: p.deltaTone,
    coordinator: p.s.coordinator.map(([a, b]) => ({ left: pct(a), width: spanPct(a, b) })),
    subagents: p.s.subagents.map(([a, b], i) => ({
      left: pct(a),
      width: spanPct(a, b),
      top: stacked ? `${((i * 100) / count).toFixed(2)}%` : "0%",
      height: stacked ? `${(100 / count).toFixed(2)}%` : "100%",
    })),
    sentence: `Dispatched in ${key === "parallel" ? "parallel" : "sequence"}, the coordinator and its ${count} subagents finish in ${fmtSeconds(p.team)}, ${p.change} versus ${fmtSeconds(singleDuration)} for one agent doing the same tool work alone.`,
  };
});
---

<Figure question="Does splitting the work also make it faster?" basis="assumed">
  <Stat value={fmtSeconds(PANELS.parallel.team)} delta={`${PANELS.parallel.change} vs one agent`} tone={PANELS.parallel.deltaTone}>
    Dispatched in parallel. The same team dispatched in sequence takes {fmtSeconds(PANELS.sequential.team)}, {PANELS.sequential.change} vs one agent.
  </Stat>

  <div class="tt">
    <div class="tt-axis" aria-hidden="true">
      <span class="tt-tick" style={`left: ${pct(0)}`}>0s</span>
      <span class="tt-tick tt-tick-ref" style={`left: ${pct(singleDuration)}`}>{fmtSeconds(singleDuration)} · one agent</span>
    </div>

    <ol class="tt-groups">
      {
        GROUPS.map((g) => (
          <li class="tt-group">
            <p class="tt-group-summary">
              <span class="tt-group-name">{g.label}</span>
              <span class:list={["tt-group-time", { accent: g.key === "parallel" }]}>{fmtSeconds(g.team)}</span>
              <span class:list={["tt-group-delta", g.deltaTone]}>{g.change} vs one agent</span>
            </p>
            <ol class="tt-lanes" aria-hidden="true">
              <li class="tt-lane">
                <span class="tt-lane-label">Coordinator</span>
                <span class="tt-track">
                  <span class="tt-ref-marker" style={`left: ${pct(singleDuration)}`} />
                  {g.coordinator.map((seg) => (
                    <span class="tt-seg tt-seg-coordinator" style={`left: ${seg.left}; width: ${seg.width}`} />
                  ))}
                </span>
              </li>
              <li class="tt-lane">
                <span class="tt-lane-label">Subagents ×{count}</span>
                <span class="tt-track">
                  <span class="tt-ref-marker" style={`left: ${pct(singleDuration)}`} />
                  {g.subagents.map((seg) => (
                    <span
                      class:list={["tt-seg", "tt-seg-subagent", { "tt-seg-stacked": g.stacked }]}
                      style={`left: ${seg.left}; width: ${seg.width}; top: ${seg.top}; height: ${seg.height}`}
                    />
                  ))}
                </span>
              </li>
            </ol>
            <span class="sr-only">{g.sentence}</span>
          </li>
        ))
      }
    </ol>
  </div>

  <Legend items={[{ tone: "read", label: "coordinator request" }, { tone: "new", label: "subagent run" }]} />

  <Source slot="caption">
    Same coordinator and {SUBAGENTS.count} subagents as above. Assumption: every coordinator request takes{" "}
    {reqDur} seconds and subagents run back-to-back with no gap between dispatches. Shared scale in both groups, up
    to the sequential total, {fmtSeconds(SCHEDULES.sequential.total)}.
  </Source>
</Figure>

<style>
  .tt {
    --label-w: 6.5rem;
    margin-top: 14px;
    font-size: var(--text-ui);
    line-height: var(--text-ui--line-height);
  }

  .tt-axis {
    position: relative;
    height: 16px;
    margin: 0 0 6px var(--label-w);
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: hsl(var(--muted-foreground));
  }
  .tt-tick {
    position: absolute;
    top: 0;
    white-space: nowrap;
  }
  .tt-tick-ref {
    padding-left: 6px;
    transform: translateX(-100%);
  }

  .tt-groups {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tt-group + .tt-group {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid hsl(var(--border));
  }

  .tt-group-summary {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin: 0 0 8px;
  }
  .tt-group-name {
    color: hsl(var(--foreground));
    font-weight: 600;
  }
  .tt-group-time {
    font-family: var(--font-family-mono);
    color: hsl(var(--foreground));
  }
  .tt-group-time.accent {
    color: hsl(var(--primary));
    font-weight: 700;
  }
  .tt-group-delta {
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    color: hsl(var(--muted-foreground));
  }
  .tt-group-delta.gain {
    color: var(--alc-good);
  }
  .tt-group-delta.loss {
    color: var(--alc-bad);
  }

  .tt-lanes {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tt-lane {
    display: grid;
    grid-template-columns: var(--label-w) 1fr;
    align-items: center;
    min-height: 30px;
  }
  .tt-lane + .tt-lane {
    margin-top: 4px;
  }
  .tt-lane-label {
    padding-right: 12px;
    color: hsl(var(--muted-foreground));
  }

  .tt-track {
    position: relative;
    height: 22px;
    border-left: 1px solid hsl(var(--border));
  }
  .tt-ref-marker {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 2px dashed hsl(var(--muted-foreground));
    opacity: 0.6;
  }
  .tt-seg {
    position: absolute;
    top: 0;
    height: 100%;
    border-radius: var(--radius-sm);
  }
  .tt-seg-coordinator {
    background: var(--alc-read);
  }
  .tt-seg-subagent {
    background: var(--alc-new);
  }
  /* Stacked (parallel): four strips at the same time span read as one solid block. */
  .tt-seg-stacked {
    border-radius: 0;
  }

  @media (max-width: 560px) {
    .tt {
      --label-w: 0px;
    }
    .tt-axis {
      display: none;
    }
    .tt-lane {
      grid-template-columns: 1fr;
      grid-template-areas: "label" "track";
      row-gap: 4px;
      padding: 4px 0;
    }
    .tt-lane-label {
      grid-area: label;
    }
    .tt-track {
      grid-area: track;
      width: 100%;
    }
  }
</style>
