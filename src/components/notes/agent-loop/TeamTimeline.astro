---
// "Does splitting the work also make it faster?" Same coordinator + 4 subagents as the triangles
// above, laid out on a wall-clock axis instead of a token axis. Toggle dispatches them in parallel
// (one Task-call turn, all four run at once) or in sequence (one subagent at a time).
import Figure from "./kit/Figure.astro";
import Panel from "./kit/Panel.astro";
import Stat from "./kit/Stat.astro";
import Plot from "./kit/Plot.astro";
import Legend from "./kit/Legend.astro";
import Source from "./kit/Source.astro";
import DataTable from "./kit/DataTable.astro";
import { plotFrame } from "./kit/plot";
import { simulateMultiAgent } from "@/lib/sim/agent-loop";
import { SUBAGENT_WORKLOAD, SUBAGENTS } from "./workloads";
import { fmtSeconds, fmtChange } from "./format";

type Key = "parallel" | "sequential";

function run(parallel: boolean) {
  return simulateMultiAgent(SUBAGENT_WORKLOAD, {
    count: SUBAGENTS.count,
    parallel,
    subagent: { ...SUBAGENT_WORKLOAD, turns: SUBAGENTS.turnsEach },
    resultTokens: SUBAGENTS.resultTokens,
  });
}

const runs: Record<Key, ReturnType<typeof run>> = { parallel: run(true), sequential: run(false) };
const reqDur = SUBAGENT_WORKLOAD.secondsBetweenRequests;
const subDur = runs.parallel.subagents[0].totals.durationSeconds;
const count = SUBAGENTS.count;
const singleDuration = runs.parallel.single.totals.durationSeconds;

function schedule(key: Key) {
  const coordinator: [number, number][] = [];
  const subagents: [number, number][] = [];
  let cursor = 0;
  if (key === "parallel") {
    coordinator.push([cursor, cursor + reqDur]);
    cursor += reqDur;
    for (let i = 0; i < count; i++) subagents.push([cursor, cursor + subDur]);
    cursor += subDur;
    coordinator.push([cursor, cursor + reqDur]);
    cursor += reqDur;
  } else {
    for (let i = 0; i < count; i++) {
      coordinator.push([cursor, cursor + reqDur]);
      cursor += reqDur;
      subagents.push([cursor, cursor + subDur]);
      cursor += subDur;
    }
    coordinator.push([cursor, cursor + reqDur]);
    cursor += reqDur;
  }
  return { coordinator, subagents, total: cursor };
}

const SCHEDULES: Record<Key, ReturnType<typeof schedule>> = { parallel: schedule("parallel"), sequential: schedule("sequential") };

if (
  SCHEDULES.parallel.total !== runs.parallel.totals.durationSeconds ||
  SCHEDULES.sequential.total !== runs.sequential.totals.durationSeconds
) {
  throw new Error("TeamTimeline: schedule total doesn't match the engine's own duration");
}

const scaleMax = Math.max(SCHEDULES.sequential.total, singleDuration) * 1.04;

const labelW = 82;
const trackX0 = labelW;
const trackX1 = 474;
const laneH = 22;
const laneGap = 8;
const lanes: { key: string; label: string }[] = [
  { key: "single", label: "One agent" },
  { key: "coordinator", label: "Coordinator" },
  { key: "sub0", label: "Subagent 1" },
  { key: "sub1", label: "Subagent 2" },
  { key: "sub2", label: "Subagent 3" },
  { key: "sub3", label: "Subagent 4" },
];
const laneY = (i: number) => 16 + i * (laneH + laneGap);
const H = laneY(lanes.length - 1) + laneH + 16;

const frame = plotFrame({
  w: 480,
  h: H,
  inset: { l: 0, r: 480 - trackX1, t: 0, b: 0 },
  x: [0, scaleMax],
});
const x = frame.x;

function panel(key: Key) {
  const s = SCHEDULES[key];
  const r = runs[key];
  const team = r.totals.durationSeconds;
  const deltaTone = team <= singleDuration ? "gain" : "loss";
  return { key, s, team, change: fmtChange(team, singleDuration), deltaTone };
}
const PANELS: Record<Key, ReturnType<typeof panel>> = { parallel: panel("parallel"), sequential: panel("sequential") };

const OPTIONS = [
  { value: "parallel", label: "parallel" },
  { value: "sequential", label: "sequential" },
];
const INITIAL: Key = "parallel";

const ariaLabel = (key: Key) => {
  const p = PANELS[key];
  return `${key === "parallel" ? "Dispatched in parallel" : "Dispatched in sequence"}, the coordinator and its ${count} subagents finish in ${fmtSeconds(p.team)}, ${p.change} versus ${fmtSeconds(singleDuration)} for one agent doing the same tool work alone.`;
};
---

<Figure question="Does splitting the work also make it faster?" basis="assumed" options={OPTIONS} initial={INITIAL}>
  {
    (["parallel", "sequential"] as Key[]).map((key) => {
      const p = PANELS[key];
      return (
        <Panel value={key} initial={INITIAL}>
          <Stat value={fmtSeconds(p.team)} delta={`${p.change} vs one agent`} tone={p.deltaTone} />
          <Plot frame={frame} label={ariaLabel(key)}>
            {lanes.map((lane, i) => (
              <text class="alc-text" x="0" y={laneY(i) + laneH / 2 + 4}>{lane.label}</text>
            ))}

            <rect
              class="alc-ghost"
              x={x(0)}
              y={laneY(0)}
              width={x(singleDuration) - x(0)}
              height={laneH}
            />
            <text class="alc-text" x={x(singleDuration) + 4} y={laneY(0) + laneH / 2 + 4}>{fmtSeconds(singleDuration)}</text>

            {p.s.coordinator.map(([a, b]) => (
              <rect class="alc-fill-read" x={x(a)} y={laneY(1)} width={Math.max(x(b) - x(a), 1.5)} height={laneH} />
            ))}

            {p.s.subagents.map(([a, b], i) => (
              <rect class="alc-fill-new" x={x(a)} y={laneY(2 + i)} width={Math.max(x(b) - x(a), 1.5)} height={laneH} />
            ))}

            <line class="alc-axis" x1={trackX0} y1={H - 6} x2={trackX1} y2={H - 6} />
            <text class="alc-text" x={trackX0} y={H - 6} dy="12">0</text>
            <text class="alc-text" x={x(p.team)} y={H - 6} dy="12" text-anchor="end">{fmtSeconds(p.team)}</text>
          </Plot>
        </Panel>
      );
    })
  }

  <Legend items={[{ tone: "read", label: "coordinator request" }, { tone: "new", label: "subagent run" }]} />

  <Fragment slot="a11y">
    {
      (["parallel", "sequential"] as Key[]).map((key) => (
        <DataTable
          caption={ariaLabel(key)}
          columns={["dispatch", "wall time", "vs one agent"]}
          rows={[[key, fmtSeconds(PANELS[key].team), PANELS[key].change]]}
        />
      ))
    }
  </Fragment>

  <Source slot="caption">
    Same coordinator and {SUBAGENTS.count} subagents as above. Assumption: every coordinator request takes{" "}
    {reqDur} seconds and subagents run back-to-back with no gap between dispatches. Fixed scale in both states, up
    to the sequential total, {fmtSeconds(SCHEDULES.sequential.total)}.
  </Source>
</Figure>
