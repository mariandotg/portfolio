---
// "What does trimming one tool result save?" The exam guide's own example: an order lookup returns
// 40+ fields when only 5 matter. Same loop, same tokens per field; only the result size changes.
import AlcFigure from "./AlcFigure.astro";
import { simulate } from "@/lib/sim/agent-loop";
import { BASE_WORKLOAD } from "./workloads";
import { fmtChange, fmtTokens, scale } from "./format";

const FIELDS_FULL = 40;
const FIELDS_TRIMMED = 5;
const tokensPerField = BASE_WORKLOAD.toolResultTokens / FIELDS_FULL;

type Key = "full" | "trimmed";
const fields: Record<Key, number> = { full: FIELDS_FULL, trimmed: FIELDS_TRIMMED };
const runs = {
  full: simulate({ ...BASE_WORKLOAD, toolResultTokens: FIELDS_FULL * tokensPerField }),
  trimmed: simulate({ ...BASE_WORKLOAD, toolResultTokens: FIELDS_TRIMMED * tokensPerField }),
};

const N = BASE_WORKLOAD.turns;
const W = 480;
const H = 214;
const L = 6;
const R = 474;
const T = 24;
const B = 188;
const top = Math.max(...runs.full.requests.map((r) => r.contextTokens));
const slot = (R - L) / N;
const x = (i: number) => L + i * slot;
const y = scale(0, top, B, T);
const barWidth = slot - 1;

const panels = (Object.keys(runs) as Key[]).map((key) => {
  const run = runs[key];
  const perTurn = BASE_WORKLOAD.assistantTokens + fields[key] * tokensPerField;
  const last = run.requests[run.requests.length - 1];
  return { key, run, perTurn, last, total: run.totals.inputTokens };
});
const full = panels[0];
const trimmed = panels[1];
---

<AlcFigure
  question="What does trimming one tool result save?"
  options={[
    { value: "full", label: `lookup returns ${FIELDS_FULL} fields` },
    { value: "trimmed", label: `trimmed to ${FIELDS_TRIMMED} fields` },
  ]}
  initial="full"
>
  {
    panels.map((p) => (
      <div data-alc-panel={p.key} hidden={p.key !== "full"}>
        <div class="alc-headline">
          <span class="alc-big">{fmtTokens(p.total)} input tokens</span>
          {p.key === "trimmed" ? (
            <span class="alc-delta good">{fmtChange(p.total, full.total)}</span>
          ) : (
            <span class="alc-delta bad">{(p.total / p.last.contextTokens).toFixed(1)}× the final context</span>
          )}
        </div>
        <p class="alc-sub">
          {p.key === "full" ? (
            <>
              Each lookup adds <strong>{fmtTokens(p.perTurn - BASE_WORKLOAD.assistantTokens)}</strong> to the history, and every later request
              sends it again.
            </>
          ) : (
            <>
              Each lookup adds <strong>{fmtTokens(p.perTurn - BASE_WORKLOAD.assistantTokens)}</strong>. The last request sends{" "}
              <strong>{fmtTokens(p.last.contextTokens)}</strong> instead of <strong>{fmtTokens(full.last.contextTokens)}</strong>.
            </>
          )}
        </p>
        <svg
          class="alc-svg"
          viewBox={`0 0 ${W} ${H}`}
          role="img"
          aria-label={`${N} requests with tool results of ${fields[p.key]} fields. The last request sends ${fmtTokens(p.last.contextTokens)} tokens and the loop sends ${fmtTokens(p.total)} input tokens in total.`}
        >
          {p.run.requests.map((r, i) => {
            const fresh = i === 0 ? r.contextTokens : p.perTurn;
            return (
              <g>
                <rect class="alc-fill-resent" x={x(i)} width={barWidth} y={y(r.contextTokens - fresh)} height={y(0) - y(r.contextTokens - fresh)} />
                <rect class="alc-fill-new" x={x(i)} width={barWidth} y={y(r.contextTokens)} height={y(r.contextTokens - fresh) - y(r.contextTokens)} />
              </g>
            );
          })}
          <text class="alc-text-strong" x={x(N - 1) + barWidth} y={y(p.last.contextTokens) - 6} text-anchor="end">
            {fmtTokens(p.last.contextTokens)}
          </text>
          <line class="alc-axis" x1={L} x2={R} y1={B} y2={B} />
          <text class="alc-text" x={L} y={H - 6}>
            request 1
          </text>
          <text class="alc-text" x={R} y={H - 6} text-anchor="end">
            request {N}
          </text>
        </svg>
      </div>
    ))
  }
  <ul class="alc-legend">
    <li><span class="alc-swatch" style="background: var(--alc-new)"></span> new this request</li>
    <li><span class="alc-swatch" style="background: var(--alc-resent)"></span> sent again</li>
  </ul>
  <Fragment slot="caption">
    The 40-field order lookup is the exam guide's own example of a tool result that piles up in context. Assumption: every field is the
    same size, {fmtTokens(tokensPerField)} tokens. Same loop as above: {fmtTokens(trimmed.run.totals.inputTokens)} against{" "}
    {fmtTokens(full.run.totals.inputTokens)} input tokens.
  </Fragment>
</AlcFigure>
