---
// "What does trimming one tool result save?" The exam guide's own example: an order lookup returns
// 40+ fields when only 5 matter. Same loop, same tokens per field; only the result size changes.
import Figure from "./kit/Figure.astro";
import Panel from "./kit/Panel.astro";
import Stat from "./kit/Stat.astro";
import Plot from "./kit/Plot.astro";
import Axis from "./kit/Axis.astro";
import Legend from "./kit/Legend.astro";
import Source from "./kit/Source.astro";
import DataTable from "./kit/DataTable.astro";
import { plotFrame } from "./kit/plot";
import { simulate } from "@/lib/sim/agent-loop";
import { BASE_WORKLOAD } from "./workloads";
import { fmtChange, fmtTokens } from "./format";

const FIELDS_FULL = 40;
const FIELDS_TRIMMED = 5;
const tokensPerField = BASE_WORKLOAD.toolResultTokens / FIELDS_FULL;

type Key = "full" | "trimmed";
const fields: Record<Key, number> = { full: FIELDS_FULL, trimmed: FIELDS_TRIMMED };
const runs = {
  full: simulate({ ...BASE_WORKLOAD, toolResultTokens: FIELDS_FULL * tokensPerField }),
  trimmed: simulate({ ...BASE_WORKLOAD, toolResultTokens: FIELDS_TRIMMED * tokensPerField }),
};

const N = BASE_WORKLOAD.turns;
const top = Math.max(...runs.full.requests.map((r) => r.contextTokens));

const frame = plotFrame({
  w: 480,
  h: 214,
  inset: { l: 6, r: 6, t: 24, b: 26 },
  x: [0, N],
  y: [0, top],
  bands: N,
  bandGap: 1,
});

const panels = (Object.keys(runs) as Key[]).map((key) => {
  const run = runs[key];
  const perTurn = BASE_WORKLOAD.assistantTokens + fields[key] * tokensPerField;
  const last = run.requests[run.requests.length - 1];
  return { key, run, perTurn, last, total: run.totals.inputTokens };
});
const full = panels[0];
const trimmed = panels[1];

const OPTIONS = [
  { value: "full", label: `lookup returns ${FIELDS_FULL} fields` },
  { value: "trimmed", label: `trimmed to ${FIELDS_TRIMMED} fields` },
];
const INITIAL: Key = "full";
---

<Figure
  question="What does trimming one tool result save?"
  basis="calculated"
  options={OPTIONS}
  initial={INITIAL}
>
  {
    panels.map((p) => (
      <Panel value={p.key} initial={INITIAL}>
        <Stat
          value={fmtTokens(p.total)}
          unit="input tokens"
          delta={p.key === "trimmed" ? fmtChange(p.total, full.total) : `${(p.total / p.last.contextTokens).toFixed(1)}× the final context`}
          tone={p.key === "trimmed" ? "gain" : "loss"}
        >
          {p.key === "full" ? (
            <>
              Each lookup adds <strong>{fmtTokens(p.perTurn - BASE_WORKLOAD.assistantTokens)}</strong> to the history, and every later request
              sends it again.
            </>
          ) : (
            <>
              Each lookup adds <strong>{fmtTokens(p.perTurn - BASE_WORKLOAD.assistantTokens)}</strong>. The last request sends{" "}
              <strong>{fmtTokens(p.last.contextTokens)}</strong> instead of <strong>{fmtTokens(full.last.contextTokens)}</strong>.
            </>
          )}
        </Stat>
        <Plot
          frame={frame}
          label={`${N} requests with tool results of ${fields[p.key]} fields. The last request sends ${fmtTokens(p.last.contextTokens)} tokens and the loop sends ${fmtTokens(p.total)} input tokens in total.`}
        >
          {p.run.requests.map((r, i) => {
            const fresh = i === 0 ? r.contextTokens : p.perTurn;
            const x = frame.band(i);
            const bw = frame.bandWidth;
            return (
              <g>
                <rect class="alc-fill-resent" x={x} width={bw} y={frame.y(r.contextTokens - fresh)} height={frame.y(0) - frame.y(r.contextTokens - fresh)} />
                <rect class="alc-fill-new" x={x} width={bw} y={frame.y(r.contextTokens)} height={frame.y(r.contextTokens - fresh) - frame.y(r.contextTokens)} />
              </g>
            );
          })}
          <text class="alc-text-strong" x={frame.band(N - 1) + frame.bandWidth} y={frame.y(p.last.contextTokens) - 6} text-anchor="end">
            {fmtTokens(p.last.contextTokens)}
          </text>
          <Axis frame={frame} x={["request 1", `request ${N}`]} rule />
        </Plot>
      </Panel>
    ))
  }

  <Legend items={[{ tone: "new", label: "new this request" }, { tone: "resent", label: "sent again" }]} />

  <Fragment slot="a11y">
    {
      panels.map((p) => (
        <DataTable
          caption={`${fields[p.key]} fields per tool result: ${fmtTokens(p.total)} input tokens total.`}
          columns={["metric", "value"]}
          rows={[
            ["fields per result", fields[p.key]],
            ["last request context", fmtTokens(p.last.contextTokens)],
            ["total input tokens", fmtTokens(p.total)],
          ]}
        />
      ))
    }
  </Fragment>

  <Source slot="caption">
    The 40-field order lookup is the exam guide's own example of a tool result that piles up in context. Assumption: every field is the
    same size, {fmtTokens(tokensPerField)} tokens. Same loop as above: {fmtTokens(trimmed.run.totals.inputTokens)} against{" "}
    {fmtTokens(full.run.totals.inputTokens)} input tokens.
  </Source>
</Figure>
