---
// The shell every note figure shares: the question it answers, the figure, a screen-reader equivalent,
// and the caption. Figures show every state at once — no toggles. docs/design/design-system.md §5.
import "../agent-loop.css";
import { getLangFromUrl } from "../../../../i18n/utils";
import { getAgentLoopUi } from "../i18n";

export type Basis = "measured" | "calculated" | "assumed";

interface Props {
  /** The question the figure answers. Not a label — the figure is the answer. */
  question: string;
  /** How the numbers were arrived at. When a figure mixes sources, the weakest one wins. */
  basis: Basis;
  /** Figure number, when the prose refers to it. */
  n?: number;
}
const { question, basis, n } = Astro.props;
const ui = getAgentLoopUi(getLangFromUrl(Astro.url));
---

<figure class="alc not-prose" data-basis={basis}>
  <figcaption class="alc-question">
    {n === undefined ? question : `${ui.figurePrefix} ${n} — ${question}`}
  </figcaption>
  <slot />
  <slot name="a11y" />
  <div class="alc-caption">
    <span class="alc-basis"><span class="sr-only">{ui.basisLabel}</span>{ui.basis[basis]}</span>
    {
      Astro.slots.has("caption") && (
        <span class="alc-caption-text">
          <slot name="caption" />
        </span>
      )
    }
  </div>
</figure>
