---
// One state of a toggled figure. Server-rendered hidden unless it is the initial one, so the
// figure reads correctly before the toggle script runs.
interface Props {
  /** Matches the toggle option that shows this panel. */
  value: string;
  /** The figure's initial option. */
  initial: string;
}
const { value, initial } = Astro.props;
---

<div data-alc-panel={value} hidden={value !== initial}>
  <slot />
</div>
