---
// The segmented control that swaps a figure's panels. Rendered by Figure when it is given options.
interface Props {
  options: { value: string; label: string }[];
  /** The option shown before the reader touches anything. */
  initial: string;
  /** What the group switches between, for screen readers. */
  label: string;
}
const { options, initial, label } = Astro.props;
---

<div class="alc-seg" role="group" aria-label={label}>
  {
    options.map((o) => (
      <button type="button" data-alc-option={o.value} aria-pressed={String(o.value === initial)}>
        {o.label}
      </button>
    ))
  }
</div>
