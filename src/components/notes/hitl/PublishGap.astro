---
// Two lanes on one step axis: the normal approval path and the path where the API dies between the
// commit and the publish. Steps share columns, so the lanes visibly diverge at the publish and
// converge again at the lease claim. Focus: the gap (tailoring with no message) and the sweep.
import { getLangFromUrl } from "../../../i18n/utils";
import Figure from "../agent-loop/kit/Figure.astro";

type Kind = "step" | "state" | "gap" | "fail";
interface Step {
  kind: Kind;
  tag: string;
  title: string;
  code?: string;
}

const T = {
  en: {
    question: "What happens if the API dies between the commit and the publish?",
    normal: "Normal path",
    crash: "API crashes",
    commit: "Commit",
    publish: "Publishes",
    claim: "Claims the lease",
    gen: "Generates and closes",
    done: "Finishes",
    fail: "API crashes",
    failNote: "no publish",
    gap: "Run with no message",
    sweep: "Sweep republishes",
    sweepNote: "no lease",
    wait: "until the next sweep (≤ 1 h)",
    caption: "The sweep plus the lease make republishing safe: a duplicate message finds no free lease and is dropped.",
    a11y: "Two sequences. Normal path: 1. commit, the run moves to tailoring. 2. publish to Pub/Sub. 3. the consumer claims the lease. 4. it generates the CVs and the run moves to done. API crash path: 1. commit, the run moves to tailoring. 2. the API crashes, so there is no publish. 3. the run stays in tailoring with no message: the gap. 4. the hourly sweep republishes runs in tailoring with no lease (null or expired). 5. the consumer claims the lease. 6. it generates the CVs and the run moves to done. The gap lasts until the next sweep, at most one hour.",
  },
  es: {
    question: "¿Qué pasa si la API se cae entre el commit y el publish?",
    normal: "Camino normal",
    crash: "Caída de la API",
    commit: "Commit",
    publish: "Publica",
    claim: "Reclama el lease",
    gen: "Genera y cierra",
    done: "Termina",
    fail: "Cae la API",
    failNote: "no hay publish",
    gap: "Corrida sin mensaje",
    sweep: "Barrido republica",
    sweepNote: "sin lease",
    wait: "hasta el próximo barrido (≤ 1 h)",
    caption: "El barrido y el lease hacen seguro republicar: un mensaje duplicado no encuentra lease libre y se descarta.",
    a11y: "Dos secuencias. Camino normal: 1. commit, la corrida pasa a tailoring. 2. publish a Pub/Sub. 3. el consumidor reclama el lease. 4. genera los CVs y la corrida pasa a done. Camino con caída: 1. commit, la corrida pasa a tailoring. 2. la API cae, así que no hay publish. 3. la corrida queda en tailoring sin mensaje: el hueco. 4. el barrido horario republica las corridas en tailoring sin lease (nulo o vencido). 5. el consumidor reclama el lease. 6. genera los CVs y la corrida pasa a done. El hueco dura hasta el próximo barrido, como máximo una hora.",
  },
};
const t = T[getLangFromUrl(Astro.url) === "en" ? "en" : "es"];

const commit: Step = { kind: "state", tag: "DB", title: t.commit, code: "tailoring" };
const claim: Step = { kind: "step", tag: "Run", title: t.claim, code: "claimed_until" };
const gen: Step = { kind: "step", tag: "Run", title: t.gen, code: "upsert → done" };

const lanes: { label: string; steps: (Step | null)[] }[] = [
  {
    label: t.normal,
    steps: [commit, { kind: "step", tag: "Pub/Sub", title: t.publish, code: "publish" }, null, null, claim, gen],
  },
  {
    label: t.crash,
    steps: [
      commit,
      { kind: "fail", tag: "API", title: t.fail, code: t.failNote },
      { kind: "gap", tag: "DB", title: t.gap, code: "tailoring" },
      { kind: "gap", tag: "Cron", title: t.sweep, code: t.sweepNote },
      claim,
      gen,
    ],
  },
];
---

<Figure question={t.question} basis="assumed">
  <div class="pg">
    <div class="pg-grid">
      {
        lanes.map((lane, li) => (
          <section class="pg-lane" style={`--lane: ${li + 1}`}>
            <h4 class="pg-head">{lane.label}</h4>
            <ol class="pg-steps">
              {lane.steps.map((s, i) =>
                s ? (
                  <li class={`pg-step ${s.kind}`} style={`--i: ${i + 1}`}>
                    <span class="pg-tag">
                      {s.kind === "fail" ? "✕ " : ""}
                      {s.tag}
                    </span>
                    <span class="pg-title">{s.title}</span>
                    {s.code && <code class="pg-code" set:html={s.code} />}
                    {li === 1 && i === 2 && <span class="pg-wait-m">{t.wait}</span>}
                  </li>
                ) : (
                  <li class="pg-bridge" style={`--i: ${i + 1}`} aria-hidden="true" />
                ),
              )}
            </ol>
          </section>
        ))
      }
      <div class="pg-wait" aria-hidden="true"><span>{t.wait}</span></div>
    </div>
  </div>

  <div slot="a11y" class="sr-only">{t.a11y}</div>
  <Fragment slot="caption">{t.caption}</Fragment>
</Figure>

<style>
  .pg {
    --gap: 16px;
    font-size: var(--text-ui);
    line-height: var(--text-ui--line-height);
  }
  .pg-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 8px;
    padding-bottom: 30px;
  }
  .pg-lane,
  .pg-steps {
    display: contents;
  }
  .pg-head {
    grid-column: 1 / -1;
    grid-row: calc(var(--lane) * 2 - 1);
    margin: 0;
    padding-top: 6px;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }
  .pg-lane:nth-of-type(2) .pg-head {
    margin-top: 10px;
    border-top: 1px solid hsl(var(--border));
    padding-top: 12px;
  }
  .pg-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pg-step,
  .pg-bridge {
    grid-column: var(--i);
    grid-row: calc(var(--lane) * 2);
    position: relative;
    margin: 0;
  }
  .pg-step {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 8px 6px 10px;
    border: 1px solid hsl(var(--border));
    border-radius: 6px;
  }
  .pg-step.state {
    background: color-mix(in srgb, hsl(var(--foreground)) 5%, transparent);
    border-color: hsl(var(--muted-foreground));
  }
  .pg-step.gap {
    background: color-mix(in srgb, hsl(var(--primary)) 10%, transparent);
    border-color: hsl(var(--primary));
  }
  .pg-step.fail {
    border-color: hsl(var(--data-loss));
  }
  .pg-tag {
    align-self: flex-start;
    padding: 1px 5px;
    border: 1px solid currentColor;
    border-radius: 2px;
    font-family: var(--font-family-mono);
    font-size: 9px;
    line-height: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }
  .gap .pg-tag {
    color: hsl(var(--primary));
  }
  .fail .pg-tag {
    color: hsl(var(--data-loss));
  }
  .pg-title {
    font-weight: 600;
    font-size: 13px;
    line-height: 1.3;
    color: hsl(var(--foreground));
    overflow-wrap: anywhere;
  }
  .pg .pg-code {
    font-family: var(--font-family-mono);
    font-size: 10.5px;
    line-height: 1.35;
    color: hsl(var(--muted-foreground));
    overflow-wrap: break-word;
    background: none;
    padding: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .gap .pg-code {
    color: hsl(var(--foreground));
  }
  .fail .pg-code {
    color: hsl(var(--data-loss));
  }
  .pg-wait-m {
    display: none;
  }

  /* connectors: a line across the column gap with an arrowhead */
  .pg-step:not(:last-child)::after,
  .pg-bridge::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 100%;
    width: var(--gap);
    border-top: 1px solid hsl(var(--muted-foreground));
  }
  .pg-step:not(:last-child)::before,
  .pg-bridge::after {
    content: "";
    position: absolute;
    top: 50%;
    left: calc(100% + var(--gap) - 5px);
    width: 5px;
    height: 5px;
    border-top: 1px solid hsl(var(--muted-foreground));
    border-right: 1px solid hsl(var(--muted-foreground));
    transform: translateY(-3px) rotate(45deg);
  }
  .pg-step.fail::after {
    border-top-color: hsl(var(--data-loss));
  }
  .pg-step.fail::before {
    border-color: hsl(var(--data-loss));
  }
  /* bridge cells: the normal lane has no step here; a dashed line passes through */
  .pg-bridge {
    align-self: center;
    height: 0;
  }
  .pg-bridge::before {
    left: 0;
    width: calc(100% + var(--gap));
    border-top-style: dashed;
    opacity: 0.6;
  }

  /* the gap's duration: a bracket under columns 3-4 of the crash lane */
  .pg-wait {
    grid-column: 3 / 5;
    grid-row: 5;
    height: 8px;
    margin-top: 2px;
    border: 1px solid hsl(var(--primary));
    border-top: 0;
    position: relative;
  }
  .pg-wait span {
    position: absolute;
    top: 14px;
    left: -40px;
    right: -40px;
    text-align: center;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    color: hsl(var(--primary));
  }

  @media (max-width: 639px) {
    .pg {
      --gap: 18px;
    }
    .pg-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 14px;
      row-gap: var(--gap);
      padding-bottom: 0;
    }
    .pg-head {
      grid-column: var(--lane);
      grid-row: 1;
      margin: 0 !important;
      padding-top: 0 !important;
      border-top: 0 !important;
    }
    .pg-step,
    .pg-bridge {
      grid-column: var(--lane);
      grid-row: calc(var(--i) + 1);
    }
    .pg-step:not(:last-child)::after,
    .pg-bridge::before {
      top: 100%;
      left: 50%;
      width: 0;
      height: var(--gap);
      border-top: 0;
      border-left: 1px solid hsl(var(--muted-foreground));
    }
    .pg-step:not(:last-child)::before,
    .pg-bridge::after {
      top: calc(100% + var(--gap) - 5px);
      left: calc(50% - 3px);
      transform: rotate(135deg);
    }
    .pg-step.fail::after {
      border-left-color: hsl(var(--data-loss));
    }
    .pg-bridge {
      height: auto;
      align-self: stretch;
    }
    .pg-bridge::before {
      top: 0;
      height: calc(100% + var(--gap));
      border-left-style: dashed;
      width: 0;
    }
    .pg-wait {
      display: none;
    }
    .pg-wait-m {
      display: block;
      font-family: var(--font-family-mono);
      font-size: 10.5px;
      line-height: 1.35;
      color: hsl(var(--primary));
    }
  }
</style>
