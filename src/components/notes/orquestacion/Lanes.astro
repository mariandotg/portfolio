---
// Lanes on one shared step axis, generalized from hitl/PublishGap: each lane is a sequence of steps, and
// steps in the same column happen at the same point of the flow. A null step is a bridge (dashed line).
// On phones the axis turns vertical and lanes become columns.
import Figure from "../agent-loop/kit/Figure.astro";
import type { Basis } from "../agent-loop/kit/Figure.astro";

export type Kind = "step" | "state" | "gap" | "fail" | "win";
export interface Step {
  kind: Kind;
  tag: string;
  title: string;
  code?: string;
}
export interface Lane {
  label: string;
  /** null = dashed bridge; "skip" = empty cell, only before the first step. */
  steps: (Step | null | "skip")[];
}

interface Props {
  question: string;
  basis: Basis;
  lanes: Lane[];
  a11y: string;
  caption?: string;
  n?: number;
}
const { question, basis, lanes, a11y, caption, n } = Astro.props;
const cols = Math.max(...lanes.map((l) => l.steps.length));
---

<Figure question={question} basis={basis} n={n}>
  <div class="ln" style={`--cols: ${cols}; --lanes: ${lanes.length}`}>
    <div class="ln-grid">
      {
        lanes.map((lane, li) => (
          <section class="ln-lane" style={`--lane: ${li + 1}`}>
            <h4 class="ln-head">{lane.label}</h4>
            <ol class="ln-steps">
              {lane.steps.map((s, i) =>
                s === "skip" ? (
                  <li class="ln-skip" style={`--i: ${i + 1}`} aria-hidden="true" />
                ) : s ? (
                  <li class={`ln-step ${s.kind}`} style={`--i: ${i + 1}`}>
                    <span class="ln-tag">
                      {s.kind === "fail" ? "✕ " : s.kind === "win" ? "✓ " : ""}
                      {s.tag}
                    </span>
                    <span class="ln-title">{s.title}</span>
                    {s.code && <code class="ln-code" set:html={s.code} />}
                  </li>
                ) : (
                  <li class="ln-bridge" style={`--i: ${i + 1}`} aria-hidden="true" />
                ),
              )}
            </ol>
          </section>
        ))
      }
    </div>
  </div>

  <div slot="a11y" class="sr-only">{a11y}</div>
  {caption && <Fragment slot="caption">{caption}</Fragment>}
</Figure>

<style>
  .ln {
    --gap: 16px;
    font-size: var(--text-ui);
    line-height: var(--text-ui--line-height);
  }
  .ln-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 8px;
  }
  .ln-lane,
  .ln-steps {
    display: contents;
  }
  .ln-head {
    grid-column: 1 / -1;
    grid-row: calc(var(--lane) * 2 - 1);
    margin: 0;
    padding-top: 6px;
    font-family: var(--font-family-mono);
    font-size: var(--text-meta);
    line-height: var(--text-meta--line-height);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }
  .ln-lane:not(:first-of-type) .ln-head {
    margin-top: 10px;
    border-top: 1px solid hsl(var(--border));
    padding-top: 12px;
  }
  .ln-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ln-step,
  .ln-bridge,
  .ln-skip {
    grid-column: var(--i);
    grid-row: calc(var(--lane) * 2);
    position: relative;
    margin: 0;
  }
  .ln-step {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 8px 6px 10px;
    border: 1px solid hsl(var(--border));
    border-radius: 6px;
  }
  .ln-step.state {
    background: color-mix(in srgb, hsl(var(--foreground)) 5%, transparent);
    border-color: hsl(var(--muted-foreground));
  }
  .ln-step.gap {
    background: color-mix(in srgb, hsl(var(--primary)) 10%, transparent);
    border-color: hsl(var(--primary));
  }
  .ln-step.win {
    background: color-mix(in srgb, hsl(var(--data-gain)) 10%, transparent);
    border-color: hsl(var(--data-gain));
  }
  .ln-step.fail {
    border-color: hsl(var(--data-loss));
  }
  .ln-tag {
    align-self: flex-start;
    padding: 1px 5px;
    border: 1px solid currentColor;
    border-radius: 2px;
    font-family: var(--font-family-mono);
    font-size: 9px;
    line-height: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: hsl(var(--muted-foreground));
  }
  .gap .ln-tag {
    color: hsl(var(--primary));
  }
  .win .ln-tag {
    color: hsl(var(--data-gain));
  }
  .fail .ln-tag {
    color: hsl(var(--data-loss));
  }
  .ln-title {
    font-weight: 600;
    font-size: 13px;
    line-height: 1.3;
    color: hsl(var(--foreground));
    overflow-wrap: anywhere;
  }
  .ln .ln-code {
    font-family: var(--font-family-mono);
    font-size: 10.5px;
    line-height: 1.35;
    color: hsl(var(--muted-foreground));
    overflow-wrap: break-word;
    background: none;
    padding: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .fail .ln-code {
    color: hsl(var(--data-loss));
  }

  /* connectors: a line across the column gap with an arrowhead */
  .ln-step:not(:last-child)::after,
  .ln-bridge::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 100%;
    width: var(--gap);
    border-top: 1px solid hsl(var(--muted-foreground));
  }
  .ln-step:not(:last-child)::before,
  .ln-bridge::after {
    content: "";
    position: absolute;
    top: 50%;
    left: calc(100% + var(--gap) - 5px);
    width: 5px;
    height: 5px;
    border-top: 1px solid hsl(var(--muted-foreground));
    border-right: 1px solid hsl(var(--muted-foreground));
    transform: translateY(-3px) rotate(45deg);
  }
  .ln-bridge {
    align-self: center;
    height: 0;
  }
  .ln-bridge::before {
    left: 0;
    width: calc(100% + var(--gap));
    border-top-style: dashed;
    opacity: 0.6;
  }

  @media (max-width: 639px) {
    .ln {
      --gap: 18px;
    }
    .ln-grid {
      grid-template-columns: repeat(var(--lanes), minmax(0, 1fr));
      column-gap: 10px;
      row-gap: var(--gap);
    }
    .ln-head {
      grid-column: var(--lane);
      grid-row: 1;
      margin: 0 !important;
      padding-top: 0 !important;
      border-top: 0 !important;
    }
    .ln-step,
    .ln-bridge,
    .ln-skip {
      grid-column: var(--lane);
      grid-row: calc(var(--i) + 1);
    }
    .ln-step:not(:last-child)::after,
    .ln-bridge::before {
      top: 100%;
      left: 50%;
      width: 0;
      height: var(--gap);
      border-top: 0;
      border-left: 1px solid hsl(var(--muted-foreground));
    }
    .ln-step:not(:last-child)::before,
    .ln-bridge::after {
      top: calc(100% + var(--gap) - 5px);
      left: calc(50% - 3px);
      transform: rotate(135deg);
    }
    .ln-bridge {
      height: auto;
      align-self: stretch;
    }
    .ln-bridge::before {
      top: 0;
      height: calc(100% + var(--gap));
      border-left-style: dashed;
      width: 0;
    }
  }
</style>
