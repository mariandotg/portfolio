---
// Figure 2: the official track. Three entry points (schedule, user, hourly rescue) and the same
// pieces behind them. Every box scales to zero: with no events, nothing runs.
import { getLangFromUrl } from "../../../i18n/utils";
import Lanes from "./Lanes.astro";
import type { Lane } from "./Lanes.astro";

const T = {
  es: {
    question: "¿Qué corre cuando no pasa nada?",
    lanes: ["Programado", "Usuario", "Cada hora"],
    p: ["Dispara el catálogo", "Dispatcher: parte el trabajo", "1 mensaje por fuente", "Entrega at-least-once", "+ DLQ por topic", "Worker: procesa e inserta", "escala a cero"],
    u: ["Web + rewrites", "sin Load Balancer", "API: crea la corrida", "Avisa", "Workers: prefiltro y matching", "1 mensaje por oferta", "Tabla de corridas"],
    h: ["Dispara el rescate", "Busca corridas quietas", "updated_at viejo", "Republica lo que falta", "o marca failed"],
    a11y: "Tres secuencias que comparten piezas. Programado: Cloud Scheduler dispara el catálogo; un dispatcher en Cloud Run parte el trabajo en un mensaje por fuente; Pub/Sub lo entrega at-least-once, con un topic de dead letter por topic; un worker en Cloud Run procesa e inserta con ON CONFLICT DO NOTHING; el estado vive en Postgres en Neon, que escala a cero. Usuario: la web está en Firebase Hosting con rewrites, sin Load Balancer; la API en Cloud Run crea la corrida con status created; publica run.created en Pub/Sub; los workers de Cloud Run hacen el prefiltro y el matching, un mensaje por oferta; la corrida vive en la tabla runs en Neon. Cada hora: Cloud Scheduler dispara el rescate; un servicio de Cloud Run busca corridas sin avanzar; republica lo que falta en Pub/Sub o marca la corrida como failed.",
    caption: "Diseño propuesto, no desplegado. Sin eventos no corre nada: ni Cloud Run, ni Pub/Sub, ni el cómputo de Neon.",
  },
  en: {
    question: "What runs when nothing is happening?",
    lanes: ["Scheduled", "User", "Every hour"],
    p: ["Fires the catalog", "Dispatcher: splits the work", "1 message per source", "At-least-once delivery", "+ DLQ per topic", "Worker: processes and inserts", "scales to zero"],
    u: ["Web + rewrites", "no Load Balancer", "API: creates the run", "Announces", "Workers: prefilter and matching", "1 message per offer", "Runs table"],
    h: ["Fires the rescue", "Finds stalled runs", "old updated_at", "Republishes what is missing", "or marks failed"],
    a11y: "Three sequences that share pieces. Scheduled: Cloud Scheduler fires the catalog; a dispatcher on Cloud Run splits the work into one message per source; Pub/Sub delivers it at least once, with a dead-letter topic per topic; a worker on Cloud Run processes and inserts with ON CONFLICT DO NOTHING; the state lives in Postgres on Neon, which scales to zero. User: the web app is on Firebase Hosting with rewrites, with no Load Balancer; the API on Cloud Run creates the run with status created; it publishes run.created to Pub/Sub; Cloud Run workers do the prefilter and the matching, one message per offer; the run lives in the runs table on Neon. Every hour: Cloud Scheduler fires the rescue; a Cloud Run service finds runs that stopped advancing; it republishes what is missing to Pub/Sub or marks the run as failed.",
    caption: "Proposed design, not deployed. With no events nothing runs: not Cloud Run, not Pub/Sub, not Neon's compute.",
  },
};
const t = T[getLangFromUrl(Astro.url) === "en" ? "en" : "es"];

const lanes: Lane[] = [
  {
    label: t.lanes[0],
    steps: [
      { kind: "step", tag: "Scheduler", title: t.p[0], code: "cron" },
      { kind: "step", tag: "Cloud Run", title: t.p[1], code: t.p[2] },
      { kind: "step", tag: "Pub/Sub", title: t.p[3], code: t.p[4] },
      { kind: "step", tag: "Cloud Run", title: t.p[5], code: "ON CONFLICT DO NOTHING" },
      { kind: "state", tag: "Neon", title: "Postgres", code: t.p[6] },
    ],
  },
  {
    label: t.lanes[1],
    steps: [
      { kind: "step", tag: "Firebase Hosting", title: t.u[0], code: t.u[1] },
      { kind: "step", tag: "Cloud Run", title: t.u[2], code: "status = created" },
      { kind: "step", tag: "Pub/Sub", title: t.u[3], code: "run.created" },
      { kind: "step", tag: "Cloud Run", title: t.u[4], code: t.u[5] },
      { kind: "state", tag: "Neon", title: t.u[6], code: "runs" },
    ],
  },
  {
    label: t.lanes[2],
    steps: [
      { kind: "step", tag: "Scheduler", title: t.h[0], code: "cron" },
      { kind: "step", tag: "Cloud Run", title: t.h[1], code: t.h[2] },
      { kind: "gap", tag: "Pub/Sub", title: t.h[3], code: t.h[4] },
    ],
  },
];
---

<Lanes n={2} question={t.question} basis="assumed" lanes={lanes} a11y={t.a11y} caption={t.caption} />
