---
import type { MarkdownHeading } from "astro";
import PageLayout from "./PageLayout.astro";
import TagList from "../components/TagList.astro";
import TableOfContents from "../components/blog/TableOfContents.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/utils";
import { bannerSvg } from "@/lib/effects/banner";
import { seriesPath } from "../lib/series";

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  image?: string;
  imageAlt?: string;
  readingTime?: number;
  headings?: MarkdownHeading[];
  bannerSeed?: string;
  seriesContext?: {
    slug: string;
    rootLevel: boolean;
    title: string;
    part: number;
    total: number;
    prev?: { slug: string; title: string };
    next?: { slug: string; title: string };
  };
}

const { slug, title, description, pubDate, updatedDate, tags = [], image, readingTime, headings = [], bannerSeed, seriesContext } = Astro.props;
const hasToc = headings.some((h) => h.depth === 2 || h.depth === 3);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const banner = bannerSvg(bannerSeed || slug);
const blogHref = getLocalizedPath("/blog", lang);

const formattedDate = pubDate.toLocaleDateString(lang === "es" ? "es-AR" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const formattedUpdated = updatedDate?.toLocaleDateString(lang === "es" ? "es-AR" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const seriesHref = seriesContext ? getLocalizedPath(seriesPath(seriesContext.slug, seriesContext.rootLevel), lang) : undefined;
const seriesPartLabel = seriesContext
  ? t.blog.series.partOf.replace("{n}", String(seriesContext.part)).replace("{m}", String(seriesContext.total))
  : undefined;
const prevHref = seriesContext?.prev ? getLocalizedPath(`/blog/${seriesContext.prev.slug}`, lang) : undefined;
const nextHref = seriesContext?.next ? getLocalizedPath(`/blog/${seriesContext.next.slug}`, lang) : undefined;
---

<PageLayout title={title} description={description} image={image} type="article" pubDate={pubDate}>
  <article class="post max-w-[800px] mx-auto px-4 sm:px-6 lg:px-12 py-12">
    <a href={blogHref} class="back-link">
      <span class="back-arrow" aria-hidden="true">←</span>
      <span>{t.blog.backToBlog}</span>
    </a>

    <div class="banner w-full overflow-hidden mb-8" aria-hidden="true" set:html={banner} />

    {seriesContext && (
      <a href={seriesHref} class="series-strip">
        <span class="series-strip-part">{seriesPartLabel}</span>
        <span class="series-strip-sep">·</span>
        <span class="series-strip-title">{seriesContext.title}</span>
      </a>
    )}

    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3" style="font-family: var(--font-family-mono); font-size: 12px; color: hsl(var(--muted-foreground));">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {readingTime && (
          <>
            <span>·</span>
            <span>{readingTime} {t.blog.readingTime}</span>
          </>
        )}
        {formattedUpdated && (
          <>
            <span>·</span>
            <span>Updated {formattedUpdated}</span>
          </>
        )}
      </div>

      <h1 class="text-xl font-semibold leading-snug mb-3 text-foreground">
        {title}
      </h1>

      <p class="text-sm text-muted-foreground mb-4">
        {description}
      </p>

      {tags.length > 0 && <TagList tags={tags} />}
    </header>

    <hr class="mb-8" style="border-color: hsl(var(--border)); opacity: 0.5;" />

    {hasToc && <TableOfContents headings={headings} label={t.blog.onThisPage} />}

    <div class="prose prose-sm dark:prose-invert max-w-none">
      <slot />
    </div>

    {seriesContext && (seriesContext.prev || seriesContext.next) && (
      <nav class="series-nav">
        {seriesContext.prev ? (
          <a href={prevHref} class="series-nav-item series-nav-prev">
            <span class="series-nav-dir">← {t.blog.series.prevInSeries}</span>
            <span class="series-nav-title">{seriesContext.prev.title}</span>
          </a>
        ) : <span />}
        {seriesContext.next ? (
          <a href={nextHref} class="series-nav-item series-nav-next">
            <span class="series-nav-dir">{t.blog.series.nextInSeries} →</span>
            <span class="series-nav-title">{seriesContext.next.title}</span>
          </a>
        ) : <span />}
      </nav>
    )}
  </article>
</PageLayout>

<style>
  .banner {
    aspect-ratio: 80 / 15;
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
  }

  .banner :global(svg) {
    display: block;
  }
  .series-strip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid hsl(var(--border));
    font-family: var(--font-family-mono);
    font-size: 12px;
    transition: border-color 150ms ease-in-out, color 150ms ease-in-out;
  }
  .series-strip-part {
    color: hsl(var(--primary));
    font-weight: 600;
  }
  .series-strip-sep {
    color: hsl(var(--muted-foreground));
  }
  .series-strip-title {
    color: hsl(var(--muted-foreground));
  }
  .series-strip:hover {
    border-color: hsl(var(--primary));
  }
  .series-strip:hover .series-strip-title {
    color: hsl(var(--foreground));
  }

  .series-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid hsl(var(--border));
  }
  .series-nav-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
    transition: border-color 150ms ease-in-out, transform 150ms ease-in-out;
  }
  .series-nav-next {
    text-align: right;
    align-items: flex-end;
  }
  .series-nav-item:hover {
    border-color: hsl(var(--primary));
    transform: translateY(-2px);
  }
  .series-nav-dir {
    font-family: var(--font-family-mono);
    font-size: 12px;
    color: hsl(var(--muted-foreground));
  }
  .series-nav-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
    color: hsl(var(--foreground));
  }
  @media (max-width: 640px) {
    .series-nav {
      grid-template-columns: 1fr;
    }
    .series-nav-next {
      text-align: left;
      align-items: flex-start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .series-nav-item:hover {
      transform: none;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 20px;
    font-family: var(--font-family-mono);
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    transition: color 150ms ease-in-out;
  }
  .back-link:hover {
    color: hsl(var(--foreground));
  }
  .back-arrow {
    display: inline-block;
    transition: transform 180ms ease;
  }
  .back-link:hover .back-arrow {
    transform: translateX(-4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .back-arrow {
      transition: none;
    }
    .back-link:hover .back-arrow {
      transform: none;
    }
  }
</style>
