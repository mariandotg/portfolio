---
import PageLayout from "./PageLayout.astro";
import TagList from "../components/TagList.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/utils";
import { identiconSvg } from "../lib/identicon";

interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  image?: string;
  imageAlt?: string;
  readingTime?: number;
}

const { slug, title, description, pubDate, updatedDate, tags = [], image, readingTime } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const banner = identiconSvg(slug);
const blogHref = getLocalizedPath("/blog", lang);

const formattedDate = pubDate.toLocaleDateString(lang === "es" ? "es-AR" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const formattedUpdated = updatedDate?.toLocaleDateString(lang === "es" ? "es-AR" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<PageLayout title={title} description={description} image={image} type="article" pubDate={pubDate}>
  <article class="max-w-[800px] mx-auto px-4 sm:px-6 lg:px-12 py-12">
    <a href={blogHref} class="back-link">
      <span class="back-arrow" aria-hidden="true">←</span>
      <span>{t.blog.backToBlog}</span>
    </a>

    <div class="banner w-full overflow-hidden mb-8" aria-hidden="true" set:html={banner} />

    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3" style="font-family: var(--font-family-mono); font-size: 12px; color: var(--color-muted);">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {readingTime && (
          <>
            <span>·</span>
            <span>{readingTime} {t.blog.readingTime}</span>
          </>
        )}
        {formattedUpdated && (
          <>
            <span>·</span>
            <span>Updated {formattedUpdated}</span>
          </>
        )}
      </div>

      <h1 class="text-xl font-semibold leading-snug mb-3 text-[var(--color-fg)] dark:text-[var(--color-fg-dark)]">
        {title}
      </h1>

      <p class="text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)] mb-4">
        {description}
      </p>

      {tags.length > 0 && <TagList tags={tags} />}
    </header>

    <hr class="mb-8" style="border-color: var(--color-border); opacity: 0.5;" />

    <div class="prose prose-sm dark:prose-invert max-w-none">
      <slot />
    </div>
  </article>
</PageLayout>

<style>
  .banner {
    aspect-ratio: 80 / 15;
    border-radius: 8px;
    border: 1px solid var(--color-border);
    background: #0d0d0f;
  }

  .banner :global(svg) {
    display: block;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 20px;
    font-family: var(--font-family-mono);
    font-size: 13px;
    color: var(--color-muted);
    transition: color 150ms ease-in-out;
  }
  html.dark .back-link {
    color: var(--color-muted-dark);
  }
  .back-link:hover {
    color: var(--color-fg);
  }
  html.dark .back-link:hover {
    color: var(--color-fg-dark);
  }
  .back-arrow {
    display: inline-block;
    transition: transform 180ms ease;
  }
  .back-link:hover .back-arrow {
    transform: translateX(-4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .back-arrow {
      transition: none;
    }
    .back-link:hover .back-arrow {
      transform: none;
    }
  }
</style>
