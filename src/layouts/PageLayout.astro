---
import { fade } from "astro:transitions";
import BaseLayout from "./BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BackdropIsland from "../components/effects/BackdropIsland.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  pubDate?: Date;
  noindex?: boolean;
  class?: string;
  /** El backdrop va en todas las pantallas; apagarlo es para páginas con su propio fondo. */
  backdrop?: boolean;
  /** Siembra el campo del backdrop. Por defecto lo deriva de la ruta. */
  backdropSeed?: string;
  /** Oculta el nombre del nav hasta que el `[data-nav-title-anchor]` de la página sale de vista. */
  revealTitleOnScroll?: boolean;
}

const {
  title,
  description,
  image,
  type,
  pubDate,
  noindex,
  class: className,
  backdrop = true,
  backdropSeed,
  revealTitleOnScroll = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type={type}
  pubDate={pubDate}
  noindex={noindex}
>
  {backdrop && <BackdropIsland seed={backdropSeed} />}
  <Nav revealTitleOnScroll={revealTitleOnScroll} />
  <main
    class:list={["flex-1", backdrop && "relative z-10", className]}
    transition:animate={fade({ duration: "180ms" })}
  >
    <slot />
  </main>
  <Footer />
</BaseLayout>
