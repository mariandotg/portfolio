---
import BaseLayout from "./BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import BackdropIsland from "../components/effects/BackdropIsland.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  pubDate?: Date;
  noindex?: boolean;
  class?: string;
  backdrop?: boolean;
}

const {
  title,
  description,
  image,
  type,
  pubDate,
  noindex,
  class: className,
  backdrop = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  type={type}
  pubDate={pubDate}
  noindex={noindex}
>
  {backdrop && <BackdropIsland />}
  <Nav />
  <main class:list={["flex-1", backdrop && "relative z-10", className]}>
    <slot />
  </main>
  <Footer />
</BaseLayout>
