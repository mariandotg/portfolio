---
import type { CollectionEntry } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import SeriesRoadmap from "../components/SeriesRoadmap.astro";
import BackLink from "../components/BackLink.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath, localizedSeries } from "../i18n/utils";
import { getSeriesPosts, getSeriesRoadmap, getRootLevelSeries, metaLabel } from "../lib/series";
import SeriesBanner from "@/components/effects/SeriesBanner.astro";
import { seriesBannerBase } from "@/lib/effects/banner/assets";

export async function getStaticPaths() {
  const entries = await getRootLevelSeries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"series"> };
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, description } = localizedSeries(entry.data, lang);
const posts = await getSeriesPosts(entry.id);
const meta = metaLabel(posts.length, entry.data.status, t);
const comingSoon = posts.length === 0;
const roadmap = await getSeriesRoadmap(entry.id, lang);

const notesHref = getLocalizedPath("/notes", lang);
---

<PageLayout title={title} description={description}>
  <div class="max-w-[800px] mx-auto px-4 sm:px-6 lg:px-12 py-12">
    <BackLink href={notesHref} label={t.notes.backToNotes} />

    <SeriesBanner base={seriesBannerBase(entry.id, entry.data.bannerImage)} variant="hero" class="series-hero w-full mb-8 mt-5" />

    <header class="mb-10">
      <span class:list={["series-meta", { "series-meta-soon": comingSoon }]}>{meta}</span>
      <h1 class="text-2xl font-semibold leading-snug mt-3 mb-3 text-foreground">
        {title}
      </h1>
      <p class="text-sm text-muted-foreground leading-relaxed">
        {description}
      </p>
    </header>

    {comingSoon ? (
      <p class="empty-state">{t.notes.series.emptyState}</p>
    ) : (
      <SeriesRoadmap items={roadmap} />
    )}
  </div>
</PageLayout>

<style>
  /* `.series-hero` viaja como prop `class` al root de `SeriesBanner`, así que vive en el scope
     del hijo: sin `:global` la regla no lo alcanza. Ratio, overflow y fondo los pone el banner. */
  :global(.series-hero) {
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
  }
  .series-meta {
    display: inline-block;
    font-family: var(--font-family-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: hsl(var(--muted-foreground));
  }
  .series-meta-soon {
    color: hsl(var(--primary));
  }

  .empty-state {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    padding: 2rem 0;
  }
</style>
