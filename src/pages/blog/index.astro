---
import PageLayout from "../../layouts/PageLayout.astro";
import PostListItem from "../../components/PostListItem.astro";
import SeriesCard from "../../components/SeriesCard.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../../i18n/utils";
import { getSeriesIndex } from "../../lib/series";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const series = await getSeriesIndex(lang, t);

const posts = await getCollection("blog", ({ data }) => !data.draft);
const latest = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const archiveHref = getLocalizedPath("/blog/archive", lang);
---

<PageLayout title={t.blog.pageTitle} description={t.blog.pageSubtitle}>
  <div class="max-w-[800px] mx-auto px-4 sm:px-6 lg:px-12 py-12">
    <h1 class="text-xl font-semibold text-[var(--color-fg)] dark:text-[var(--color-fg-dark)] mb-1">{t.blog.pageTitle}</h1>
    <p class="text-sm text-[var(--color-muted)] dark:text-[var(--color-muted-dark)] mb-10">{t.blog.pageSubtitle}</p>

    {series.length > 0 && (
      <section class="mb-14">
        <h2 class="section-heading">{t.blog.series.sectionTitle}</h2>
        <div class="flex flex-col">
          {series.map((s) => (
            <SeriesCard
              slug={s.slug}
              path={s.path}
              title={s.title}
              description={s.description}
              meta={s.meta}
              comingSoon={s.comingSoon}
              featured={s.featured}
              bannerSeed={s.bannerSeed}
            />
          ))}
        </div>
      </section>
    )}

    <section>
      <div class="flex items-baseline justify-between mb-6">
        <h2 class="section-heading mb-0">{t.blog.series.latestNotes}</h2>
        <a href={archiveHref} class="all-notes-link">{t.blog.series.allNotes} →</a>
      </div>
      <div class="flex flex-col">
        {latest.map((post) => (
          <PostListItem
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
          />
        ))}
      </div>
    </section>
  </div>
</PageLayout>

<style>
  .section-heading {
    font-family: var(--font-family-display);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }
  html.dark .section-heading {
    color: var(--color-muted-dark);
  }
  .all-notes-link {
    font-family: var(--font-family-mono);
    font-size: 13px;
    color: var(--color-muted);
    transition: color 150ms ease-in-out;
  }
  html.dark .all-notes-link {
    color: var(--color-muted-dark);
  }
  .all-notes-link:hover {
    color: var(--color-fg);
  }
  html.dark .all-notes-link:hover {
    color: var(--color-fg-dark);
  }
</style>
