---
import type { CollectionEntry } from "astro:content";
import PageLayout from "../../../layouts/PageLayout.astro";
import SeriesRoadmap from "../../../components/SeriesRoadmap.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath, localizedSeries } from "../../../i18n/utils";
import { getSeriesPosts, getSeriesRoadmap, getStandardSeries, metaLabel } from "../../../lib/series";
import { bannerSvg } from "@/lib/effects/banner";

export async function getStaticPaths() {
  const entries = await getStandardSeries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"series"> };
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, description } = localizedSeries(entry.data, lang);
const posts = await getSeriesPosts(entry.id);
const meta = metaLabel(posts.length, entry.data.status, t);
const comingSoon = posts.length === 0;
const roadmap = await getSeriesRoadmap(entry.id, lang, t);

const banner = bannerSvg(entry.data.bannerSeed || entry.id);
const blogHref = getLocalizedPath("/blog", lang);
---

<PageLayout title={title} description={description}>
  <div class="max-w-[800px] mx-auto px-4 sm:px-6 lg:px-12 py-12">
    <a href={blogHref} class="back-link">
      <span class="back-arrow" aria-hidden="true">←</span>
      <span>{t.blog.backToBlog}</span>
    </a>

    <div class="banner w-full overflow-hidden mb-8 mt-5" aria-hidden="true" set:html={banner} />

    <header class="mb-10">
      <span class:list={["series-meta", { "series-meta-soon": comingSoon }]}>{meta}</span>
      <h1 class="text-2xl font-semibold leading-snug mt-3 mb-3 text-foreground">
        {title}
      </h1>
      <p class="text-sm text-muted-foreground leading-relaxed">
        {description}
      </p>
    </header>

    {comingSoon ? (
      <p class="empty-state">{t.blog.series.emptyState}</p>
    ) : (
      <SeriesRoadmap items={roadmap} />
    )}
  </div>
</PageLayout>

<style>
  .banner {
    aspect-ratio: 80 / 15;
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--background));
  }
  .banner :global(svg) {
    display: block;
  }
  .series-meta {
    display: inline-block;
    font-family: var(--font-family-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: hsl(var(--muted-foreground));
  }
  .series-meta-soon {
    color: hsl(var(--primary));
  }

  .empty-state {
    font-size: 14px;
    color: hsl(var(--muted-foreground));
    padding: 2rem 0;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-family-mono);
    font-size: 13px;
    color: hsl(var(--muted-foreground));
    transition: color 150ms ease-in-out;
  }
  .back-link:hover {
    color: hsl(var(--foreground));
  }
  .back-arrow {
    display: inline-block;
    transition: transform 180ms ease;
  }
  .back-link:hover .back-arrow {
    transform: translateX(-4px);
  }
</style>
