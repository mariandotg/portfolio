---
import "@/styles/global.css";
import { BANNER_EFFECTS, ACTIVE_BANNER_EFFECT, VIEW_COLS, VIEW_ROWS } from "@/lib/effects/banner";
import { ACTIVE_BACKDROP_EFFECT } from "@/lib/effects/backdrop";
import { svgWeight } from "@/lib/dev/svg-weight";
import BackdropLab from "@/components/dev/BackdropLab.tsx";

// Dev-only effects bench: compares every registered strategy of both registries
// and calibrates the backdrop live. Never previews a swap — the real swap is
// editing ACTIVE_BANNER_EFFECT / ACTIVE_BACKDROP_EFFECT. Not built in production.
// The guard must sit *after* the imports: an early return above them breaks the
// compiler's generated render function.
if (!import.meta.env.DEV) return new Response(null, { status: 404 });

const DEFAULT_SEED = "agent-vs-cursor";

const banners = Object.entries(BANNER_EFFECTS).map(([name, effect]) => {
  const svg = effect(DEFAULT_SEED);
  return { name, svg, weight: svgWeight(svg).label };
});
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Effects Bench · dev</title>
  </head>
  <body class="bg-background text-foreground font-mono text-[13px]">
    <header class="flex flex-wrap items-start justify-between gap-4 border-b border-border px-6 py-5">
      <div>
        <h1 class="text-[15px] font-semibold">Effects Bench</h1>
        <p class="mt-1.5 text-xs text-muted-foreground">
          Compare every registered banner / backdrop strategy and calibrate the backdrop live.
          Previews only — swapping is still editing <code>ACTIVE_*</code>. Dev only.
        </p>
      </div>
      <button
        type="button"
        data-theme-toggle
        class="rounded-md border border-border px-3 py-1.5 text-xs hover:bg-muted"
      >
        Theme: <b data-theme-label>dark</b>
      </button>
    </header>

    <main class="mx-auto grid max-w-[1200px] gap-10 px-6 py-7">
      <section class="grid gap-4">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <h2
              class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground"
            >
              Banner effects
            </h2>
            <p class="mt-1 text-xs text-muted-foreground">
              Build-time SVG, aspect {VIEW_COLS}/{VIEW_ROWS}. Same seed across every strategy.
            </p>
          </div>
          <label class="grid gap-1">
            <span class="text-[11px] text-muted-foreground">seed</span>
            <input
              type="text"
              data-seed
              value={DEFAULT_SEED}
              class="w-64 rounded-md border border-border bg-transparent px-2 py-1.5 text-xs"
            />
          </label>
        </div>

        <div class="grid gap-5 md:grid-cols-2">
          {
            banners.map((b) => (
              <article class="grid gap-2" data-banner-card data-effect={b.name}>
                <div class="flex items-center gap-2">
                  <span class="text-sm font-medium">{b.name}</span>
                  {b.name === ACTIVE_BANNER_EFFECT && (
                    <span class="rounded border border-primary px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-primary">
                      active
                    </span>
                  )}
                </div>
                <div
                  class="overflow-hidden rounded-lg border border-border [&>svg]:block [&>svg]:h-full [&>svg]:w-full"
                  style={`aspect-ratio: ${VIEW_COLS} / ${VIEW_ROWS}`}
                  data-banner
                  set:html={b.svg}
                />
                <p class="text-[11px] text-muted-foreground" data-weight>
                  {b.weight}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="grid gap-4">
        <div>
          <h2 class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
            Backdrop effects
          </h2>
          <p class="mt-1 text-xs text-muted-foreground">
            Runtime WebGL, rendered without the <code>Backdrop</code> island so the colours stay
            controllable. Background is always transparent — an opaque one flattens the dither.
          </p>
        </div>
        <BackdropLab client:only="react" />
      </section>
    </main>

    <script>
      import { BANNER_EFFECTS } from "@/lib/effects/banner";
      import { svgWeight } from "@/lib/dev/svg-weight";

      const seedInput = document.querySelector<HTMLInputElement>("[data-seed]")!;

      function renderBanners() {
        const seed = seedInput.value || "agent-vs-cursor";
        document.querySelectorAll<HTMLElement>("[data-banner-card]").forEach((card) => {
          const effect = BANNER_EFFECTS[card.dataset.effect as keyof typeof BANNER_EFFECTS];
          if (!effect) return;
          const svg = effect(seed);
          card.querySelector<HTMLElement>("[data-banner]")!.innerHTML = svg;
          card.querySelector<HTMLElement>("[data-weight]")!.textContent = svgWeight(svg).label;
        });
      }

      seedInput.addEventListener("input", renderBanners);

      const themeBtn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]")!;
      const themeLabel = document.querySelector<HTMLElement>("[data-theme-label]")!;
      themeBtn.addEventListener("click", () => {
        const dark = document.documentElement.classList.toggle("dark");
        themeLabel.textContent = dark ? "dark" : "light";
      });
    </script>
  </body>
</html>
