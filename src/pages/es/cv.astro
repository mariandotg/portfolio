---
import PageLayout from "../../layouts/PageLayout.astro";
import CvPage from "../../components/cv/CvPage.astro";
import { RESUME_DATA } from "../../data/resume.datav2";
import { getLangFromUrl } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const DATA = RESUME_DATA[lang];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: DATA.name,
  description: DATA.about,
  url: DATA.personalWebsiteUrl,
  sameAs: [...DATA.contact.social.map((s) => s.url), DATA.personalWebsiteUrl],
};
---

<PageLayout title={DATA.name} description={DATA.about}>
  <CvPage />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</PageLayout>
