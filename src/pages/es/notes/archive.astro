---
import PageLayout from "../../../layouts/PageLayout.astro";
import PostListItem from "../../../components/PostListItem.astro";
import BackLink from "../../../components/BackLink.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath, noteCollectionLabel } from "../../../i18n/utils";
import { getPublishedNotes, noteSlug } from "../../../lib/notes";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const posts = await getPublishedNotes(lang);
const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const notesHref = getLocalizedPath("/notes", lang);
---

<PageLayout title={t.notes.pageTitle} description={t.notes.pageSubtitle}>
  <div class="max-w-[800px] mx-auto px-4 sm:px-6 lg:px-12 py-12">
    <BackLink href={notesHref} label={t.notes.backToNotes} />
    <h1 class="text-xl font-semibold text-foreground mb-1 mt-5">{t.notes.pageTitle}</h1>
    <p class="text-sm text-muted-foreground mb-8">{t.notes.pageSubtitle}</p>

    <div
      class="filter-tabs flex gap-6 mb-8 border-b"
      style="border-color: hsl(var(--border));"
      role="tablist"
      aria-label={t.notes.archiveFilterLabel}
    >
      <button
        type="button"
        class="tab-btn pb-3 text-sm active-tab"
        role="tab"
        id="collection-tab-all"
        data-filter="all"
        aria-selected="true"
        aria-controls="posts-panel"
        tabindex="0"
      >
        {t.notes.collections.all}
      </button>
      <button
        type="button"
        class="tab-btn pb-3 text-sm"
        role="tab"
        id="collection-tab-engineering"
        data-filter="engineering-notes"
        aria-selected="false"
        aria-controls="posts-panel"
        tabindex="-1"
      >
        {t.notes.collections.engineeringNotes}
      </button>
      <button
        type="button"
        class="tab-btn pb-3 text-sm"
        role="tab"
        id="collection-tab-building"
        data-filter="building-in-public"
        aria-selected="false"
        aria-controls="posts-panel"
        tabindex="-1"
      >
        {t.notes.collections.buildingInPublic}
      </button>
    </div>

    <div role="tabpanel" id="posts-panel" aria-labelledby="collection-tab-all">
      <div class="flex flex-col" id="posts-list">
        {sorted.map((post) => (
          <div data-collection={post.data.collection} class="post-card">
            <PostListItem
              slug={noteSlug(post)}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              kicker={noteCollectionLabel(post.data.collection, t)}
            />
          </div>
        ))}
      </div>
      <p id="archive-empty" class="archive-empty hidden" role="status">
        {t.notes.archiveEmpty}
      </p>
    </div>
  </div>
</PageLayout>

<style>
  .tab-btn {
    color: hsl(var(--muted-foreground));
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font-family-display);
    position: relative;
    padding-bottom: 0.75rem;
  }

  .tab-btn.active-tab {
    color: hsl(var(--foreground));
    font-weight: 600;
  }

  .tab-btn.active-tab::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: hsl(var(--primary));
    border-radius: var(--radius-sm);
  }

  .tab-btn:hover:not(.active-tab) {
    color: hsl(var(--foreground));
    transition: color 150ms ease-in-out;
  }

  .post-card.hidden {
    display: none;
  }

  .archive-empty {
    font-size: var(--text-ui);
    line-height: var(--text-ui--line-height);
    color: hsl(var(--muted-foreground));
    padding: 24px 4px;
    margin: 0;
  }

  .archive-empty.hidden {
    display: none;
  }
</style>

<script>
  function initCollectionTabs() {
    const tablist = document.querySelector('[role="tablist"]');
    if (!tablist) return;

    const buttons = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const cards = document.querySelectorAll<HTMLElement>('.post-card');
    const emptyEl = document.getElementById('archive-empty');
    const panel = document.getElementById('posts-panel');

    function applyFilter(filter: string, activeBtn: HTMLButtonElement) {
      buttons.forEach((b) => {
        const selected = b === activeBtn;
        b.classList.toggle('active-tab', selected);
        b.setAttribute('aria-selected', selected ? 'true' : 'false');
        b.tabIndex = selected ? 0 : -1;
      });

      panel?.setAttribute('aria-labelledby', activeBtn.id);

      let visible = 0;
      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.collection === filter;
        card.classList.toggle('hidden', !show);
        if (show) visible += 1;
      });

      emptyEl?.classList.toggle('hidden', visible > 0);
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        applyFilter(btn.dataset.filter ?? 'all', btn);
      });

      btn.addEventListener('keydown', (e) => {
        const idx = buttons.indexOf(btn);
        let next = idx;

        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          next = (idx + 1) % buttons.length;
          e.preventDefault();
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          next = (idx - 1 + buttons.length) % buttons.length;
          e.preventDefault();
        } else if (e.key === 'Home') {
          next = 0;
          e.preventDefault();
        } else if (e.key === 'End') {
          next = buttons.length - 1;
          e.preventDefault();
        } else {
          return;
        }

        const target = buttons[next];
        target.focus();
        applyFilter(target.dataset.filter ?? 'all', target);
      });
    });
  }

  document.addEventListener('astro:page-load', initCollectionTabs);
</script>
