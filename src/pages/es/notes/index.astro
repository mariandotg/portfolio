---
import PageLayout from "../../../layouts/PageLayout.astro";
import PostListItem from "../../../components/PostListItem.astro";
import SeriesCard from "../../../components/SeriesCard.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations, getLocalizedPath, noteCollectionLabel } from "../../../i18n/utils";
import { getSeriesIndex } from "../../../lib/series";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const series = await getSeriesIndex(lang, t);

const posts = await getCollection("notes", ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const LATEST_COUNT = 3;
const latestPosts = sortedPosts.slice(0, LATEST_COUNT);
const archiveHref = getLocalizedPath("/notes/archive", lang);
---

<PageLayout title={t.notes.pageTitle} description={t.notes.pageSubtitle}>
  <div class="max-w-[800px] mx-auto px-4 sm:px-6 lg:px-12 py-12">
    <h1 class="text-xl font-semibold text-foreground mb-1">{t.notes.pageTitle}</h1>
    <p class="text-sm text-muted-foreground mb-10">{t.notes.pageSubtitle}</p>

    {series.length > 0 && (
      <section class="mb-14">
        <div class="mb-4">
          <h2 class="text-lg font-bold text-foreground">{t.notes.series.sectionTitle}</h2>
          <p class="text-sm text-muted-foreground">{t.notes.series.sectionDescription}</p>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          {series.map((s) => (
            <SeriesCard
              slug={s.slug}
              path={s.path}
              title={s.title}
              description={s.description}
              meta={s.meta}
              comingSoon={s.comingSoon}
              featured={s.featured}
              bannerBase={s.bannerBase}
            />
          ))}
        </div>
      </section>
    )}

    <section>
      <div class="flex items-baseline justify-between gap-4 mb-4">
        <h2 class="text-lg font-bold text-foreground">{t.nav.notes}</h2>
        {sortedPosts.length > LATEST_COUNT && (
          <a
            href={archiveHref}
            class="text-sm font-mono text-muted-foreground hover:text-foreground transition-colors shrink-0"
          >
            {t.notes.viewArchive}
          </a>
        )}
      </div>
      <div class="flex flex-col">
        {latestPosts.map((post) => (
          <PostListItem
            slug={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            kicker={noteCollectionLabel(post.data.collection, t)}
          />
        ))}
      </div>
    </section>
  </div>
</PageLayout>
