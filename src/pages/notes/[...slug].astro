---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import NotePost from "../../layouts/NotePost.astro";
import { getLangFromUrl, localizedSeries } from "../../i18n/utils";
import { getSeriesPosts } from "../../lib/series";

export async function getStaticPaths() {
  const entries = await getCollection("notes", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"notes"> };
const { Content, headings, remarkPluginFrontmatter } = await render(entry);
const { title, description, pubDate, updatedDate, tags, image, imageAlt } = entry.data;
const readingTime = remarkPluginFrontmatter?.readingTime;

const lang = getLangFromUrl(Astro.url);

let seriesContext = undefined;
if (entry.data.series) {
  const seriesEntries = await getCollection("series", ({ id }) => id === entry.data.series);
  const seriesEntry = seriesEntries[0];
  if (seriesEntry) {
    const siblings = await getSeriesPosts(entry.data.series);
    const idx = siblings.findIndex((p) => p.id === entry.id);
    const toRef = (p: CollectionEntry<"notes">) => ({ slug: p.id, title: p.data.title });
    seriesContext = {
      slug: seriesEntry.id,
      rootLevel: seriesEntry.data.rootLevel,
      title: localizedSeries(seriesEntry.data, lang).title,
      part: idx + 1,
      total: siblings.length,
      prev: idx > 0 ? toRef(siblings[idx - 1]) : undefined,
      next: idx < siblings.length - 1 ? toRef(siblings[idx + 1]) : undefined,
    };
  }
}
---

<NotePost
  title={title}
  description={description}
  pubDate={pubDate}
  updatedDate={updatedDate}
  tags={tags}
  image={image}
  imageAlt={imageAlt}
  readingTime={readingTime}
  headings={headings}
  seriesContext={seriesContext}
>
  <Content />
</NotePost>
