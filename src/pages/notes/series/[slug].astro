---
import type { CollectionEntry } from "astro:content";
import PageLayout from "../../../layouts/PageLayout.astro";
import SeriesLanding from "../../../components/SeriesLanding.astro";
import { getLangFromUrl, useTranslations, getLocalizedPath, localizedSeries } from "../../../i18n/utils";
import {
  getSeriesPosts,
  getSeriesRoadmap,
  getStandardSeries,
  seriesLandingMeta,
  totalReadingMinutes,
  assertSeriesIntegrity,
} from "../../../lib/series";
import { seriesBannerBase } from "@/lib/effects/banner/assets";

export async function getStaticPaths() {
  await assertSeriesIntegrity();
  const entries = await getStandardSeries();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<"series"> };
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, description } = localizedSeries(entry.data, lang);
const posts = await getSeriesPosts(entry.id);
const comingSoon = posts.length === 0;
const roadmap = await getSeriesRoadmap(entry.id, lang);
const meta = seriesLandingMeta(posts.length, entry.data.status, totalReadingMinutes(roadmap), t);
const notesHref = getLocalizedPath("/notes", lang);
---

<PageLayout title={title} description={description}>
  <SeriesLanding
    title={title}
    description={description}
    bannerBase={seriesBannerBase(entry.id, entry.data.bannerImage)}
    meta={meta}
    comingSoon={comingSoon}
    roadmap={roadmap}
    notesHref={notesHref}
    backLabel={t.notes.backToNotes}
    emptyState={t.notes.series.emptyState}
  />
</PageLayout>
