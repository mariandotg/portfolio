---
import PageLayout from "../layouts/PageLayout.astro";
import CvPage from "../components/cv/CvPage.astro";
import { PUBLIC_RESUME_DATA } from "../data/resume";
import { getLangFromUrl } from "../i18n/utils";

// `/resume` is the canonical EN URL for the CV (see `/cv`, which canonicalizes
// here). `/es/cv` is the canonical ES URL — the two are cross-linked via
// hreflang below since their paths don't mirror by `/es` prefixing.
const lang = getLangFromUrl(Astro.url);
const DATA = PUBLIC_RESUME_DATA[lang];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: DATA.name,
  description: DATA.about,
  url: DATA.personalWebsiteUrl,
  sameAs: [...DATA.contact.social.map((s) => s.url), DATA.personalWebsiteUrl],
};
---

<PageLayout title={DATA.name} description={DATA.about} revealTitleOnScroll hreflangEsPath="/es/cv/">
  <CvPage />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</PageLayout>
